/*
    Wyckoff VSA One-Click Re-entrant Context Daily Probe v0.1

    Native gate before multi-context execution.
    Requires generated files from:
      BUILD_WVOC_REENTRANT_CONTEXT_STACK_v0.1.ps1

    Purpose:
    - prove generated analytical body compiles on AmiBroker 6.20.01;
    - execute exactly one Daily context;
    - expose locked Composite/PublicActive fields for equivalence comparison;
    - measure formula-local context-body time.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

#include_once <WyckoffVSA_RuntimeConfig_v0.2.afl>
#include_once <WyckoffVSA_OneClickContextHelpers_Generated_v0.1.afl>

GetPerformanceCounter(1);

#include <WyckoffVSA_OneClickContextBody_Generated_v0.1.afl>

WVOC_CTX_ElapsedMs = GetPerformanceCounter();
WVOC_CTX_LastBar = BarIndex()==LastValue(BarIndex());

Filter = WVOC_CTX_LastBar;

AddTextColumn(Name(),"Symbol");
AddColumn(DateTime(),"As-Of",formatDateTime);
AddColumn(0*BarIndex()+WVRC_ConfigValid,"Config Valid",1.0);
AddColumn(0*BarIndex()+WVOC_CTX_ElapsedMs,"Context Body ms",1.3);

AddColumn(WCI_ContextMultiplicityCode,"Composite Multiplicity",1.0);
AddColumn(WCI_ContextAmbiguous,"Composite Ambiguous",1.0);
AddColumn(WCI_L_ContextPresent,"L Present",1.0);
AddColumn(WCI_U_ContextPresent,"U Present",1.0);
AddColumn(WCI_L_PublicActive,"L PublicActive",1.0);
AddColumn(WCI_U_PublicActive,"U PublicActive",1.0);

AddColumn(WCI_CurrentRangeContextID,"Current Range ID",1.0);
AddColumn(WCI_RangeStatusCode,"Range Status",1.0);
AddColumn(WCI_RangePosition,"Range Position",1.4);

AddColumn(WCI_PhaseStateCode,"Phase",1.0);
AddColumn(WCI_StructuralDevelopmentCode,"Structural Development",1.0);
AddColumn(WCI_FamilyHypothesisCode,"Family",1.0);
AddColumn(WCI_DirectionalContextCode,"Directional",1.0);
AddColumn(WCI_EvidenceBalanceCode,"Evidence",1.0);
AddColumn(WCI_HypothesisAlignmentCode,"Hyp Alignment",1.0);
AddColumn(WCI_CurrentEventMask,"Event Mask",1.0);

AddColumn(WCI_L_RangeContextID,"L Range ID",1.0);
AddColumn(WCI_L_RangeStatusCode,"L Range Status",1.0);
AddColumn(WCI_L_PhaseStateCode,"L Phase",1.0);
AddColumn(WCI_L_FamilyHypothesisCode,"L Family",1.0);

AddColumn(WCI_U_RangeContextID,"U Range ID",1.0);
AddColumn(WCI_U_RangeStatusCode,"U Range Status",1.0);
AddColumn(WCI_U_PhaseStateCode,"U Phase",1.0);
AddColumn(WCI_U_FamilyHypothesisCode,"U Family",1.0);

AddTextColumn("ONE_CLICK_CONTEXT_DAILY_PROBE_V01_20260918_A","Probe Version");
