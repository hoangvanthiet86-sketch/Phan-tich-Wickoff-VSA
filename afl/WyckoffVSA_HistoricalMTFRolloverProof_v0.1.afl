/*
    Wyckoff VSA Historical Scanner v0.1
    H2A Historical MTF calendar rollover proof harness.

    Purpose:
    - prove point-in-time Weekly/Monthly availability boundaries on Daily bars;
    - use the same Monday week epoch / ordinal convention as Operational Clock;
    - NEVER read current Weekly/Monthly StaticVars;
    - NEVER reconstruct MTF payload yet;
    - no trading semantics.

    User-facing text is Vietnamese ASCII per HS14.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

_SECTION_BEGIN("01. CHE DO HIEN THI");
HMR_OnlyBoundary = ParamToggle(
    "1.1 Dong hien thi",
    "Tat ca cac ngay|Chi ngay doi tuan / doi thang",1);
_SECTION_END();

_SECTION_BEGIN("02. TINH MOC THOI GIAN NHAN QUA");
HMR_DT = DateTime();
HMR_DN = DateNum();
HMR_BI = BarIndex();
HMR_IntervalValid = Interval()==inDaily;

// Cung epoch voi WyckoffVSA_OperationalClock_v0.1.afl.
HMR_WeekEpoch = _DT("2000-01-03 00:00:00");
HMR_CurrentWeeklyOrdinal = Floor(DateTimeDiff(HMR_DT,HMR_WeekEpoch)/604800);
HMR_ExpectedCompletedWeeklyOrdinal = HMR_CurrentWeeklyOrdinal - 1;

// DateNum = 10000*(year-1900) + 100*month + day.
HMR_YearOffset = Floor(HMR_DN/10000);
HMR_Year = 1900 + HMR_YearOffset;
HMR_DateRemainder = HMR_DN - 10000*HMR_YearOffset;
HMR_Month = Floor(HMR_DateRemainder/100);
HMR_Day = HMR_DateRemainder - 100*HMR_Month;
HMR_CurrentMonthlyOrdinal = HMR_Year*12 + HMR_Month;
HMR_ExpectedCompletedMonthlyOrdinal = HMR_CurrentMonthlyOrdinal - 1;

HMR_HasPriorBar = HMR_BI>0;
HMR_WeeklyRollover = HMR_HasPriorBar AND
    HMR_CurrentWeeklyOrdinal != Ref(HMR_CurrentWeeklyOrdinal,-1);
HMR_MonthlyRollover = HMR_HasPriorBar AND
    HMR_CurrentMonthlyOrdinal != Ref(HMR_CurrentMonthlyOrdinal,-1);
HMR_AnyRollover = HMR_WeeklyRollover OR HMR_MonthlyRollover;

HMR_WeeklyExpectedChanged = HMR_HasPriorBar AND
    HMR_ExpectedCompletedWeeklyOrdinal != Ref(HMR_ExpectedCompletedWeeklyOrdinal,-1);
HMR_MonthlyExpectedChanged = HMR_HasPriorBar AND
    HMR_ExpectedCompletedMonthlyOrdinal != Ref(HMR_ExpectedCompletedMonthlyOrdinal,-1);

// H2A invariant: expected-completed ordinal only changes when current calendar
// period rolls over. This does not yet prove payload reconstruction.
HMR_WeeklyBoundaryOK = IIf(
    NOT HMR_HasPriorBar,1,
    HMR_WeeklyRollover == HMR_WeeklyExpectedChanged);
HMR_MonthlyBoundaryOK = IIf(
    NOT HMR_HasPriorBar,1,
    HMR_MonthlyRollover == HMR_MonthlyExpectedChanged);
HMR_ProofOK = HMR_IntervalValid AND HMR_WeeklyBoundaryOK AND HMR_MonthlyBoundaryOK;

HMR_StatusCode = IIf(NOT HMR_IntervalValid,0,IIf(HMR_ProofOK,1,2));
HMR_StatusText = "Khong dung khung Ngay\nDat kiem tra moc doi\nLoi doi chieu moc doi";
HMR_YesNoText = "Khong\nCo";
HMR_Version = "HISTORICAL_MTF_ROLLOVER_PROOF_V01_20260914_A";
_SECTION_END();

_SECTION_BEGIN("03. KET QUA KIEM TRA");
Filter = HMR_IntervalValid AND IIf(HMR_OnlyBoundary,HMR_AnyRollover,1);

AddColumn(HMR_DT,"Ngay du lieu",formatDateTime);
AddColumn(HMR_CurrentWeeklyOrdinal,"Ma tuan hien tai",1.0);
AddColumn(HMR_ExpectedCompletedWeeklyOrdinal,"Tuan da hoan tat gan nhat",1.0);
AddMultiTextColumn(HMR_WeeklyRollover,HMR_YesNoText,"Doi tuan tai ngay nay");
AddColumn(HMR_CurrentMonthlyOrdinal,"Ma thang hien tai",1.0);
AddColumn(HMR_ExpectedCompletedMonthlyOrdinal,"Thang da hoan tat gan nhat",1.0);
AddMultiTextColumn(HMR_MonthlyRollover,HMR_YesNoText,"Doi thang tai ngay nay");
AddMultiTextColumn(HMR_WeeklyBoundaryOK,HMR_YesNoText,"Moc tuan hop le");
AddMultiTextColumn(HMR_MonthlyBoundaryOK,HMR_YesNoText,"Moc thang hop le");
AddMultiTextColumn(HMR_StatusCode,HMR_StatusText,"Trang thai kiem tra");
AddTextColumn(HMR_Version,"Phien ban");
_SECTION_END();
