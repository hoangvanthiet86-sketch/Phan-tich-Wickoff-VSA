/*
    Wyckoff VSA Performance Runtime v0.2
    Direct-compute compatibility harness — PRE-NATIVE-TEST.

    Purpose:
    - load the approved v0.2 RuntimeConfig first;
    - execute the exact v0.1 analytical stack through Market Scanner;
    - intentionally defer P&F in the fast path;
    - verify that v0.2 requested configuration is equivalent to the actual
      legacy module configuration before comparing analytical outputs;
    - expose a compact scanner surface for native DTP/FRT/SNZ equivalence tests.

    IMPORTANT:
    - this is NOT yet the persistent Snapshot/Fast Scanner implementation;
    - legacy module Params still exist and may appear in Parameters when the
      compatibility bridge is not active;
    - no analytical algorithm is changed here;
    - configuration mismatch is diagnostic and cannot be accepted as PASS;
    - this harness intentionally emits every bar in the Analysis range.
      Native compatibility tests must therefore use Apply to Current +
      Range = 1 recent bar(s). This removes all Filter ambiguity while
      validating the runtime/configuration contract.
    - no NATIVE PASS is claimed by this source file.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

#include_once <WyckoffVSA_RuntimeConfig_v0.2.afl>

// Defensive runtime-entry assertion. RuntimeConfig v0.2 is the canonical owner
// of this flag, but the harness asserts it again before any bridged v0.1 module
// is included. This prevents a stale local RuntimeConfig copy from silently
// falling back to duplicate legacy Params during compatibility testing.
WVRC_UseCentralConfig = 1;

#include_once <WyckoffVSA_Core_v1.0.afl>
#include_once <WyckoffVSA_Candidate_v1.0.afl>
#include_once <WyckoffVSA_StructureLocation_v1.0.afl>
#include_once <WyckoffVSA_Confirmation_v1.0.afl>

#include_once <WyckoffVSA_Event_StoppingClimacticAbsorption_v0.1.afl>
#include_once <WyckoffVSA_Event_SupplyTest_v1.0.afl>
#include_once <WyckoffVSA_Event_SpringShakeout_v0.1.afl>
#include_once <WyckoffVSA_Event_UpthrustUTAD_v0.1.afl>
#include_once <WyckoffVSA_Event_SOSLPS_v0.1.afl>

#include_once <WyckoffVSA_StructuralSequence_PhaseA_v0.1.afl>
#include_once <WyckoffVSA_StructuralSequence_PhaseA_Snapshot_v0.1.afl>
#include_once <WyckoffVSA_RangeContext_SOWLPSY_v0.1.afl>

#include_once <WyckoffVSA_PhaseContext_InputFacade_v0.1.afl>
#include_once <WyckoffVSA_PhaseContext_v0.1.afl>
#include_once <WyckoffVSA_PhaseContext_PublicSnapshot_v0.1.afl>
#include_once <WyckoffVSA_PhaseContext_ConsumerFacade_v0.1.afl>

#include_once <WyckoffVSA_CompositeIndicator_v0.1.afl>
#include_once <WyckoffVSA_CompositeIndicator_SnapshotPublic_v0.1.afl>

#include_once <WyckoffVSA_TimeframeSnapshot_Consumer_v0.1.afl>
#include_once <WyckoffVSA_MultiTimeframeContext_v0.1.afl>

#include_once <WyckoffVSA_DerivedSeriesPivotKernel_v0.1.afl>
#include_once <WyckoffVSA_RelativeStrengthContext_v0.1.afl>

#include_once <WyckoffVSA_CrossSymbolSelectionContext_Consumer_v0.1.afl>
#include_once <WyckoffVSA_CrossSymbolSelectionContext_ConsumerVersionGuard_v0.1.afl>
#include_once <WyckoffVSA_MarketScanner_v0.1.afl>

// P&F is deliberately NOT included in this fast-path compatibility harness.
// Market Scanner candidate classes are upstream of P&F in v0.1.

_SECTION_BEGIN("91. v0.2 Compatibility Guard");
WVRCB_CoreMatch =
    VolumeLookback == WVRC_VolumeLookback AND
    SpreadLookback == WVRC_SpreadLookback AND
    ATRPeriod == WVRC_ATRPeriod AND
    HighEffortThreshold == WVRC_HighEffortRVOL AND
    LowEffortThreshold == WVRC_LowEffortRVOL AND
    LowDirectionalResultThreshold == WVRC_LowDirectionalResultATR AND
    HighDirectionalResultThreshold == WVRC_HighDirectionalResultATR;

WVRCB_StructureMatch =
    SL_S_Lookback == WVRC_ShortLookback AND
    SL_M_Lookback == WVRC_MediumLookback AND
    SL_L_Lookback == WVRC_LongLookback AND
    SL_PivotLeft == WVRC_PivotLeft AND
    SL_PivotRight == WVRC_PivotRight;

WVRCB_ProvisionalMatch =
    WCI_RuntimeLastBarIsProvisional == WVRC_LastBarProvisional AND
    WRS_RuntimeLastBarIsProvisional == WVRC_LastBarProvisional;

// Free-text declaration is presentation/provenance only in RS v0.1.
// Analytical validity is controlled by the numeric Adjustment Basis Status.
WVRCB_RSDeclarationTextMatch =
    WRS_AdjustmentBasisDeclaration == WVRC_RSAdjustmentBasisDeclaration;

WVRCB_RSMatch =
    WRS_MarketBenchmarkSymbol == WVRC_RSMarketSymbol AND
    WRS_GroupBenchmarkSymbol == WVRC_RSGroupSymbol AND
    WRS_AdjustmentBasisStatusScalar == WVRC_RSAdjustmentBasisStatus;

WVRCB_SelectionMatch =
    WXS_RequestedMarketSymbol == WVRC_SelectionMarketSymbol AND
    WXS_RequestedGroupSymbol == WVRC_SelectionGroupSymbol;

WVRCB_ScannerMatch = WSCN_RequireFullTopDown == WVRC_RequireFullTopDown;

WVRCB_ConfigMismatchMask =
      IIf(WVRCB_CoreMatch,0,1)
    + IIf(WVRCB_StructureMatch,0,2)
    + IIf(WVRCB_ProvisionalMatch,0,4)
    + IIf(WVRCB_RSMatch,0,8)
    + IIf(WVRCB_SelectionMatch,0,16)
    + IIf(WVRCB_ScannerMatch,0,32);

WVRCB_ConfigEquivalent = WVRC_ConfigValid AND WVRCB_ConfigMismatchMask == 0;
WVRCB_ConfigStatusCode = IIf(NOT WVRC_ConfigValid,0,IIf(WVRCB_ConfigEquivalent,2,1));
WVRCB_ConfigStatusText = "V0.2 CONFIG INVALID\nLEGACY / V0.2 CONFIG MISMATCH\nCONFIG EQUIVALENT";

// Bridge activation diagnostics. These variables are published only by files
// that have the Single Configuration Authority compatibility bridge installed.
WVRCB_CentralConfigFlag = Nz(VarGet("WVRC_UseCentralConfig"),0);
WVRCB_CoreBridgeActive = Nz(VarGet("WVRC_CoreUseCentralConfig"),0);
WVRCB_StructureBridgeActive = Nz(VarGet("WVRC_SLUseCentralConfig"),0);
WVRCB_CompositeBridgeActive = Nz(VarGet("WVRC_CompositeUseCentralConfig"),0);
WVRCB_RSBridgeActive = Nz(VarGet("WVRC_RSUseCentralConfig"),0);
WVRCB_SelectionBridgeActive = Nz(VarGet("WVRC_SelectionUseCentralConfig"),0);
WVRCB_ScannerBridgeActive = Nz(VarGet("WVRC_ScannerUseCentralConfig"),0);
_SECTION_END();

_SECTION_BEGIN("92. v0.2 Direct-Compute Scanner Surface");

WVRCB_IsVisibleLastBar = BarIndex() == LastValue(BarIndex());
WVRCB_FilterQualified = WSCN_QualifiedCandidateFlag==1;
WVRCB_FilterDeveloping = WSCN_DevelopingCandidateFlag==1 OR WSCN_QualifiedCandidateFlag==1;
WVRCB_FilterWatch = WSCN_WatchFlag==1 OR WSCN_DevelopingCandidateFlag==1 OR WSCN_QualifiedCandidateFlag==1;
WVRCB_FilterReview = WSCN_ReviewFlag==1 OR WSCN_DataEligibilityCode==0;
WVRCB_FilterAllEligible = WSCN_DataEligibilityCode==1;

WVRCB_FilterSelected = IIf(
    WVRC_ProductionFilterCode==0,WVRCB_FilterQualified,
    IIf(WVRC_ProductionFilterCode==1,WVRCB_FilterDeveloping,
    IIf(WVRC_ProductionFilterCode==2,WVRCB_FilterWatch,
    IIf(WVRC_ProductionFilterCode==3,WVRCB_FilterReview,
    IIf(WVRC_ProductionFilterCode==4,WVRCB_FilterAllEligible,0)))));

// Diagnostic harness only: emit every bar selected by Analysis.
// With Apply to Current + Range = 1 recent bar(s), this guarantees one row.
// Requested Production Filter and last-bar state remain visible as diagnostics
// but are deliberately NOT allowed to hide the row during compatibility tests.
Filter = 1;

WVRCB_CandidateClassText = "DATA GATED / INSUFFICIENT\nNOT A CURRENT CANDIDATE\nWATCH\nDEVELOPING BULLISH\nQUALIFIED BULLISH - MARKET ALIGNED\nQUALIFIED BULLISH - FULL TOP-DOWN\nDEVELOPING BEARISH\nQUALIFIED BEARISH - MARKET ALIGNED\nQUALIFIED BEARISH - FULL TOP-DOWN\nREVIEW - CONFLICT / AMBIGUITY";
WVRCB_CandidateSideText = "NONE / UNRESOLVED\nBULLISH\nBEARISH";
WVRCB_CandidateStageText = "NONE / INSUFFICIENT\nWATCH - RANGE FORMATION / DEVELOPMENT\nDEVELOPING - FINAL TEST\nDIRECTIONAL DEVELOPMENT\nTREND EXPANSION\nTERMINAL / SUPERSEDED";
WVRCB_PhaseText = "INSUFFICIENT CONTEXT\nPHASE-A-LIKE\nPHASE-B-LIKE\nPHASE-C-CANDIDATE\nPHASE-C-LIKE\nPHASE-D-LIKE\nPHASE-E-LIKE\nRANGE INVALIDATED / SUPERSEDED";
WVRCB_FamilyText = "INSUFFICIENT\nUNRESOLVED LOWER RANGE\nUNRESOLVED UPPER RANGE\nACCUMULATION-HYPOTHESIS\nREDISTRIBUTION-HYPOTHESIS\nDISTRIBUTION-HYPOTHESIS\nREACCUMULATION-HYPOTHESIS\nMIXED / CONFLICTING EVIDENCE";
WVRCB_MTFText = "INSUFFICIENT MTF DATA\nUNRESOLVED / NON-DIRECTIONAL\nBULLISH ALIGNMENT\nBEARISH ALIGNMENT\nBASE COUNTER TO HIGHER CONTEXT\nHIGHER TIMEFRAMES CONFLICT\nMIXED / COMPLEX MTF CONTEXT";
WVRCB_RSText = "INSUFFICIENT\nRS IMPROVING / BULLISH STRUCTURE\nRS DETERIORATING / BEARISH STRUCTURE\nRS MIXED / NON-DIRECTIONAL";

AddTextColumn(Name(),"Symbol");
AddColumn(DateTime(),"As-Of Date",formatDateTime);
AddMultiTextColumn(WVRCB_ConfigStatusCode,WVRCB_ConfigStatusText,"Runtime Config Status");
AddColumn(WVRCB_IsVisibleLastBar,"Visible Last Bar",1.0);
AddColumn(WVRCB_FilterSelected,"Requested Filter Match",1.0);
AddColumn(WSCN_DataEligibilityCode,"Data Eligible",1.0);
AddMultiTextColumn(WSCN_CandidateClassCode,WVRCB_CandidateClassText,"Candidate Class");
AddMultiTextColumn(WSCN_CandidateSideCode,WVRCB_CandidateSideText,"Candidate Side");
AddMultiTextColumn(WSCN_CandidateStageCode,WVRCB_CandidateStageText,"Candidate Stage");
AddMultiTextColumn(WSCN_StockPhaseStateCode,WVRCB_PhaseText,"Phase");
AddMultiTextColumn(WSCN_StockFamilyHypothesisCode,WVRCB_FamilyText,"Family");
AddColumn(WSCN_StockRangePosition,"Range Position",1.4);
AddMultiTextColumn(WSCN_StockMTFDirectionalAlignmentCode,WVRCB_MTFText,"MTF Alignment");
AddMultiTextColumn(WSCN_StockVsMarketRSStructureCode,WVRCB_RSText,"RS vs Market");
AddColumn(WSCN_ReviewFlag,"Scanner Review",1.0);
AddColumn(WSCN_MethodBlockReasonMask,"Method Block Mask",1.0);

if(WVRC_ShowDecisionDiagnostics OR WVRC_OutputDetailEffective>=1)
{
    AddColumn(WSCN_ExclusionReasonMask,"Exclusion Mask",1.0);
    AddColumn(WVRCB_ConfigMismatchMask,"Config Mismatch Mask",1.0);
    AddColumn(WVRCB_CentralConfigFlag,"Central Config Flag",1.0);
    AddColumn(WVRCB_CoreBridgeActive,"Bridge Core Active",1.0);
    AddColumn(WVRCB_StructureBridgeActive,"Bridge Structure Active",1.0);
    AddColumn(WVRCB_CompositeBridgeActive,"Bridge Composite Active",1.0);
    AddColumn(WVRCB_RSBridgeActive,"Bridge RS Active",1.0);
    AddColumn(WVRCB_SelectionBridgeActive,"Bridge Selection Active",1.0);
    AddColumn(WVRCB_ScannerBridgeActive,"Bridge Scanner Active",1.0);
    AddColumn(WVRCB_CoreMatch,"Config Match Core",1.0);
    AddColumn(WVRCB_StructureMatch,"Config Match Structure",1.0);
    AddColumn(WVRCB_ProvisionalMatch,"Config Match Provisional",1.0);
    AddColumn(WVRCB_RSMatch,"Config Match RS Analytical",1.0);
    AddColumn(WVRCB_RSDeclarationTextMatch,"RS Declaration Text Match - Diagnostic Only",1.0);
    AddColumn(WVRCB_SelectionMatch,"Config Match Selection",1.0);
    AddColumn(WVRCB_ScannerMatch,"Config Match Scanner",1.0);
    AddColumn(WSCN_QualifiedCandidateFlag,"Qualified",1.0);
    AddColumn(WSCN_DevelopingCandidateFlag,"Developing",1.0);
    AddColumn(WSCN_WatchFlag,"Watch",1.0);
    AddColumn(WSCN_CandidateClassCode,"Candidate Class Code",1.0);
    AddColumn(WSCN_CandidateSideCode,"Candidate Side Code",1.0);
    AddColumn(WSCN_CandidateStageCode,"Candidate Stage Code",1.0);
}
_SECTION_END();
