AddColumn(WE_SL_LPSEvaluationSupportHeld,"WE_SL_LPSEvaluationSupportHeld",1.0);
AddColumn(WE_SL_LPSEvaluationNoLowerLow,"WE_SL_LPSEvaluationNoLowerLow",1.0);
AddColumn(WE_SL_LPSEvaluationCloseImproved,"WE_SL_LPSEvaluationCloseImproved",1.0);
AddColumn(WE_SL_LPSCEContextValid,"WE_SL_LPSCEContextValid",1.0);
AddColumn(WE_SL_LPSCECoordinateMatchesOrigin,"WE_SL_LPSCECoordinateMatchesOrigin",1.0);
AddColumn(WE_SL_LPSNoSupplyConfirmedAtEvaluation,"WE_SL_LPSNoSupplyConfirmedAtEvaluation",1.0);
_SECTION_END();
