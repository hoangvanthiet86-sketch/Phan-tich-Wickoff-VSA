AddColumn(WE_SL_SOSLow,"WE_SL_SOSLow",1.12);
AddColumn(WE_SL_SOSClose,"WE_SL_SOSClose",1.12);
AddColumn(WE_SL_SOSPreviousClose,"WE_SL_SOSPreviousClose",1.12);
AddColumn(WE_SL_SOSRSpread,"WE_SL_SOSRSpread",1.12);
AddColumn(WE_SL_SOSRVOL,"WE_SL_SOSRVOL",1.12);
AddColumn(WE_SL_SOSClosePosition,"WE_SL_SOSClosePosition",1.12);
AddColumn(WE_SL_SOS_StrongCloseFlag,"WE_SL_SOS_StrongCloseFlag",1.0);
AddColumn(WE_SL_SOSPriorATR,"WE_SL_SOSPriorATR",1.12);
AddColumn(WE_SL_SOSPriorATRValid,"WE_SL_SOSPriorATRValid",1.0);
AddColumn(WE_SL_SOSPenetration,"WE_SL_SOSPenetration",1.12);
AddColumn(WE_SL_SOSPenetrationATR,"WE_SL_SOSPenetrationATR",1.12);
AddColumn(WE_SL_SOSPenetrationATRValueValid,"WE_SL_SOSPenetrationATRValueValid",1.0);
AddColumn(WE_SL_SOSPivotExtremeBarIndex,"WE_SL_SOSPivotExtremeBarIndex",1.0);
AddColumn(WE_SL_SOSPivotExtremeDateTime,"WE_SL_SOSPivotExtremeDateTime",formatDateTime);
AddColumn(WE_SL_SOSPivotConfirmBarIndex,"WE_SL_SOSPivotConfirmBarIndex",1.0);
AddColumn(WE_SL_SOSPivotConfirmDateTime,"WE_SL_SOSPivotConfirmDateTime",formatDateTime);
AddColumn(WE_SL_SOSResistanceAge,"WE_SL_SOSResistanceAge",1.0);
AddColumn(WE_SL_SOSResistanceBarsSinceConfirmation,"WE_SL_SOSResistanceBarsSinceConfirmation",1.0);

AddColumn(WE_SL_PriorSOSAnchorActive,"WE_SL_PriorSOSAnchorActive",1.0);
AddColumn(WE_SL_BarsSinceSOS,"WE_SL_BarsSinceSOS",1.0);
AddColumn(WE_SL_PriorSOSBarIndex,"WE_SL_PriorSOSBarIndex",1.0);
AddColumn(WE_SL_PriorSOSBreakoutLevel,"WE_SL_PriorSOSBreakoutLevel",1.12);
AddColumn(WE_SL_AnchorInvalidatedByCloseCurrent,"WE_SL_AnchorInvalidatedByCloseCurrent",1.0);

AddColumn(WE_SL_LPSOriginCode,"WE_SL_LPSOriginCode",1.0);
AddColumn(WE_SL_LPSOriginValid,"WE_SL_LPSOriginValid",1.0);
AddColumn(WE_SL_LPSOriginReasonCode,"WE_SL_LPSOriginReasonCode",1.0);
AddMultiTextColumn(WE_SL_LPSOriginCode,WE_SL_LPSOriginStatusText,"WE_SL_LPSOriginStatus");
AddColumn(WE_SL_LPSReactionProgress,"WE_SL_LPSReactionProgress",1.0);
AddColumn(WE_SL_LPSOriginBarIndex,"WE_SL_LPSOriginBarIndex",1.0);
AddColumn(WE_SL_LPSOriginDateTime,"WE_SL_LPSOriginDateTime",formatDateTime);
AddColumn(WE_SL_LPSOriginLow,"WE_SL_LPSOriginLow",1.12);
AddColumn(WE_SL_LPSOriginClose,"WE_SL_LPSOriginClose",1.12);
AddColumn(WE_SL_LPSBreakoutLevel,"WE_SL_LPSBreakoutLevel",1.12);
AddColumn(WE_SL_LPSAnchorSOSBarIndex,"WE_SL_LPSAnchorSOSBarIndex",1.0);
AddColumn(WE_SL_LPSAnchorSOSDateTime,"WE_SL_LPSAnchorSOSDateTime",formatDateTime);
AddColumn(WE_SL_LPSBarsSinceSOS,"WE_SL_LPSBarsSinceSOS",1.0);
AddColumn(WE_SL_LPSDistanceAboveBreakout,"WE_SL_LPSDistanceAboveBreakout",1.12);
AddColumn(WE_SL_LPSDistanceAboveBreakoutATR,"WE_SL_LPSDistanceAboveBreakoutATR",1.12);
AddColumn(WE_SL_LPSDistanceAboveBreakoutATRValueValid,"WE_SL_LPSDistanceAboveBreakoutATRValueValid",1.0);
AddColumn(WE_SL_LPSNearBreakoutEdgeFlag,"WE_SL_LPSNearBreakoutEdgeFlag",1.0);
AddColumn(WE_SL_LPSContractionDataValid,"WE_SL_LPSContractionDataValid",1.0);
AddColumn(WE_SL_LPSSpreadContractedVsSOS,"WE_SL_LPSSpreadContractedVsSOS",1.0);
AddColumn(WE_SL_LPSVolumeContractedVsSOS,"WE_SL_LPSVolumeContractedVsSOS",1.0);
AddColumn(WE_SL_LPSTextbookSupplyContraction,"WE_SL_LPSTextbookSupplyContraction",1.0);
AddColumn(WE_SL_LPSNoSupplyCandidateContextValid,"WE_SL_LPSNoSupplyCandidateContextValid",1.0);
AddColumn(WE_SL_LPSNoSupplyCandidateAtOrigin,"WE_SL_LPSNoSupplyCandidateAtOrigin",1.0);
AddColumn(WE_SL_LPSLowEffortContextValid,"WE_SL_LPSLowEffortContextValid",1.0);
AddColumn(WE_SL_LPSLowEffortAtOrigin,"WE_SL_LPSLowEffortAtOrigin",1.0);

AddColumn(WE_SL_LPSResolutionCode,"WE_SL_LPSResolutionCode",1.0);
AddColumn(WE_SL_LPSResolutionValid,"WE_SL_LPSResolutionValid",1.0);
AddColumn(WE_SL_LPSConfirmed,"WE_SL_LPSConfirmed",1.0);
AddColumn(WE_SL_LPSResolutionReasonCode,"WE_SL_LPSResolutionReasonCode",1.0);
AddMultiTextColumn(WE_SL_LPSResolutionCode,WE_SL_LPSResolutionStatusText,"WE_SL_LPSResolutionStatus");
AddColumn(WE_SL_LPSResolutionOriginBarIndex,"WE_SL_LPSResolutionOriginBarIndex",1.0);
AddColumn(WE_SL_LPSResolutionOriginDateTime,"WE_SL_LPSResolutionOriginDateTime",formatDateTime);
AddColumn(WE_SL_LPSResolutionBreakoutLevel,"WE_SL_LPSResolutionBreakoutLevel",1.12);
AddColumn(WE_SL_LPSResolutionAnchorSOSBarIndex,"WE_SL_LPSResolutionAnchorSOSBarIndex",1.0);
AddColumn(WE_SL_LPSEvaluationBarIndex,"WE_SL_LPSEvaluationBarIndex",1.0);
AddColumn(WE_SL_LPSEvaluationDateTime,"WE_SL_LPSEvaluationDateTime",formatDateTime);
