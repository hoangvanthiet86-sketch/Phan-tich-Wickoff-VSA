WSS_PSYEvidenceUpsidePressure = WSS_Null;
WSS_PSYEvidenceElevatedExpansion = WSS_Null;

// Active frozen sequence snapshots for downstream Phase/Context.
WSS_LowerActiveSnapshotValid = WSS_Zero;
WSS_LowerActiveSequenceOrdinal = WSS_Null;
WSS_LowerActiveSCOriginBI = WSS_Null;
WSS_LowerActiveSCConfirmBI = WSS_Null;
WSS_LowerActiveSCLow = WSS_Null;
WSS_LowerActiveSCHigh = WSS_Null;
WSS_LowerActiveSCRVOL = WSS_Null;
WSS_LowerActiveSCRVOLValid = WSS_Null;
WSS_LowerActiveSCRSpread = WSS_Null;
WSS_LowerActiveSCRSpreadValid = WSS_Null;
WSS_LowerActiveSCClosePosition = WSS_Null;
WSS_LowerActiveSCClosePositionValid = WSS_Null;
WSS_LowerActiveSCDirectionalProgress = WSS_Null;
WSS_LowerActiveSCDirectionalProgressValid = WSS_Null;
WSS_LowerActiveSCStoppingVolumeCode = WSS_Null;
WSS_LowerActiveSCAbsorptionCode = WSS_Null;
WSS_LowerActiveARExtremeBI = WSS_Null;
WSS_LowerActiveARConfirmBI = WSS_Null;
WSS_LowerActiveARHigh = WSS_Null;
WSS_LowerActiveRangeLower = WSS_Null;
WSS_LowerActiveRangeUpper = WSS_Null;
WSS_LowerActiveRangeWidth = WSS_Null;
WSS_LowerActivePSLikeCode = WSS_Null;
WSS_LowerActivePSExtremeBI = WSS_Null;
WSS_LowerActivePSElevatedExpansion = WSS_Null;
WSS_LowerActivePSStoppingVolumeCode = WSS_Null;
WSS_LowerActiveSCContextSPositionStateCode = WSS_Null;
WSS_LowerActiveSCContextMPositionStateCode = WSS_Null;
WSS_LowerActiveSCContextLPositionStateCode = WSS_Null;
