WSS_SCRSpreadValid = WSS_Null;
WSS_SCClosePosition = WSS_Null;
WSS_SCClosePositionValid = WSS_Null;
WSS_SCDirectionalProgress = WSS_Null;
WSS_SCDirectionalProgressValid = WSS_Null;
WSS_SCClimacticDirectionCode = WSS_Null;
WSS_SCClimacticDirectionValid = WSS_Null;
WSS_SCStoppingVolumeCode = WSS_Null;
WSS_SCStoppingVolumeValid = WSS_Null;
WSS_SCAbsorptionCode = WSS_Null;
WSS_SCAbsorptionValid = WSS_Null;
