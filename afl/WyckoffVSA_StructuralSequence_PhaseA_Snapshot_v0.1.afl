WSS_SCContextLLocation = WSS_Null;

WSS_ARContextSReferenceStatusCode = WSS_Null;
WSS_ARContextSPositionStateCode = WSS_Null;
WSS_ARContextSLocationValid = WSS_Null;
WSS_ARContextSLocation = WSS_Null;
WSS_ARContextMReferenceStatusCode = WSS_Null;
WSS_ARContextMPositionStateCode = WSS_Null;
WSS_ARContextMLocationValid = WSS_Null;
WSS_ARContextMLocation = WSS_Null;
WSS_ARContextLReferenceStatusCode = WSS_Null;
WSS_ARContextLPositionStateCode = WSS_Null;
WSS_ARContextLLocationValid = WSS_Null;
WSS_ARContextLLocation = WSS_Null;

WSS_PSEvidenceDownsidePressure = WSS_Null;
WSS_PSEvidenceElevatedExpansion = WSS_Null;
WSS_PSEvidenceStoppingVolumeCode = WSS_Null;
WSS_PSEvidenceStoppingVolumeValid = WSS_Null;

// Pair-known snapshots — upper side.
WSS_BCOpen = WSS_Null;
WSS_BCHigh = WSS_Null;
WSS_BCLow = WSS_Null;
WSS_BCClose = WSS_Null;
WSS_BCRVOL = WSS_Null;
WSS_BCRVOLValid = WSS_Null;
WSS_BCRSpread = WSS_Null;
WSS_BCRSpreadValid = WSS_Null;
WSS_BCClosePosition = WSS_Null;
WSS_BCClosePositionValid = WSS_Null;
WSS_BCDirectionalProgress = WSS_Null;
WSS_BCDirectionalProgressValid = WSS_Null;
WSS_BCClimacticDirectionCode = WSS_Null;
WSS_BCClimacticDirectionValid = WSS_Null;
WSS_BCStoppingVolumeCode = WSS_Null;
WSS_BCStoppingVolumeValid = WSS_Null;
WSS_BCAbsorptionCode = WSS_Null;
WSS_BCAbsorptionValid = WSS_Null;
WSS_BCUpsidePressureObserved = WSS_Null;
WSS_BCElevatedExpansionObservation = WSS_Null;
WSS_BCUltraEffortFlag = WSS_Null;

WSS_ReactionOpen = WSS_Null;
WSS_ReactionHigh = WSS_Null;
WSS_ReactionLow = WSS_Null;
WSS_ReactionClose = WSS_Null;

WSS_BCContextSReferenceStatusCode = WSS_Null;
WSS_BCContextSPositionStateCode = WSS_Null;
WSS_BCContextSLocationValid = WSS_Null;
WSS_BCContextSLocation = WSS_Null;
WSS_BCContextMReferenceStatusCode = WSS_Null;
WSS_BCContextMPositionStateCode = WSS_Null;
WSS_BCContextMLocationValid = WSS_Null;
WSS_BCContextMLocation = WSS_Null;
WSS_BCContextLReferenceStatusCode = WSS_Null;
WSS_BCContextLPositionStateCode = WSS_Null;
WSS_BCContextLLocationValid = WSS_Null;
