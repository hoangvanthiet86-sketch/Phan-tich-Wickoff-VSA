/*
    Wyckoff VSA Structural Sequence v0.1 — D29 Frozen Snapshot Interface

    SPEC-ALIGNED / UNTESTED DEVELOPMENT.
    Approved specification: PR #20, merge commit e3a2c342c435aa2fd905fff4ae7ea14d060dafcf

    Public downstream facade for Phase/Context development.
    It includes the Structural Sequence state machine and adds the complete
    frozen snapshot contract required by D29. No trading signal.
*/
#include_once <WyckoffVSA_StructuralSequence_PhaseA_v0.1.afl>

_SECTION_BEGIN("53. D29 frozen snapshot contracts");
WSS_SourceBI = BarIndex();
WSS_Zero = 0 * WSS_SourceBI;
WSS_Null = Null + WSS_Zero;

// Pair-known snapshots — lower side.
WSS_SCOpen = WSS_Null;
WSS_SCHigh = WSS_Null;
WSS_SCLow = WSS_Null;
WSS_SCClose = WSS_Null;
WSS_SCRVOL = WSS_Null;
WSS_SCRVOLValid = WSS_Null;
