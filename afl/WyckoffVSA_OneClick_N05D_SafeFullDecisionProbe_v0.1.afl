/*
    Wyckoff VSA One-Click N05D Safe Full-Decision Probe v0.1

    SAFE ORCHESTRATION AFTER N05/N05.1 COMPILER CRASH.

    Design:
    - exactly TWO textual generated-body include sites, matching the native-passing
      N04A architecture;
    - stock loop runs Weekly -> Monthly -> Daily, so Daily is LAST and remains live;
    - RS runs immediately after the stock loop against live stock Daily SL_*/WCI_*;
    - market loop runs Daily -> Weekly -> Monthly;
    - compact candidate decision surface only.

    No methodology / threshold / categorical rule change.

    FIRST ACTION: Verify Syntax only.
    Explore only after Verify Syntax returns zero errors.

    Control:
    Apply to = SNZ only
    Periodicity = Daily
    Range = 1 Recent Bar
    RuntimeConfig defaults
    1.3 last bar provisional = No
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

#include_once <WyckoffVSA_RuntimeConfig_v0.2.afl>
#include_once <WyckoffVSA_OperationalClock_v0.1.afl>
#include_once <WyckoffVSA_OneClickContextHelpers_Generated_v0.1.afl>
#include_once <WyckoffVSA_MTFRelationKernel_v0.1.afl>
#include_once <WyckoffVSA_ScannerDecisionKernel_v0.1.afl>

function WVOC_N05D_Finite(x)
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

WVOC_N05D_ExpectedW = WCLK_ExpectedCompletedWeeklyOrdinal;
WVOC_N05D_ExpectedM = WCLK_ExpectedCompletedMonthlyOrdinal;

WVOC_N05D_SD_Found = 0;
WVOC_N05D_SW_Found = 0;
WVOC_N05D_SM_Found = 0;

// -----------------------------------------------------------------------------
// STOCK: W -> M -> D. Daily intentionally LAST so RS can consume live Daily.
// -----------------------------------------------------------------------------
for (WVOC_N05D_ctx=0; WVOC_N05D_ctx<3; WVOC_N05D_ctx++)
{
    if (WVOC_N05D_ctx==0) TimeFrameSet(inWeekly);
    if (WVOC_N05D_ctx==1) TimeFrameSet(inMonthly);

    GetPerformanceCounter(1);
    #include <WyckoffVSA_OneClickContextBody_Generated_v0.1.afl>
    WVOC_N05D_elapsed = GetPerformanceCounter();

    if (WVOC_N05D_ctx==0)
    {
        WVOC_N05D_W_DTArr = DateTime();
        WVOC_N05D_W_OrdArr = Floor(DateTimeDiff(WVOC_N05D_W_DTArr,WCLK_WeekEpoch)/604800);
        WVOC_N05D_W_idx = -1;
        for (WVOC_N05D_j=BarCount-1; WVOC_N05D_j>=0; WVOC_N05D_j--)
            if (WVOC_N05D_W_idx<0 AND WVOC_N05D_W_OrdArr[WVOC_N05D_j]==WVOC_N05D_ExpectedW)
                WVOC_N05D_W_idx = WVOC_N05D_j;

        WVOC_N05D_SW_Found = WVOC_N05D_W_idx>=0;
        WVOC_N05D_W_safe = IIf(WVOC_N05D_SW_Found,WVOC_N05D_W_idx,0);
        WVOC_N05D_SW_Ord = IIf(WVOC_N05D_SW_Found,WVOC_N05D_W_OrdArr[WVOC_N05D_W_safe],Null);
        WVOC_N05D_SW_Mult = IIf(WVOC_N05D_SW_Found,WCI_ContextMultiplicityCode[WVOC_N05D_W_safe],Null);
        WVOC_N05D_SW_Dir = IIf(WVOC_N05D_SW_Found,WCI_DirectionalContextCode[WVOC_N05D_W_safe],Null);
        WVOC_N05D_SW_Evidence = IIf(WVOC_N05D_SW_Found,WCI_EvidenceBalanceCode[WVOC_N05D_W_safe],Null);
        WVOC_N05D_SW_Phase = IIf(WVOC_N05D_SW_Found,WCI_PhaseStateCode[WVOC_N05D_W_safe],Null);
        WVOC_N05D_SW_ms = WVOC_N05D_elapsed;
    }

    if (WVOC_N05D_ctx==1)
    {
        WVOC_N05D_M_DTArr = DateTime();
        WVOC_N05D_M_OrdArr = Year()*12 + Month();
        WVOC_N05D_M_idx = -1;
        for (WVOC_N05D_k=BarCount-1; WVOC_N05D_k>=0; WVOC_N05D_k--)
            if (WVOC_N05D_M_idx<0 AND WVOC_N05D_M_OrdArr[WVOC_N05D_k]==WVOC_N05D_ExpectedM)
                WVOC_N05D_M_idx = WVOC_N05D_k;

        WVOC_N05D_SM_Found = WVOC_N05D_M_idx>=0;
        WVOC_N05D_M_safe = IIf(WVOC_N05D_SM_Found,WVOC_N05D_M_idx,0);
        WVOC_N05D_SM_Ord = IIf(WVOC_N05D_SM_Found,WVOC_N05D_M_OrdArr[WVOC_N05D_M_safe],Null);
        WVOC_N05D_SM_Mult = IIf(WVOC_N05D_SM_Found,WCI_ContextMultiplicityCode[WVOC_N05D_M_safe],Null);
        WVOC_N05D_SM_Dir = IIf(WVOC_N05D_SM_Found,WCI_DirectionalContextCode[WVOC_N05D_M_safe],Null);
        WVOC_N05D_SM_Evidence = IIf(WVOC_N05D_SM_Found,WCI_EvidenceBalanceCode[WVOC_N05D_M_safe],Null);
        WVOC_N05D_SM_Phase = IIf(WVOC_N05D_SM_Found,WCI_PhaseStateCode[WVOC_N05D_M_safe],Null);
        WVOC_N05D_SM_ms = WVOC_N05D_elapsed;
    }

    if (WVOC_N05D_ctx==2)
    {
        WVOC_N05D_SD_Found = 1;
        WVOC_N05D_SD_DT = LastValue(WCI_SourceDateTime);
        WVOC_N05D_SD_Close = LastValue(Close);
        WVOC_N05D_SD_Provisional = LastValue(WCI_ProvisionalFlag);
        WVOC_N05D_SD_Mult = LastValue(WCI_ContextMultiplicityCode);
        WVOC_N05D_SD_Dir = LastValue(WCI_DirectionalContextCode);
        WVOC_N05D_SD_Phase = LastValue(WCI_PhaseStateCode);
        WVOC_N05D_SD_Evidence = LastValue(WCI_EvidenceBalanceCode);
        WVOC_N05D_SD_Hyp = LastValue(WCI_HypothesisAlignmentCode);
        WVOC_N05D_SD_RangeStatus = LastValue(WCI_RangeStatusCode);
        WVOC_N05D_SD_RangePos = LastValue(WCI_RangePosition);
        WVOC_N05D_SD_ms = WVOC_N05D_elapsed;
    }

    if (WVOC_N05D_ctx<2) TimeFrameRestore();
}

// RS against the live stock Daily arrays.
GetPerformanceCounter(1);
#include_once <WyckoffVSA_OneClickRSKernel_v0.1.2.afl>
WVOC_N05D_RS_ms = GetPerformanceCounter();

WVOC_N05D_RS_Valid = LastValue(WRS_ContextValid)==1;
WVOC_N05D_RS_Status = LastValue(WRS_ContextStatusCode);
WVOC_N05D_RS_MarketStatus = LastValue(WRS_MarketBenchmarkStatusCode);
WVOC_N05D_RS_Structure = LastValue(WRS_StockVsMarketRSStructureCode);
WVOC_N05D_RS_PriceRelationship = LastValue(WRS_PriceRSRelationshipCode);
WVOC_N05D_RS_Provisional = LastValue(WRS_CurrentDescriptorProvisional);
WVOC_N05D_RS_Ratio = LastValue(WRS_StockVsMarketRatio);

// Stock MTF.
WVOC_N05D_S_MTFValid =
    WVRC_ConfigValid AND WVOC_N05D_SD_Found AND WVOC_N05D_SW_Found AND WVOC_N05D_SM_Found;

WVMTF_Run(
    "N05DS",
    WVOC_N05D_S_MTFValid,
    WVOC_N05D_SD_Mult,WVOC_N05D_SW_Mult,WVOC_N05D_SM_Mult,
    WVOC_N05D_SD_Dir,WVOC_N05D_SW_Dir,WVOC_N05D_SM_Dir,
    WVOC_N05D_SD_Evidence,WVOC_N05D_SW_Evidence,WVOC_N05D_SM_Evidence,
    WVOC_N05D_SD_Phase,WVOC_N05D_SW_Phase,WVOC_N05D_SM_Phase);

WVOC_N05D_S_MTFDir = VarGet("WVMTF_N05DS_DirectionalAlignment");
WVOC_N05D_S_MTFConflict = VarGet("WVMTF_N05DS_ConflictMask");

// -----------------------------------------------------------------------------
// MARKET: D -> W -> M. Same shape as native-passing N04A.
// -----------------------------------------------------------------------------
WVOC_N05D_MKT_ForeignOK = SetForeign(WVRC_SelectionMarketSymbol,1,0);
WVOC_N05D_MD_Found = 0;
WVOC_N05D_MW_Found = 0;
WVOC_N05D_MM_Found = 0;

if (WVOC_N05D_MKT_ForeignOK)
{
    for (WVOC_N05D_mctx=0; WVOC_N05D_mctx<3; WVOC_N05D_mctx++)
    {
        if (WVOC_N05D_mctx==1) TimeFrameSet(inWeekly);
        if (WVOC_N05D_mctx==2) TimeFrameSet(inMonthly);

        GetPerformanceCounter(1);
        #include <WyckoffVSA_OneClickContextBody_Generated_v0.1.afl>
        WVOC_N05D_melapsed = GetPerformanceCounter();

        if (WVOC_N05D_mctx==0)
        {
            WVOC_N05D_MD_Found = 1;
            WVOC_N05D_MD_Mult = LastValue(WCI_ContextMultiplicityCode);
            WVOC_N05D_MD_Dir = LastValue(WCI_DirectionalContextCode);
            WVOC_N05D_MD_Evidence = LastValue(WCI_EvidenceBalanceCode);
            WVOC_N05D_MD_Phase = LastValue(WCI_PhaseStateCode);
            WVOC_N05D_MD_Hyp = LastValue(WCI_HypothesisAlignmentCode);
            WVOC_N05D_MD_ms = WVOC_N05D_melapsed;
        }

        if (WVOC_N05D_mctx==1)
        {
            WVOC_N05D_MW_DTArr = DateTime();
            WVOC_N05D_MW_OrdArr = Floor(DateTimeDiff(WVOC_N05D_MW_DTArr,WCLK_WeekEpoch)/604800);
            WVOC_N05D_MW_idx = -1;
            for (WVOC_N05D_mj=BarCount-1; WVOC_N05D_mj>=0; WVOC_N05D_mj--)
                if (WVOC_N05D_MW_idx<0 AND WVOC_N05D_MW_OrdArr[WVOC_N05D_mj]==WVOC_N05D_ExpectedW)
                    WVOC_N05D_MW_idx = WVOC_N05D_mj;

            WVOC_N05D_MW_Found = WVOC_N05D_MW_idx>=0;
            WVOC_N05D_MW_safe = IIf(WVOC_N05D_MW_Found,WVOC_N05D_MW_idx,0);
            WVOC_N05D_MW_Ord = IIf(WVOC_N05D_MW_Found,WVOC_N05D_MW_OrdArr[WVOC_N05D_MW_safe],Null);
            WVOC_N05D_MW_Mult = IIf(WVOC_N05D_MW_Found,WCI_ContextMultiplicityCode[WVOC_N05D_MW_safe],Null);
            WVOC_N05D_MW_Dir = IIf(WVOC_N05D_MW_Found,WCI_DirectionalContextCode[WVOC_N05D_MW_safe],Null);
            WVOC_N05D_MW_Evidence = IIf(WVOC_N05D_MW_Found,WCI_EvidenceBalanceCode[WVOC_N05D_MW_safe],Null);
            WVOC_N05D_MW_Phase = IIf(WVOC_N05D_MW_Found,WCI_PhaseStateCode[WVOC_N05D_MW_safe],Null);
            WVOC_N05D_MW_ms = WVOC_N05D_melapsed;
        }

        if (WVOC_N05D_mctx==2)
        {
            WVOC_N05D_MM_DTArr = DateTime();
            WVOC_N05D_MM_OrdArr = Year()*12 + Month();
            WVOC_N05D_MM_idx = -1;
            for (WVOC_N05D_mk=BarCount-1; WVOC_N05D_mk>=0; WVOC_N05D_mk--)
                if (WVOC_N05D_MM_idx<0 AND WVOC_N05D_MM_OrdArr[WVOC_N05D_mk]==WVOC_N05D_ExpectedM)
                    WVOC_N05D_MM_idx = WVOC_N05D_mk;

            WVOC_N05D_MM_Found = WVOC_N05D_MM_idx>=0;
            WVOC_N05D_MM_safe = IIf(WVOC_N05D_MM_Found,WVOC_N05D_MM_idx,0);
            WVOC_N05D_MM_Ord = IIf(WVOC_N05D_MM_Found,WVOC_N05D_MM_OrdArr[WVOC_N05D_MM_safe],Null);
            WVOC_N05D_MM_Mult = IIf(WVOC_N05D_MM_Found,WCI_ContextMultiplicityCode[WVOC_N05D_MM_safe],Null);
            WVOC_N05D_MM_Dir = IIf(WVOC_N05D_MM_Found,WCI_DirectionalContextCode[WVOC_N05D_MM_safe],Null);
            WVOC_N05D_MM_Evidence = IIf(WVOC_N05D_MM_Found,WCI_EvidenceBalanceCode[WVOC_N05D_MM_safe],Null);
            WVOC_N05D_MM_Phase = IIf(WVOC_N05D_MM_Found,WCI_PhaseStateCode[WVOC_N05D_MM_safe],Null);
            WVOC_N05D_MM_ms = WVOC_N05D_melapsed;
        }

        if (WVOC_N05D_mctx>0) TimeFrameRestore();
    }
}

RestorePriceArrays();

WVOC_N05D_M_MTFValid =
    WVRC_ConfigValid AND WVOC_N05D_MKT_ForeignOK AND
    WVOC_N05D_MD_Found AND WVOC_N05D_MW_Found AND WVOC_N05D_MM_Found;

WVMTF_Run(
    "N05DM",
    WVOC_N05D_M_MTFValid,
    WVOC_N05D_MD_Mult,WVOC_N05D_MW_Mult,WVOC_N05D_MM_Mult,
    WVOC_N05D_MD_Dir,WVOC_N05D_MW_Dir,WVOC_N05D_MM_Dir,
    WVOC_N05D_MD_Evidence,WVOC_N05D_MW_Evidence,WVOC_N05D_MM_Evidence,
    WVOC_N05D_MD_Phase,WVOC_N05D_MW_Phase,WVOC_N05D_MM_Phase);

WVOC_N05D_M_MTFDir = VarGet("WVMTF_N05DM_DirectionalAlignment");

WVOC_N05D_MarketSelection = WVOC_SelectionContext(
    WVOC_N05D_M_MTFValid,
    WVOC_N05D_MD_Mult,
    WVOC_N05D_MD_Dir,
    WVOC_N05D_MD_Evidence,
    WVOC_N05D_MD_Hyp,
    WVOC_N05D_M_MTFDir);

// -----------------------------------------------------------------------------
// COMPACT DEFAULT-PROFILE CANDIDATE DECISION
// -----------------------------------------------------------------------------
WVOC_N05D_Stage = WVOC_StageFromPhase(WVOC_N05D_SD_Phase);
WVOC_N05D_MarketConfigMatch =
    StrLen(WVRC_SelectionMarketSymbol)>0 AND
    WVRC_SelectionMarketSymbol==WVRC_RSMarketSymbol;

WVOC_N05D_RangeValid =
    WVOC_N05D_SD_Mult==1 AND WVOC_N05D_SD_RangeStatus==1 AND
    WVOC_N05D_Finite(WVOC_N05D_SD_RangePos);

WVOC_N05D_RangeConflict =
    WVOC_N05D_Stage==1 AND WVOC_N05D_RangeValid AND
    (WVOC_N05D_SD_RangePos<0 OR WVOC_N05D_SD_RangePos>1);

WVOC_N05D_RangeCoherent =
    WVOC_N05D_Stage!=1 OR
    (WVOC_N05D_RangeValid AND WVOC_N05D_SD_RangePos>=0 AND WVOC_N05D_SD_RangePos<=1);

WVOC_N05D_RequiredFinite =
    WVOC_N05D_Finite(WVOC_N05D_SD_Close) AND WVOC_N05D_SD_Close>0 AND
    WVOC_N05D_Finite(WVOC_N05D_SD_DT) AND
    WVOC_N05D_Finite(WVOC_N05D_SD_Mult) AND
    WVOC_N05D_Finite(WVOC_N05D_SD_Dir) AND
    WVOC_N05D_Finite(WVOC_N05D_SD_Phase) AND
    WVOC_N05D_Finite(WVOC_N05D_SD_Evidence) AND
    WVOC_N05D_Finite(WVOC_N05D_SD_Hyp) AND
    WVOC_N05D_Finite(WVOC_N05D_S_MTFDir) AND
    WVOC_N05D_Finite(WVOC_N05D_RS_Structure);

WVOC_N05D_ExclusionMask =
      IIf(WVOC_N05D_SD_Provisional==1 OR WVOC_N05D_RS_Provisional==1,1,0)
    + IIf(NOT WVRC_ConfigValid,2,0)
    + IIf(NOT (WVOC_N05D_RS_MarketStatus==3 AND WVOC_N05D_RS_Valid),4,0)
    + IIf(WVRC_RSAdjustmentBasisStatus!=1,8,0)
    + IIf(NOT WVOC_N05D_S_MTFValid,16,0)
    + IIf(NOT WVOC_N05D_M_MTFValid,32,0)
    + IIf(NOT WVOC_N05D_RequiredFinite,128,0)
    + IIf(Interval()!=inDaily,256,0)
    + IIf(NOT WVOC_N05D_MarketConfigMatch,512,0);

WVOC_N05D_DataEligible = WVOC_N05D_ExclusionMask==0;

WVOC_N05D_PriceRSNonConfirmation =
    WVOC_N05D_RS_PriceRelationship==2 OR WVOC_N05D_RS_PriceRelationship==3;
WVOC_N05D_StockConflict =
    WVOC_N05D_SD_Evidence==3 OR WVOC_N05D_SD_Hyp==3;
WVOC_N05D_MTFConflict =
    WVOC_N05D_S_MTFDir==4 OR WVOC_N05D_S_MTFDir==5 OR WVOC_N05D_S_MTFDir==6;
WVOC_N05D_RSMixed = WVOC_N05D_RS_Structure==3;
WVOC_N05D_MultiRange = WVOC_N05D_SD_Mult==2;
WVOC_N05D_MarketStockConflict =
    (WVOC_N05D_MarketSelection==2 AND WVOC_N05D_SD_Dir==3) OR
    (WVOC_N05D_MarketSelection==3 AND WVOC_N05D_SD_Dir==2);

WVOC_N05D_Review =
    WVOC_N05D_DataEligible AND (
      WVOC_N05D_MultiRange OR WVOC_N05D_PriceRSNonConfirmation OR
      WVOC_N05D_StockConflict OR WVOC_N05D_MTFConflict OR
      WVOC_N05D_RSMixed OR WVOC_N05D_MarketStockConflict OR
      WVOC_N05D_RangeConflict);

WVOC_N05D_BullEvidence =
    WVOC_N05D_SD_Evidence!=2 AND WVOC_N05D_SD_Evidence!=3 AND WVOC_N05D_SD_Hyp!=3;
WVOC_N05D_BearEvidence =
    WVOC_N05D_SD_Evidence!=1 AND WVOC_N05D_SD_Evidence!=3 AND WVOC_N05D_SD_Hyp!=3;

WVOC_N05D_BullQual =
    WVOC_N05D_DataEligible AND NOT WVOC_N05D_Review AND
    WVOC_N05D_MarketSelection==2 AND WVOC_N05D_SD_Dir==2 AND
    (WVOC_N05D_Stage==3 OR WVOC_N05D_Stage==4) AND
    WVOC_N05D_S_MTFDir==2 AND WVOC_N05D_RS_Structure==1 AND
    WVOC_N05D_BullEvidence AND NOT WVOC_N05D_PriceRSNonConfirmation AND WVOC_N05D_SD_Mult==1;

WVOC_N05D_BearQual =
    WVOC_N05D_DataEligible AND NOT WVOC_N05D_Review AND
    WVOC_N05D_MarketSelection==3 AND WVOC_N05D_SD_Dir==3 AND
    (WVOC_N05D_Stage==3 OR WVOC_N05D_Stage==4) AND
    WVOC_N05D_S_MTFDir==3 AND WVOC_N05D_RS_Structure==2 AND
    WVOC_N05D_BearEvidence AND NOT WVOC_N05D_PriceRSNonConfirmation AND WVOC_N05D_SD_Mult==1;

WVOC_N05D_BullDev =
    WVOC_N05D_DataEligible AND NOT WVOC_N05D_Review AND
    WVOC_N05D_Stage==2 AND WVOC_N05D_MarketSelection==2 AND
    WVOC_N05D_SD_Dir==2 AND WVOC_N05D_RS_Structure==1 AND
    WVOC_N05D_BullEvidence AND
    (WVOC_N05D_S_MTFDir==1 OR WVOC_N05D_S_MTFDir==2);

WVOC_N05D_BearDev =
    WVOC_N05D_DataEligible AND NOT WVOC_N05D_Review AND
    WVOC_N05D_Stage==2 AND WVOC_N05D_MarketSelection==3 AND
    WVOC_N05D_SD_Dir==3 AND WVOC_N05D_RS_Structure==2 AND
    WVOC_N05D_BearEvidence AND
    (WVOC_N05D_S_MTFDir==1 OR WVOC_N05D_S_MTFDir==3);

WVOC_N05D_Watch =
    WVOC_N05D_DataEligible AND NOT WVOC_N05D_Review AND
    WVOC_N05D_Stage==1 AND WVOC_N05D_RangeCoherent AND
    (WVOC_N05D_RS_Structure==1 OR WVOC_N05D_RS_Structure==2);

WVOC_N05D_Class = WVOC_CandidateClass(
    WVOC_N05D_DataEligible,
    WVOC_N05D_Review,
    0,WVOC_N05D_BullQual,
    0,WVOC_N05D_BearQual,
    WVOC_N05D_BullDev,WVOC_N05D_BearDev,WVOC_N05D_Watch);

WVOC_N05D_Side =
    WVOC_CandidateSide(WVOC_N05D_Class,WVOC_N05D_SD_Dir,WVOC_N05D_RS_Structure);
WVOC_N05D_Qualified = WVOC_Qualified(WVOC_N05D_Class);
WVOC_N05D_Developing = WVOC_Developing(WVOC_N05D_Class);
WVOC_N05D_WatchFlag = WVOC_Watch(WVOC_N05D_Class);

WVOC_N05D_ReferenceClass =
    IIf(NOT WVOC_N05D_DataEligible,0,
    IIf(WVOC_N05D_Review,9,
    IIf(WVOC_N05D_BullQual,4,
    IIf(WVOC_N05D_BearQual,7,
    IIf(WVOC_N05D_BullDev,3,
    IIf(WVOC_N05D_BearDev,6,
    IIf(WVOC_N05D_Watch,2,1)))))));

WVOC_N05D_KernelMatch = WVOC_N05D_Class==WVOC_N05D_ReferenceClass;

// -----------------------------------------------------------------------------
// OUTPUT
// -----------------------------------------------------------------------------
Filter = BarIndex()==LastValue(BarIndex());

AddTextColumn(Name(),"Symbol");
AddColumn(DateTime(),"As-Of",formatDateTime);
AddColumn(0*BarIndex()+WVRC_ConfigValid,"Config Valid",1.0);

AddColumn(0*BarIndex()+WVOC_N05D_SW_Ord,"W Ord",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_SM_Ord,"M Ord",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_S_MTFValid,"Stock MTF Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_S_MTFDir,"Stock MTF Dir",1.0);

AddColumn(0*BarIndex()+WVOC_N05D_RS_Valid,"RS Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_RS_Status,"RS Status",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_RS_Ratio,"RS Ratio",1.6);
AddColumn(0*BarIndex()+WVOC_N05D_RS_Structure,"RS Structure",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_RS_PriceRelationship,"Price RS Relationship",1.0);

AddColumn(0*BarIndex()+WVOC_N05D_MKT_ForeignOK,"Market Foreign OK",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_M_MTFValid,"Market MTF Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_M_MTFDir,"Market MTF Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_MarketSelection,"Market Selection",1.0);

AddColumn(0*BarIndex()+WVOC_N05D_DataEligible,"Data Eligible",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_ExclusionMask,"Exclusion Mask",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Stage,"Candidate Stage",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Review,"Review",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Class,"Candidate Class",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_ReferenceClass,"Reference Class",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_KernelMatch,"Kernel Class Match",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Side,"Candidate Side",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Qualified,"Qualified",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_Developing,"Developing",1.0);
AddColumn(0*BarIndex()+WVOC_N05D_WatchFlag,"Watch",1.0);

AddColumn(0*BarIndex()+WVOC_N05D_SD_ms,"D ms",1.3);
AddColumn(0*BarIndex()+WVOC_N05D_RS_ms,"RS ms",1.3);
AddColumn(0*BarIndex()+WVOC_N05D_SW_ms,"W ms",1.3);
AddColumn(0*BarIndex()+WVOC_N05D_SM_ms,"M ms",1.3);
AddColumn(0*BarIndex()+WVOC_N05D_MD_ms,"MKT D ms",1.3);
AddColumn(0*BarIndex()+WVOC_N05D_MW_ms,"MKT W ms",1.3);
