_SECTION_BEGIN("115. Relative Strength exploration text");
WRS_ContextStatusText = "READY\nWRONG INTERVAL\nMARKET CONFIG MISSING\nMARKET DATA INVALID / MISSING\nPIVOT CONFIG INVALID\nADJUSTMENT BASIS INCOMPATIBLE\nADJUSTMENT BASIS NOT VERIFIED\nPROVISIONAL LAST BAR";
WRS_BenchmarkStatusText = "NOT CONFIGURED / NOT AVAILABLE\nMISSING SYNC BAR\nINVALID VALUE\nREADY";
WRS_StructureText = "INSUFFICIENT\nRISING RS STRUCTURE\nFALLING RS STRUCTURE\nMIXED / RANGE RS STRUCTURE";
WRS_PriceStructureText = "INSUFFICIENT\nRISING PRICE STRUCTURE\nFALLING PRICE STRUCTURE\nMIXED / RANGE PRICE STRUCTURE";
WRS_PriceRSRelationshipText = "INSUFFICIENT\nPRICE + RS RISING IN GEAR\nPRICE RISING / RS NON-CONFIRMING\nPRICE FALLING / RS NON-CONFIRMING STRONGER\nPRICE + RS FALLING IN GEAR\nMIXED / COMPLEX";
WRS_LeadershipText = "INSUFFICIENT\nNESTED RELATIVE LEADERSHIP\nNESTED RELATIVE WEAKNESS\nSTOCK LEADS WEAK GROUP\nSTOCK LAGS STRONG GROUP\nMIXED / COMPLEX LEADERSHIP";
WRS_PhaseRSText = "INSUFFICIENT\nBULLISH CONTEXT + RISING RS\nBULLISH CONTEXT + FALLING RS\nBEARISH CONTEXT + FALLING RS\nBEARISH CONTEXT + RISING RS\nUNRESOLVED / MIXED";
WRS_VSARSText = "INSUFFICIENT\nBULLISH VSA + RISING RS\nBULLISH VSA / FALLING RS CONFLICT\nBEARISH VSA + FALLING RS\nBEARISH VSA / RISING RS CONFLICT\nMIXED / COMPLEX";
WRS_MTFRSText = "INSUFFICIENT\nMTF BULLISH + RISING RS\nMTF BULLISH + FALLING RS\nMTF BEARISH + FALLING RS\nMTF BEARISH + RISING RS\nMIXED / COMPLEX";
WRS_WaveDirectionText = "INSUFFICIENT\nUP RS WAVE\nDOWN RS WAVE\nFLAT RS WAVE";
_SECTION_END();

_SECTION_BEGIN("116. Relative Strength exploration columns");
