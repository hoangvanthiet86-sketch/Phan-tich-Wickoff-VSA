AddColumn(0*BarIndex()+VarGet("WXSM_MTF_DirectionalAlignmentCode"),"Market MTF DirectionalAlignmentCode",1.0);
AddColumn(0*BarIndex()+VarGet("WXSM_MTF_ConflictReasonCode"),"Market MTF ConflictReasonCode",1.0);

AddTextColumn(VarGetText("WXSG_RequestedSymbol"),"Group RequestedSymbol");
AddTextColumn(VarGetText("WXSG_SnapshotSourceSymbol"),"Group SnapshotSourceSymbol");
AddColumn(WXS_GroupStatusCode,"Group StatusCode",1.0);
AddMultiTextColumn(WXS_GroupStatusCode,WXS_ConsumerStatusText,"Group Status");
AddColumn(0*BarIndex()+VarGet("WXSG_SourceBusinessDateKey"),"Group SourceBusinessDateKey",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_SourceBarDateTime"),"Group SourceBarDateTime",formatDateTime);
AddColumn(0*BarIndex()+VarGet("WXSG_GenerationA"),"Group GenerationA",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_GenerationB"),"Group GenerationB",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_ReadyA"),"Group ReadyA",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_ReadyB"),"Group ReadyB",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_CompositePayloadValid"),"Group CompositePayloadValid",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_MTFPayloadValid"),"Group MTFPayloadValid",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_DirectionalContextCode"),"Group DirectionalContextCode",1.0);
AddColumn(0*BarIndex()+VarGet("WXSG_PhaseStateCode"),"Group PhaseStateCode",1.0);
