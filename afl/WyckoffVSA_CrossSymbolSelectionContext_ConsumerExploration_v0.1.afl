/* Cross-Symbol Selection Context Consumer Exploration v0.1 */
#include_once <WyckoffVSA_CrossSymbolSelectionContext_Consumer_v0.1.afl>

_SECTION_BEGIN("113. Cross-Symbol Consumer Exploration");
Filter = Status("lastbarinrange");
