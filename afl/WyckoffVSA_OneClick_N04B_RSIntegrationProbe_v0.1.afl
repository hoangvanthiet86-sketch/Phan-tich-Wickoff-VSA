/*
    Wyckoff VSA One-Click N04B Relative Strength Integration Probe v0.1

    Scope intentionally isolated to RS after N04A passed Stock + VNINDEX + MTF.

    Purpose:
    - run stock Daily generated analytical body;
    - while stock Daily SL/WCI arrays are still live, consume them with the
      canonical One-Click RS kernel;
    - prove RS can run directly in the one-click path without DailyPublisher
      or snapshot warm-up.

    Control:
    Apply to = SNZ only
    Periodicity = Daily
    Range = 1 Recent Bar
    RuntimeConfig defaults
    1.3 last bar provisional = No
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

#include_once <WyckoffVSA_RuntimeConfig_v0.2.afl>
#include_once <WyckoffVSA_OperationalClock_v0.1.afl>
#include_once <WyckoffVSA_OneClickContextHelpers_Generated_v0.1.afl>

// Stock Daily analytical context.
GetPerformanceCounter(1);
#include <WyckoffVSA_OneClickContextBody_Generated_v0.1.afl>
WVOC_N04B_DailyMs = GetPerformanceCounter();

WVOC_N04B_D_Mult = LastValue(WCI_ContextMultiplicityCode);
WVOC_N04B_D_Dir = LastValue(WCI_DirectionalContextCode);
WVOC_N04B_D_Evidence = LastValue(WCI_EvidenceBalanceCode);
WVOC_N04B_D_Phase = LastValue(WCI_PhaseStateCode);
WVOC_N04B_D_Family = LastValue(WCI_FamilyHypothesisCode);
WVOC_N04B_D_RangeID = LastValue(WCI_CurrentRangeContextID);
WVOC_N04B_D_RangeStatus = LastValue(WCI_RangeStatusCode);
WVOC_N04B_D_RangePos = LastValue(WCI_RangePosition);
WVOC_N04B_D_Provisional = LastValue(WCI_ProvisionalFlag);
WVOC_N04B_PivotConfig = LastValue(SL_PivotConfigValid);

// Canonical-equivalent One-Click RS kernel derived from RelativeStrengthContext v0.1.
// Execute immediately before any timeframe/foreign context can overwrite
// stock Daily SL_* / WCI_* arrays.
GetPerformanceCounter(1);
#include_once <WyckoffVSA_OneClickRSKernel_v0.1.afl>
WVOC_N04B_RSMs = GetPerformanceCounter();

WVOC_N04B_RS_ContextValid = LastValue(WRS_ContextValid);
WVOC_N04B_RS_Status = LastValue(WRS_ContextStatusCode);
WVOC_N04B_RS_MarketStatus = LastValue(WRS_MarketBenchmarkStatusCode);
WVOC_N04B_RS_RatioValid = LastValue(WRS_StockVsMarketRatioValid);
WVOC_N04B_RS_Ratio = LastValue(WRS_StockVsMarketRatio);
WVOC_N04B_RS_Structure = LastValue(WRS_StockVsMarketRSStructureCode);
WVOC_N04B_RS_PriceRelationship = LastValue(WRS_PriceRSRelationshipCode);
WVOC_N04B_RS_Provisional = LastValue(WRS_CurrentDescriptorProvisional);

WVOC_N04B_LastBar = BarIndex()==LastValue(BarIndex());
Filter = WVOC_N04B_LastBar;

AddTextColumn(Name(),"Symbol");
AddColumn(DateTime(),"As-Of",formatDateTime);
AddColumn(0*BarIndex()+WVRC_ConfigValid,"Config Valid",1.0);
AddTextColumn(WVRC_RSMarketSymbol,"RS Market");
AddColumn(0*BarIndex()+WVRC_RSAdjustmentBasisStatus,"RS Adjustment Status",1.0);

AddColumn(0*BarIndex()+WVOC_N04B_D_Mult,"D Mult",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_Dir,"D Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_Evidence,"D Evidence",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_Phase,"D Phase",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_Family,"D Family",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_RangeID,"D Range ID",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_RangeStatus,"D Range Status",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_D_RangePos,"D Range Position",1.4);
AddColumn(0*BarIndex()+WVOC_N04B_D_Provisional,"D Provisional",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_PivotConfig,"Pivot Config Valid",1.0);

AddColumn(0*BarIndex()+WVOC_N04B_RS_ContextValid,"RS Context Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_Status,"RS Context Status",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_MarketStatus,"RS Market Status",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_RatioValid,"RS Ratio Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_Ratio,"RS Ratio",1.6);
AddColumn(0*BarIndex()+WVOC_N04B_RS_Structure,"RS Structure",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_PriceRelationship,"Price RS Relationship",1.0);
AddColumn(0*BarIndex()+WVOC_N04B_RS_Provisional,"RS Provisional",1.0);

AddColumn(0*BarIndex()+WVOC_N04B_DailyMs,"Daily Body ms",1.3);
AddColumn(0*BarIndex()+WVOC_N04B_RSMs,"RS Runtime ms",1.3);
AddTextColumn("ONE_CLICK_N04B_RS_INTEGRATION_V01_20260918_C","Probe Version");
