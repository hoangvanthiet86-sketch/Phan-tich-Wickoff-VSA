AddMultiTextColumn(WMTF_W_DirectionalContextCode,WCI_DirectionalContextText,"WMTF_W_DirectionalContext");
AddColumn(WMTF_W_EvidenceBalanceCode,"WMTF_W_EvidenceBalanceCode",1.0);
AddMultiTextColumn(WMTF_W_EvidenceBalanceCode,WCI_EvidenceBalanceText,"WMTF_W_EvidenceBalance");
AddColumn(WMTF_W_RangeStatusCode,"WMTF_W_RangeStatusCode",1.0);
AddColumn(WMTF_W_RangeContextID,"WMTF_W_RangeContextID",1.0);
AddColumn(WMTF_W_PrimaryRangeLow,"WMTF_W_PrimaryRangeLow",1.12);
AddColumn(WMTF_W_PrimaryRangeHigh,"WMTF_W_PrimaryRangeHigh",1.12);
AddColumn(WMTF_W_EventMask,"WMTF_W_EventMask",1.0);
