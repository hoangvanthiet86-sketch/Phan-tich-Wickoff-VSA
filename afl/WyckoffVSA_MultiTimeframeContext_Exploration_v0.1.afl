AddMultiTextColumn(WMTF_M_FamilyHypothesisCode,WPC_FamilyText,"WMTF_M_FamilyHypothesis");
AddColumn(WMTF_M_DirectionalContextCode,"WMTF_M_DirectionalContextCode",1.0);
AddMultiTextColumn(WMTF_M_DirectionalContextCode,WCI_DirectionalContextText,"WMTF_M_DirectionalContext");
AddColumn(WMTF_M_EvidenceBalanceCode,"WMTF_M_EvidenceBalanceCode",1.0);
AddMultiTextColumn(WMTF_M_EvidenceBalanceCode,WCI_EvidenceBalanceText,"WMTF_M_EvidenceBalance");
AddColumn(WMTF_M_RangeStatusCode,"WMTF_M_RangeStatusCode",1.0);
AddColumn(WMTF_M_RangeContextID,"WMTF_M_RangeContextID",1.0);
AddColumn(WMTF_M_PrimaryRangeLow,"WMTF_M_PrimaryRangeLow",1.12);
AddColumn(WMTF_M_PrimaryRangeHigh,"WMTF_M_PrimaryRangeHigh",1.12);
AddColumn(WMTF_M_EventMask,"WMTF_M_EventMask",1.0);
AddColumn(WMTF_M_EventSourceDateTime,"WMTF_M_EventSourceDateTime",formatDateTime);

// Cross-timeframe diagnostics.
AddColumn(WMTF_DirectionalAlignmentCode,"WMTF_DirectionalAlignmentCode",1.0);
AddMultiTextColumn(WMTF_DirectionalAlignmentCode,WMTF_DirectionalAlignmentText,"WMTF_DirectionalAlignment");
AddColumn(WMTF_EvidenceAlignmentCode,"WMTF_EvidenceAlignmentCode",1.0);
AddMultiTextColumn(WMTF_EvidenceAlignmentCode,WMTF_EvidenceAlignmentText,"WMTF_EvidenceAlignment");
