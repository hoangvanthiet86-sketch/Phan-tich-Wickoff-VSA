/*
    Wyckoff VSA One-Click N06C Function-Free Self-Healing Market Cache Probe v0.1

    Architecture correction after N06B terminated AmiBroker during Verify Syntax.

    IMPORTANT:
    - DOES NOT include WyckoffVSA_OneClickCacheContract_v0.1.afl
    - defines ZERO new user functions
    - uses the same cache schema/prefix/fingerprint semantics inline
    - market D/W/M path is the already native-passing N04A shape
    - cold miss rebuilds and commits market cache
    - warm hit skips heavy body

    Native protocol:
      1) Verify Syntax.
      2) If stable/0 errors, Explore SNZ / Daily / 1 Recent Bar.
      3) Explore again without changing date/config.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

#include_once <WyckoffVSA_DailySnapshotContract_v0.2.afl>
#include_once <WyckoffVSA_OperationalClock_v0.1.afl>
#include_once <WyckoffVSA_OneClickContextHelpers_Generated_v0.1.afl>
#include_once <WyckoffVSA_MTFRelationKernel_v0.1.afl>
#include_once <WyckoffVSA_ScannerDecisionKernel_v0.1.afl>

// -----------------------------------------------------------------------------
// Inline One-Click cache identity. Same semantics as CacheContract v0.1.
// -----------------------------------------------------------------------------
WVOC_N06C_SchemaMajor = 1;
WVOC_N06C_SchemaMinor = 0;
WVOC_N06C_ContractVersion = "0.1.0";
WVOC_N06C_AlgorithmVersion = "HYBRID_SELF_HEALING_CACHE_V01";

WVOC_N06C_AsOfDN = WCLK_AsOfDateNum;
WVOC_N06C_AsOfDT = WCLK_AsOfDateTime;
WVOC_N06C_EW = WCLK_ExpectedCompletedWeeklyOrdinal;
WVOC_N06C_EM = WCLK_ExpectedCompletedMonthlyOrdinal;
WVOC_N06C_MarketSymbol = WVRC_SelectionMarketSymbol;

WVOC_N06C_Fingerprint =
    "WVOC1.0;" +
    WDS_ConfigFingerprint +
    "ALG=" + WVOC_N06C_AlgorithmVersion + ";";

WVOC_N06C_Prefix =
    "WVSA_OC_v01_MKT_" + WVOC_N06C_MarketSymbol + "_";

// -----------------------------------------------------------------------------
// Inline metadata validation — no user function.
// -----------------------------------------------------------------------------
WVOC_N06C_Ready = Nz(StaticVarGet(WVOC_N06C_Prefix+"Ready"),0);
WVOC_N06C_WriteComplete = Nz(StaticVarGet(WVOC_N06C_Prefix+"WriteComplete"),0);
WVOC_N06C_SchemaMajorStored = Nz(StaticVarGet(WVOC_N06C_Prefix+"SchemaMajor"),-1);
WVOC_N06C_SchemaMinorStored = Nz(StaticVarGet(WVOC_N06C_Prefix+"SchemaMinor"),-1);
WVOC_N06C_RoleStored = StaticVarGetText(WVOC_N06C_Prefix+"Role");
WVOC_N06C_SymbolStored = StaticVarGetText(WVOC_N06C_Prefix+"Symbol");
WVOC_N06C_FPStored = StaticVarGetText(WVOC_N06C_Prefix+"ConfigFingerprint");
WVOC_N06C_GenStored = Nz(StaticVarGet(WVOC_N06C_Prefix+"CommittedGenerationID"),0);
WVOC_N06C_DNStored = StaticVarGet(WVOC_N06C_Prefix+"AsOfDateNum");
WVOC_N06C_DTStored = StaticVarGet(WVOC_N06C_Prefix+"AsOfDateTime");
WVOC_N06C_WStored = StaticVarGet(WVOC_N06C_Prefix+"CompletedWeeklyOrdinal");
WVOC_N06C_MStored = StaticVarGet(WVOC_N06C_Prefix+"CompletedMonthlyOrdinal");

WVOC_N06C_HitBefore =
    WVOC_N06C_Ready==1 AND
    WVOC_N06C_WriteComplete==1 AND
    WVOC_N06C_GenStored>0 AND
    WVOC_N06C_SchemaMajorStored==WVOC_N06C_SchemaMajor AND
    WVOC_N06C_SchemaMinorStored==WVOC_N06C_SchemaMinor AND
    WVOC_N06C_RoleStored=="MARKET" AND
    WVOC_N06C_SymbolStored==WVOC_N06C_MarketSymbol AND
    WVOC_N06C_FPStored==WVOC_N06C_Fingerprint AND
    NOT IsNull(WVOC_N06C_DNStored) AND
    NOT IsNull(WVOC_N06C_DTStored) AND
    NOT IsNull(WVOC_N06C_WStored) AND
    NOT IsNull(WVOC_N06C_MStored) AND
    WVOC_N06C_DNStored==WVOC_N06C_AsOfDN AND
    WVOC_N06C_DTStored==WVOC_N06C_AsOfDT AND
    WVOC_N06C_WStored==WVOC_N06C_EW AND
    WVOC_N06C_MStored==WVOC_N06C_EM;

WVOC_N06C_Rebuilt = 0;
WVOC_N06C_Writer = 0;
WVOC_N06C_CommitGeneration = 0;
WVOC_N06C_HeavyMs = 0;

WVOC_N06C_CD_Mult = Null;
WVOC_N06C_CD_Dir = Null;
WVOC_N06C_CD_Evidence = Null;
WVOC_N06C_CD_Phase = Null;
WVOC_N06C_CD_Hyp = Null;
WVOC_N06C_CW_Ord = Null;
WVOC_N06C_CW_Mult = Null;
WVOC_N06C_CW_Dir = Null;
WVOC_N06C_CW_Evidence = Null;
WVOC_N06C_CW_Phase = Null;
WVOC_N06C_CM_Ord = Null;
WVOC_N06C_CM_Mult = Null;
WVOC_N06C_CM_Dir = Null;
WVOC_N06C_CM_Evidence = Null;
WVOC_N06C_CM_Phase = Null;
WVOC_N06C_CMTFValid = 0;
WVOC_N06C_CMTFDir = Null;
WVOC_N06C_CMTFEvidence = Null;
WVOC_N06C_CMTFPhase = Null;
WVOC_N06C_CMTFConflict = Null;
WVOC_N06C_CSelection = Null;

// -----------------------------------------------------------------------------
// COLD MISS: market-only heavy rebuild, same basic shape as N04A.
// -----------------------------------------------------------------------------
if (NOT WVOC_N06C_HitBefore)
{
    GetPerformanceCounter(1);

    WVOC_N06C_ForeignOK = SetForeign(WVOC_N06C_MarketSymbol,1,0);
    WVOC_N06C_DFound = 0;
    WVOC_N06C_WFound = 0;
    WVOC_N06C_MFound = 0;

    if (WVOC_N06C_ForeignOK)
    {
        for (WVOC_N06C_ctx=0; WVOC_N06C_ctx<3; WVOC_N06C_ctx++)
        {
            if (WVOC_N06C_ctx==1) TimeFrameSet(inWeekly);
            if (WVOC_N06C_ctx==2) TimeFrameSet(inMonthly);

            #include <WyckoffVSA_OneClickContextBody_Generated_v0.1.afl>

            if (WVOC_N06C_ctx==0)
            {
                WVOC_N06C_DFound = 1;
                WVOC_N06C_CD_Mult = LastValue(WCI_ContextMultiplicityCode);
                WVOC_N06C_CD_Dir = LastValue(WCI_DirectionalContextCode);
                WVOC_N06C_CD_Evidence = LastValue(WCI_EvidenceBalanceCode);
                WVOC_N06C_CD_Phase = LastValue(WCI_PhaseStateCode);
                WVOC_N06C_CD_Hyp = LastValue(WCI_HypothesisAlignmentCode);
            }

            if (WVOC_N06C_ctx==1)
            {
                WVOC_N06C_W_DTArr = DateTime();
                WVOC_N06C_W_OrdArr =
                    Floor(DateTimeDiff(WVOC_N06C_W_DTArr,WCLK_WeekEpoch)/604800);

                WVOC_N06C_W_idx = -1;
                for (WVOC_N06C_j=BarCount-1; WVOC_N06C_j>=0; WVOC_N06C_j--)
                {
                    if (WVOC_N06C_W_idx<0 AND
                        WVOC_N06C_W_OrdArr[WVOC_N06C_j]==WVOC_N06C_EW)
                        WVOC_N06C_W_idx = WVOC_N06C_j;
                }

                WVOC_N06C_WFound = WVOC_N06C_W_idx>=0;
                WVOC_N06C_W_safe = IIf(WVOC_N06C_WFound,WVOC_N06C_W_idx,0);

                WVOC_N06C_CW_Ord =
                    IIf(WVOC_N06C_WFound,WVOC_N06C_W_OrdArr[WVOC_N06C_W_safe],Null);
                WVOC_N06C_CW_Mult =
                    IIf(WVOC_N06C_WFound,WCI_ContextMultiplicityCode[WVOC_N06C_W_safe],Null);
                WVOC_N06C_CW_Dir =
                    IIf(WVOC_N06C_WFound,WCI_DirectionalContextCode[WVOC_N06C_W_safe],Null);
                WVOC_N06C_CW_Evidence =
                    IIf(WVOC_N06C_WFound,WCI_EvidenceBalanceCode[WVOC_N06C_W_safe],Null);
                WVOC_N06C_CW_Phase =
                    IIf(WVOC_N06C_WFound,WCI_PhaseStateCode[WVOC_N06C_W_safe],Null);
            }

            if (WVOC_N06C_ctx==2)
            {
                WVOC_N06C_M_OrdArr = Year()*12 + Month();

                WVOC_N06C_M_idx = -1;
                for (WVOC_N06C_k=BarCount-1; WVOC_N06C_k>=0; WVOC_N06C_k--)
                {
                    if (WVOC_N06C_M_idx<0 AND
                        WVOC_N06C_M_OrdArr[WVOC_N06C_k]==WVOC_N06C_EM)
                        WVOC_N06C_M_idx = WVOC_N06C_k;
                }

                WVOC_N06C_MFound = WVOC_N06C_M_idx>=0;
                WVOC_N06C_M_safe = IIf(WVOC_N06C_MFound,WVOC_N06C_M_idx,0);

                WVOC_N06C_CM_Ord =
                    IIf(WVOC_N06C_MFound,WVOC_N06C_M_OrdArr[WVOC_N06C_M_safe],Null);
                WVOC_N06C_CM_Mult =
                    IIf(WVOC_N06C_MFound,WCI_ContextMultiplicityCode[WVOC_N06C_M_safe],Null);
                WVOC_N06C_CM_Dir =
                    IIf(WVOC_N06C_MFound,WCI_DirectionalContextCode[WVOC_N06C_M_safe],Null);
                WVOC_N06C_CM_Evidence =
                    IIf(WVOC_N06C_MFound,WCI_EvidenceBalanceCode[WVOC_N06C_M_safe],Null);
                WVOC_N06C_CM_Phase =
                    IIf(WVOC_N06C_MFound,WCI_PhaseStateCode[WVOC_N06C_M_safe],Null);
            }

            if (WVOC_N06C_ctx>0) TimeFrameRestore();
        }
    }

    RestorePriceArrays();

    WVOC_N06C_CMTFValid =
        WVRC_ConfigValid AND
        WVOC_N06C_ForeignOK AND
        WVOC_N06C_DFound AND
        WVOC_N06C_WFound AND
        WVOC_N06C_MFound;

    WVMTF_Run(
        "N06CM",
        WVOC_N06C_CMTFValid,
        WVOC_N06C_CD_Mult,WVOC_N06C_CW_Mult,WVOC_N06C_CM_Mult,
        WVOC_N06C_CD_Dir,WVOC_N06C_CW_Dir,WVOC_N06C_CM_Dir,
        WVOC_N06C_CD_Evidence,WVOC_N06C_CW_Evidence,WVOC_N06C_CM_Evidence,
        WVOC_N06C_CD_Phase,WVOC_N06C_CW_Phase,WVOC_N06C_CM_Phase);

    WVOC_N06C_CMTFDir =
        VarGet("WVMTF_N06CM_DirectionalAlignment");
    WVOC_N06C_CMTFEvidence =
        VarGet("WVMTF_N06CM_EvidenceAlignment");
    WVOC_N06C_CMTFPhase =
        VarGet("WVMTF_N06CM_PhaseRelationship");
    WVOC_N06C_CMTFConflict =
        VarGet("WVMTF_N06CM_ConflictMask");

    WVOC_N06C_CSelection = WVOC_SelectionContext(
        WVOC_N06C_CMTFValid,
        WVOC_N06C_CD_Mult,
        WVOC_N06C_CD_Dir,
        WVOC_N06C_CD_Evidence,
        WVOC_N06C_CD_Hyp,
        WVOC_N06C_CMTFDir);

    WVOC_N06C_HeavyMs = GetPerformanceCounter();

    if (WVOC_N06C_CMTFValid)
    {
        WVOC_N06C_Writer =
            StaticVarCompareExchange(WVOC_N06C_Prefix+"WriterLock",1,0)==0;

        if (WVOC_N06C_Writer)
        {
            StaticVarSet(WVOC_N06C_Prefix+"Ready",0,True);
            StaticVarSet(WVOC_N06C_Prefix+"WriteComplete",0,True);

            StaticVarSet(WVOC_N06C_Prefix+"SchemaMajor",WVOC_N06C_SchemaMajor,True);
            StaticVarSet(WVOC_N06C_Prefix+"SchemaMinor",WVOC_N06C_SchemaMinor,True);
            StaticVarSetText(WVOC_N06C_Prefix+"ContractVersion",WVOC_N06C_ContractVersion,True);
            StaticVarSetText(WVOC_N06C_Prefix+"AlgorithmVersion",WVOC_N06C_AlgorithmVersion,True);
            StaticVarSetText(WVOC_N06C_Prefix+"Role","MARKET",True);
            StaticVarSetText(WVOC_N06C_Prefix+"Symbol",WVOC_N06C_MarketSymbol,True);
            StaticVarSetText(WVOC_N06C_Prefix+"ConfigFingerprint",WVOC_N06C_Fingerprint,True);

            StaticVarSet(WVOC_N06C_Prefix+"AsOfDateNum",WVOC_N06C_AsOfDN,True);
            StaticVarSet(WVOC_N06C_Prefix+"AsOfDateTime",WVOC_N06C_AsOfDT,True);
            StaticVarSet(WVOC_N06C_Prefix+"CompletedWeeklyOrdinal",WVOC_N06C_EW,True);
            StaticVarSet(WVOC_N06C_Prefix+"CompletedMonthlyOrdinal",WVOC_N06C_EM,True);

            StaticVarSet(WVOC_N06C_Prefix+"D_Multiplicity",WVOC_N06C_CD_Mult,True);
            StaticVarSet(WVOC_N06C_Prefix+"D_Directional",WVOC_N06C_CD_Dir,True);
            StaticVarSet(WVOC_N06C_Prefix+"D_Evidence",WVOC_N06C_CD_Evidence,True);
            StaticVarSet(WVOC_N06C_Prefix+"D_Phase",WVOC_N06C_CD_Phase,True);
            StaticVarSet(WVOC_N06C_Prefix+"D_HypothesisAlignment",WVOC_N06C_CD_Hyp,True);

            StaticVarSet(WVOC_N06C_Prefix+"W_Ordinal",WVOC_N06C_CW_Ord,True);
            StaticVarSet(WVOC_N06C_Prefix+"W_Directional",WVOC_N06C_CW_Dir,True);
            StaticVarSet(WVOC_N06C_Prefix+"M_Ordinal",WVOC_N06C_CM_Ord,True);
            StaticVarSet(WVOC_N06C_Prefix+"M_Directional",WVOC_N06C_CM_Dir,True);

            StaticVarSet(WVOC_N06C_Prefix+"MTF_Valid",WVOC_N06C_CMTFValid,True);
            StaticVarSet(WVOC_N06C_Prefix+"MTF_Directional",WVOC_N06C_CMTFDir,True);
            StaticVarSet(WVOC_N06C_Prefix+"MTF_Evidence",WVOC_N06C_CMTFEvidence,True);
            StaticVarSet(WVOC_N06C_Prefix+"MTF_Phase",WVOC_N06C_CMTFPhase,True);
            StaticVarSet(WVOC_N06C_Prefix+"MTF_ConflictMask",WVOC_N06C_CMTFConflict,True);
            StaticVarSet(WVOC_N06C_Prefix+"SelectionContext",WVOC_N06C_CSelection,True);

            WVOC_N06C_PreviousGeneration =
                Nz(StaticVarGet(WVOC_N06C_Prefix+"CommittedGenerationID"),0);
            WVOC_N06C_CommitGeneration = WVOC_N06C_PreviousGeneration+1;

            StaticVarSet(
                WVOC_N06C_Prefix+"CommittedGenerationID",
                WVOC_N06C_CommitGeneration,True);
            StaticVarSet(WVOC_N06C_Prefix+"WriteComplete",1,True);
            StaticVarSet(WVOC_N06C_Prefix+"Ready",1,True);
            StaticVarSet(WVOC_N06C_Prefix+"WriterLock",0);

            WVOC_N06C_Rebuilt = 1;
        }
    }
}

// -----------------------------------------------------------------------------
// Stable read.
// -----------------------------------------------------------------------------
WVOC_N06C_GenA =
    Nz(StaticVarGet(WVOC_N06C_Prefix+"CommittedGenerationID"),0);

WVOC_N06C_R_DMult = StaticVarGet(WVOC_N06C_Prefix+"D_Multiplicity");
WVOC_N06C_R_DDir = StaticVarGet(WVOC_N06C_Prefix+"D_Directional");
WVOC_N06C_R_DEvidence = StaticVarGet(WVOC_N06C_Prefix+"D_Evidence");
WVOC_N06C_R_DPhase = StaticVarGet(WVOC_N06C_Prefix+"D_Phase");
WVOC_N06C_R_DHyp = StaticVarGet(WVOC_N06C_Prefix+"D_HypothesisAlignment");
WVOC_N06C_R_WOrd = StaticVarGet(WVOC_N06C_Prefix+"W_Ordinal");
WVOC_N06C_R_WDir = StaticVarGet(WVOC_N06C_Prefix+"W_Directional");
WVOC_N06C_R_MOrd = StaticVarGet(WVOC_N06C_Prefix+"M_Ordinal");
WVOC_N06C_R_MDir = StaticVarGet(WVOC_N06C_Prefix+"M_Directional");
WVOC_N06C_R_MTFValid = StaticVarGet(WVOC_N06C_Prefix+"MTF_Valid");
WVOC_N06C_R_MTFDir = StaticVarGet(WVOC_N06C_Prefix+"MTF_Directional");
WVOC_N06C_R_MTFEvidence = StaticVarGet(WVOC_N06C_Prefix+"MTF_Evidence");
WVOC_N06C_R_MTFPhase = StaticVarGet(WVOC_N06C_Prefix+"MTF_Phase");
WVOC_N06C_R_MTFConflict = StaticVarGet(WVOC_N06C_Prefix+"MTF_ConflictMask");
WVOC_N06C_R_Selection = StaticVarGet(WVOC_N06C_Prefix+"SelectionContext");

WVOC_N06C_GenB =
    Nz(StaticVarGet(WVOC_N06C_Prefix+"CommittedGenerationID"),0);

WVOC_N06C_MetadataAfter =
    Nz(StaticVarGet(WVOC_N06C_Prefix+"Ready"),0)==1 AND
    Nz(StaticVarGet(WVOC_N06C_Prefix+"WriteComplete"),0)==1 AND
    WVOC_N06C_GenB>0 AND
    Nz(StaticVarGet(WVOC_N06C_Prefix+"SchemaMajor"),-1)==WVOC_N06C_SchemaMajor AND
    Nz(StaticVarGet(WVOC_N06C_Prefix+"SchemaMinor"),-1)==WVOC_N06C_SchemaMinor AND
    StaticVarGetText(WVOC_N06C_Prefix+"Role")=="MARKET" AND
    StaticVarGetText(WVOC_N06C_Prefix+"Symbol")==WVOC_N06C_MarketSymbol AND
    StaticVarGetText(WVOC_N06C_Prefix+"ConfigFingerprint")==WVOC_N06C_Fingerprint AND
    StaticVarGet(WVOC_N06C_Prefix+"AsOfDateNum")==WVOC_N06C_AsOfDN AND
    StaticVarGet(WVOC_N06C_Prefix+"AsOfDateTime")==WVOC_N06C_AsOfDT AND
    StaticVarGet(WVOC_N06C_Prefix+"CompletedWeeklyOrdinal")==WVOC_N06C_EW AND
    StaticVarGet(WVOC_N06C_Prefix+"CompletedMonthlyOrdinal")==WVOC_N06C_EM;

WVOC_N06C_StableRead =
    WVOC_N06C_MetadataAfter AND
    WVOC_N06C_GenA==WVOC_N06C_GenB;

WVOC_N06C_RebuildExact =
    IIf(
        WVOC_N06C_Rebuilt,
        WVOC_N06C_R_DMult==WVOC_N06C_CD_Mult AND
        WVOC_N06C_R_DDir==WVOC_N06C_CD_Dir AND
        WVOC_N06C_R_DEvidence==WVOC_N06C_CD_Evidence AND
        WVOC_N06C_R_DPhase==WVOC_N06C_CD_Phase AND
        WVOC_N06C_R_DHyp==WVOC_N06C_CD_Hyp AND
        WVOC_N06C_R_WOrd==WVOC_N06C_CW_Ord AND
        WVOC_N06C_R_WDir==WVOC_N06C_CW_Dir AND
        WVOC_N06C_R_MOrd==WVOC_N06C_CM_Ord AND
        WVOC_N06C_R_MDir==WVOC_N06C_CM_Dir AND
        WVOC_N06C_R_MTFValid==WVOC_N06C_CMTFValid AND
        WVOC_N06C_R_MTFDir==WVOC_N06C_CMTFDir AND
        WVOC_N06C_R_MTFEvidence==WVOC_N06C_CMTFEvidence AND
        WVOC_N06C_R_MTFPhase==WVOC_N06C_CMTFPhase AND
        WVOC_N06C_R_MTFConflict==WVOC_N06C_CMTFConflict AND
        WVOC_N06C_R_Selection==WVOC_N06C_CSelection,
        1);

WVOC_N06C_AllPass =
    WVOC_N06C_StableRead AND
    WVOC_N06C_RebuildExact AND
    WVOC_N06C_R_WOrd==WVOC_N06C_EW AND
    WVOC_N06C_R_MOrd==WVOC_N06C_EM;

Filter = BarIndex()==LastValue(BarIndex());

AddTextColumn(Name(),"Symbol");
AddColumn(DateTime(),"As-Of",formatDateTime);
AddTextColumn(WVOC_N06C_MarketSymbol,"Market");

AddColumn(0*BarIndex()+WVOC_N06C_HitBefore,"Cache Hit Before",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_Rebuilt,"Rebuilt",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_Writer,"Writer Acquired",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_CommitGeneration,"Commit Generation",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_GenA,"Generation A",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_GenB,"Generation B",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_StableRead,"Stable Read",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_RebuildExact,"Rebuild Exact",1.0);

AddColumn(0*BarIndex()+WVOC_N06C_R_DMult,"D Mult",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_DDir,"D Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_DEvidence,"D Evidence",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_DPhase,"D Phase",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_DHyp,"D Hyp",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_WOrd,"W Ord",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_WDir,"W Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MOrd,"M Ord",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MDir,"M Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MTFValid,"MTF Valid",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MTFDir,"MTF Dir",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MTFEvidence,"MTF Evidence",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MTFPhase,"MTF Phase",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_MTFConflict,"MTF Conflict",1.0);
AddColumn(0*BarIndex()+WVOC_N06C_R_Selection,"Market Selection",1.0);

AddColumn(0*BarIndex()+WVOC_N06C_HeavyMs,"Heavy Runtime ms",1.3);
AddColumn(0*BarIndex()+WVOC_N06C_AllPass,"ALL PASS",1.0);
AddTextColumn("ONE_CLICK_N06C_FUNCTION_FREE_MARKET_CACHE_V01_20260918_A","Probe Version");
