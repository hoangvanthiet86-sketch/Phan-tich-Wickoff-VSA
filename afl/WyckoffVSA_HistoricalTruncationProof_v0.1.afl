/*
    Wyckoff VSA Historical Scanner v0.1
    H5-B truncation invariance proof.

    Cach kiem:
    1. Doc baseline historical stock timeline da PASS H4.
    2. Cat input OHLCV sau moc T thanh Null TRUOC KHI chay lai causal runtime.
    3. Tai dung W/M historical completed-period va H3 Market context tai T.
    4. Tai dung decision semantics H4 va so sanh baseline vs truncated tai T.

    Day la future-masked range truncation proof: tuong lai van ton tai ve so luong
    bar nhung khong con du lieu gia/khoi luong. H1 static audit da loai cac duong
    current-snapshot/future-state khoi canonical stock path. Khong trading signal.

    UI moi dung tieng Viet khong dau.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);

function H5T_Finite(x)
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

function H5T_Eq(a,b)
{
    return IIf(IsNull(a) AND IsNull(b),1,
           IIf(NOT IsNull(a) AND NOT IsNull(b) AND a==b,1,0));
}

function H5T_EqTol(a,b,tol)
{
    return IIf(IsNull(a) AND IsNull(b),1,
           IIf(NOT IsNull(a) AND NOT IsNull(b) AND abs(a-b)<=tol,1,0));
}

function H5T_SelectionContext(valid,multiplicity,directional,evidence,hypAlign,mtfAlign)
{
    local mixed,bullish,bearish;
    mixed = multiplicity==2 OR directional==4 OR evidence==3 OR hypAlign==3 OR
            mtfAlign==4 OR mtfAlign==5 OR mtfAlign==6;
    bullish = directional==2 AND mtfAlign==2 AND evidence!=2 AND evidence!=3 AND hypAlign!=3;
    bearish = directional==3 AND mtfAlign==3 AND evidence!=1 AND evidence!=3 AND hypAlign!=3;
    return IIf(NOT valid,0,IIf(mixed,4,IIf(bullish,2,IIf(bearish,3,1))));
}

function H5T_StageFromPhase(phaseCode)
{
    return IIf(phaseCode==1 OR phaseCode==2,1,
           IIf(phaseCode==3 OR phaseCode==4,2,
           IIf(phaseCode==5,3,
           IIf(phaseCode==6,4,
           IIf(phaseCode==7,5,0)))));
}

function H5T_Review(dataEligible,mult,priceRS,evidence,hypAlign,mtfDir,rsStruct,marketSel,stockDir,roleConflict,rangeConflict)
{
    local priceBad,vsaBad,mtfBad,rsMixed,multi,mktStockBad;
    priceBad = priceRS==2 OR priceRS==3;
    vsaBad = evidence==3 OR hypAlign==3;
    mtfBad = mtfDir==4 OR mtfDir==5 OR mtfDir==6;
    rsMixed = rsStruct==3;
    multi = mult==2;
    mktStockBad = (marketSel==2 AND stockDir==3) OR (marketSel==3 AND stockDir==2);
    return dataEligible AND (multi OR priceBad OR vsaBad OR mtfBad OR rsMixed OR
           mktStockBad OR roleConflict OR rangeConflict==1);
}

function H5T_MethodBlock(marketSel,stage,stockDir,mtfDir,rsStruct,evidence,hypAlign,priceRS,mult,roleConflict,marketConfigMatch,rangeConflict)
{
    local phaseEarly,dirUnresolved,mtfBad,rsBad,vsaBad,priceBad;
    phaseEarly = stage==0 OR stage==1;
    dirUnresolved = stockDir!=2 AND stockDir!=3;
    mtfBad = mtfDir==4 OR mtfDir==5 OR mtfDir==6;
    rsBad = rsStruct==0 OR rsStruct==3;
    vsaBad = evidence==3 OR hypAlign==3;
    priceBad = priceRS==2 OR priceRS==3;
    return
          IIf(marketSel==0 OR marketSel==1 OR marketSel==4,1,0)
        + IIf(phaseEarly,2,0)
        + IIf(dirUnresolved,4,0)
        + IIf(mtfBad,8,0)
        + IIf(rsBad,16,0)
        + IIf(vsaBad,32,0)
        + IIf(priceBad,64,0)
        + 0
        + IIf(mult==2,256,0)
        + IIf(roleConflict OR NOT marketConfigMatch,512,0)
        + IIf(rangeConflict==1,1024,0);
}

function H5T_Classify(dataEligible,review,marketSel,stockDir,stage,mtfDir,rsStruct,evidence,hypAlign,priceRS,mult,rangeCoherent)
{
    local bullEvidence,bearEvidence,priceBad,bullQ,bearQ,bullDev,bearDev,watch;
    bullEvidence = evidence!=2 AND evidence!=3 AND hypAlign!=3;
    bearEvidence = evidence!=1 AND evidence!=3 AND hypAlign!=3;
    priceBad = priceRS==2 OR priceRS==3;
    bullQ = dataEligible AND NOT review AND marketSel==2 AND stockDir==2 AND
            (stage==3 OR stage==4) AND mtfDir==2 AND rsStruct==1 AND
            bullEvidence AND NOT priceBad AND mult==1;
    bearQ = dataEligible AND NOT review AND marketSel==3 AND stockDir==3 AND
            (stage==3 OR stage==4) AND mtfDir==3 AND rsStruct==2 AND
            bearEvidence AND NOT priceBad AND mult==1;
    bullDev = dataEligible AND NOT review AND stage==2 AND marketSel==2 AND stockDir==2 AND
              rsStruct==1 AND bullEvidence AND (mtfDir==1 OR mtfDir==2);
    bearDev = dataEligible AND NOT review AND stage==2 AND marketSel==3 AND stockDir==3 AND
              rsStruct==2 AND bearEvidence AND (mtfDir==1 OR mtfDir==3);
    watch = dataEligible AND NOT review AND stage==1 AND rangeCoherent==1 AND
            (rsStruct==1 OR rsStruct==2);
    return IIf(NOT dataEligible,0,
           IIf(review,9,
           IIf(bullQ,4,
           IIf(bearQ,7,
           IIf(bullDev,3,
           IIf(bearDev,6,
           IIf(watch,2,1)))))));
}

function H5T_Side(candidateClass,stockDir,rsStruct)
{
    return IIf(candidateClass==3 OR candidateClass==4,1,
           IIf(candidateClass==6 OR candidateClass==7,2,
           IIf(candidateClass==2 AND stockDir==2 AND rsStruct==1,1,
           IIf(candidateClass==2 AND stockDir==3 AND rsStruct==2,2,0))));
}

_SECTION_BEGIN("01. CHON MOC CAT DU LIEU");
H5T_CutChoice = ParamList(
    "1.1 Moc cat du lieu",
    "2019-08-30|2022-01-28|2024-06-28",0);
H5T_CutDN = 1190830;
if (H5T_CutChoice=="2022-01-28") H5T_CutDN = 1220128;
if (H5T_CutChoice=="2024-06-28") H5T_CutDN = 1240628;

H5T_Symbol = Name();
H5T_DT = DateTime();
H5T_DN = DateNum();
H5T_BI = BarIndex();
H5T_Zero = 0*H5T_BI;
H5T_CutRow = H5T_DN==H5T_CutDN;
H5T_Keep = H5T_DN<=H5T_CutDN;
H5T_CutRowCount = LastValue(Cum(H5T_CutRow));
H5T_FutureBarCount = LastValue(Cum(H5T_DN>H5T_CutDN));
_SECTION_END();

_SECTION_BEGIN("02. DOC BASELINE H4 TRUOC KHI CAT");
H5T_BPrefix = "WVSA_HIST_STOCK_v01_"+H5T_Symbol+"_";
H5T_BReady = Nz(StaticVarGet(H5T_BPrefix+"Ready"),0)==1 AND
              Nz(StaticVarGet(H5T_BPrefix+"CommittedGenerationID"),0)>0 AND
              StaticVarGetText(H5T_BPrefix+"Symbol")==H5T_Symbol;
H5T_BSourceKey = StaticVarGet(H5T_BPrefix+"SourceBusinessDateKey");
H5T_BSourceDT = StaticVarGet(H5T_BPrefix+"SourceBarDateTime");
H5T_BSourceValid = StaticVarGet(H5T_BPrefix+"SourceValid");
H5T_BSchemaValid = StaticVarGet(H5T_BPrefix+"StockSchemaValid");
H5T_BProvisional = StaticVarGet(H5T_BPrefix+"ProvisionalFlag");
H5T_BClose = StaticVarGet(H5T_BPrefix+"Close");
H5T_BRSMarketSymbol = StaticVarGetText(H5T_BPrefix+"RSMarketSymbol");
H5T_BMult = StaticVarGet(H5T_BPrefix+"ContextMultiplicityCode");
H5T_BDir = StaticVarGet(H5T_BPrefix+"DirectionalContextCode");
H5T_BPhase = StaticVarGet(H5T_BPrefix+"PhaseStateCode");
H5T_BFamily = StaticVarGet(H5T_BPrefix+"FamilyHypothesisCode");
H5T_BEvidence = StaticVarGet(H5T_BPrefix+"EvidenceBalanceCode");
H5T_BHypAlign = StaticVarGet(H5T_BPrefix+"HypothesisAlignmentCode");
H5T_BRangePos = StaticVarGet(H5T_BPrefix+"RangePosition");
H5T_BRangeCoherent = StaticVarGet(H5T_BPrefix+"RangeLocationCoherent");
H5T_BRangeConflict = StaticVarGet(H5T_BPrefix+"RangeLocationConflict");
H5T_BMTFValid = StaticVarGet(H5T_BPrefix+"MTFContractValid");
H5T_BMTFDir = StaticVarGet(H5T_BPrefix+"MTFDirectionalAlignmentCode");
H5T_BRSValid = StaticVarGet(H5T_BPrefix+"RSContextValid");
H5T_BRSMarketStatus = StaticVarGet(H5T_BPrefix+"RSMarketBenchmarkStatusCode");
H5T_BRSStruct = StaticVarGet(H5T_BPrefix+"RSStockVsMarketStructureCode");
H5T_BPriceRS = StaticVarGet(H5T_BPrefix+"RSPriceRelationshipCode");
H5T_BExact = H5T_BReady AND NOT IsNull(H5T_BSourceKey) AND NOT IsNull(H5T_BSourceDT) AND
              H5T_BSourceKey==H5T_DN AND H5T_BSourceDT==H5T_DT AND H5T_BSourceDT<=H5T_DT;
_SECTION_END();

_SECTION_BEGIN("03. CAT FUTURE OHLCV");
H5T_RawO = Open;
H5T_RawH = High;
H5T_RawL = Low;
H5T_RawC = Close;
H5T_RawV = Volume;
Open = IIf(H5T_Keep,H5T_RawO,Null);
High = IIf(H5T_Keep,H5T_RawH,Null);
Low = IIf(H5T_Keep,H5T_RawL,Null);
Close = IIf(H5T_Keep,H5T_RawC,Null);
Volume = IIf(H5T_Keep,H5T_RawV,Null);
_SECTION_END();

#include_once <WyckoffVSA_HistoricalRuntimeDefaults_v0.1.afl>
#include_once <WyckoffVSA_Core_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Candidate_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructureLocation_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Confirmation_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_StoppingClimacticAbsorption_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SupplyTest_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SpringShakeout_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_UpthrustUTAD_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SOSLPS_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructuralSequence_PhaseA_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructuralSequence_PhaseA_Snapshot_Runtime_v0.2.afl>
#include_once <WyckoffVSA_RangeContext_SOWLPSY_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_InputFacade_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_PublicSnapshot_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_ConsumerFacade_Runtime_v0.2.afl>
#include_once <WyckoffVSA_CompositeIndicator_Runtime_v0.2.afl>
#include_once <WyckoffVSA_DerivedSeriesPivotKernel_v0.1.afl>

_SECTION_BEGIN("04. TAI DUNG MTF TAI MOC CAT");
H5T_WeekEpoch = _DT("2000-01-03 00:00:00");
H5T_CurrentWOrd = Floor(DateTimeDiff(H5T_DT,H5T_WeekEpoch)/604800);
H5T_ExpectedWOrd = H5T_CurrentWOrd-1;
H5T_YearOffset = Floor(H5T_DN/10000);
H5T_Year = 1900+H5T_YearOffset;
H5T_Rem = H5T_DN-10000*H5T_YearOffset;
H5T_Month = Floor(H5T_Rem/100);
H5T_CurrentMOrd = H5T_Year*12+H5T_Month;
H5T_ExpectedMOrd = H5T_CurrentMOrd-1;
H5T_HasPrior = H5T_BI>0;
H5T_WRollover = H5T_HasPrior AND H5T_CurrentWOrd!=Ref(H5T_CurrentWOrd,-1);
H5T_MRollover = H5T_HasPrior AND H5T_CurrentMOrd!=Ref(H5T_CurrentMOrd,-1);
H5T_WPrefix = "WVSA_HIST_MTF_v01_"+H5T_Symbol+"_W_";
H5T_MPrefix = "WVSA_HIST_MTF_v01_"+H5T_Symbol+"_M_";
H5T_WReady = Nz(StaticVarGet(H5T_WPrefix+"Ready"),0)==1;
H5T_MReady = Nz(StaticVarGet(H5T_MPrefix+"Ready"),0)==1;
H5T_WRawValid = StaticVarGet(H5T_WPrefix+"SourceValid");
H5T_MRawValid = StaticVarGet(H5T_MPrefix+"SourceValid");
H5T_WRawOrd = StaticVarGet(H5T_WPrefix+"SourcePeriodOrdinal");
H5T_MRawOrd = StaticVarGet(H5T_MPrefix+"SourcePeriodOrdinal");
H5T_WRawDT = StaticVarGet(H5T_WPrefix+"SourceBarDateTime");
H5T_MRawDT = StaticVarGet(H5T_MPrefix+"SourceBarDateTime");
H5T_WRawMult = StaticVarGet(H5T_WPrefix+"ContextMultiplicityCode");
H5T_MRawMult = StaticVarGet(H5T_MPrefix+"ContextMultiplicityCode");
H5T_WRawDir = StaticVarGet(H5T_WPrefix+"DirectionalContextCode");
H5T_MRawDir = StaticVarGet(H5T_MPrefix+"DirectionalContextCode");
H5T_WSeen = H5T_WReady AND H5T_WRawValid==1 AND NOT IsNull(H5T_WRawOrd);
H5T_MSeen = H5T_MReady AND H5T_MRawValid==1 AND NOT IsNull(H5T_MRawOrd);
H5T_WLastOrd = ValueWhen(H5T_WSeen,H5T_WRawOrd);
H5T_MLastOrd = ValueWhen(H5T_MSeen,H5T_MRawOrd);
H5T_WLastDT = ValueWhen(H5T_WSeen,H5T_WRawDT);
H5T_MLastDT = ValueWhen(H5T_MSeen,H5T_MRawDT);
H5T_WLastMult = ValueWhen(H5T_WSeen,H5T_WRawMult);
H5T_MLastMult = ValueWhen(H5T_MSeen,H5T_MRawMult);
H5T_WLastDir = ValueWhen(H5T_WSeen,H5T_WRawDir);
H5T_MLastDir = ValueWhen(H5T_MSeen,H5T_MRawDir);
H5T_WCandOrd = Ref(H5T_WLastOrd,-1);
H5T_MCandOrd = Ref(H5T_MLastOrd,-1);
H5T_WCandDT = Ref(H5T_WLastDT,-1);
H5T_MCandDT = Ref(H5T_MLastDT,-1);
H5T_WCandMult = Ref(H5T_WLastMult,-1);
H5T_MCandMult = Ref(H5T_MLastMult,-1);
H5T_WCandDir = Ref(H5T_WLastDir,-1);
H5T_MCandDir = Ref(H5T_MLastDir,-1);
H5T_WAccept = H5T_WRollover AND H5T_WReady AND NOT IsNull(H5T_WCandOrd) AND
               H5T_WCandOrd==H5T_ExpectedWOrd AND H5T_WCandDT<H5T_DT;
H5T_MAccept = H5T_MRollover AND H5T_MReady AND NOT IsNull(H5T_MCandOrd) AND
               H5T_MCandOrd==H5T_ExpectedMOrd AND H5T_MCandDT<H5T_DT;
H5T_WSelOrd = ValueWhen(H5T_WAccept,H5T_WCandOrd);
H5T_MSelOrd = ValueWhen(H5T_MAccept,H5T_MCandOrd);
H5T_WSelDT = ValueWhen(H5T_WAccept,H5T_WCandDT);
H5T_MSelDT = ValueWhen(H5T_MAccept,H5T_MCandDT);
H5T_WMult = ValueWhen(H5T_WAccept,H5T_WCandMult);
H5T_MMult = ValueWhen(H5T_MAccept,H5T_MCandMult);
H5T_WDir = ValueWhen(H5T_WAccept,H5T_WCandDir);
H5T_MDir = ValueWhen(H5T_MAccept,H5T_MCandDir);
H5T_WValid = H5T_WReady AND NOT IsNull(H5T_WSelOrd) AND H5T_WSelOrd==H5T_ExpectedWOrd AND H5T_WSelDT<H5T_DT;
H5T_MValid = H5T_MReady AND NOT IsNull(H5T_MSelOrd) AND H5T_MSelOrd==H5T_ExpectedMOrd AND H5T_MSelDT<H5T_DT;
H5T_MTFValid = Interval()==inDaily AND WCI_ProvisionalFlag==0 AND H5T_WValid AND H5T_MValid;
H5T_DMult = WCI_ContextMultiplicityCode;
H5T_DDir = WCI_DirectionalContextCode;
H5T_AnyMulti = H5T_DMult==2 OR H5T_WMult==2 OR H5T_MMult==2;
H5T_AnyMixed = H5T_DDir==4 OR H5T_WDir==4 OR H5T_MDir==4;
H5T_WMDir = (H5T_WDir==2 OR H5T_WDir==3) AND (H5T_MDir==2 OR H5T_MDir==3);
H5T_WMSame = H5T_WMDir AND H5T_WDir==H5T_MDir;
H5T_WMOpp = H5T_WMDir AND H5T_WDir!=H5T_MDir;
H5T_DDirectional = H5T_DDir==2 OR H5T_DDir==3;
H5T_MTFDir = IIf(
    NOT H5T_MTFValid,0,
    IIf(H5T_AnyMulti OR H5T_AnyMixed,6,
    IIf(H5T_WMOpp,5,
    IIf(H5T_WMSame AND H5T_DDirectional AND H5T_DDir!=H5T_WDir,4,
    IIf(H5T_DDir==2 AND H5T_WDir==2 AND H5T_MDir==2,2,
    IIf(H5T_DDir==3 AND H5T_WDir==3 AND H5T_MDir==3,3,
    IIf(H5T_DDir==0 OR H5T_WDir==0 OR H5T_MDir==0,0,
    IIf(H5T_DDir==1 OR H5T_WDir==1 OR H5T_MDir==1,1,6))))))));
_SECTION_END();

_SECTION_BEGIN("05. TAI DUNG RS TAI MOC CAT");
H5T_RSMarketSymbol = WVRC_RSMarketSymbol;
H5T_RSMarketConfigured = StrLen(H5T_RSMarketSymbol)>0;
H5T_RSMarketClose = Null+0*H5T_BI;
if (H5T_RSMarketConfigured)
{
    H5T_RSMarketClose = Foreign(H5T_RSMarketSymbol,"C",0);
}
H5T_StockCloseValid = H5T_Finite(Close) AND Close>0;
H5T_RSMarketStatus = IIf(NOT H5T_RSMarketConfigured,0,
    IIf(IsNull(H5T_RSMarketClose),1,
    IIf(NOT H5T_Finite(H5T_RSMarketClose) OR H5T_RSMarketClose<=0,2,3)));
H5T_RSMarketCloseValid = H5T_RSMarketStatus==3;
H5T_RatioValid = H5T_StockCloseValid AND H5T_RSMarketCloseValid;
H5T_Ratio = IIf(H5T_RatioValid,Close/H5T_RSMarketClose,Null);
H5T_RSKernel = WDP_RunDerivedSeries(
    "H5T_SVM",H5T_Ratio,H5T_RatioValid,
    WVRC_PivotLeft,WVRC_PivotRight,H5T_BI,H5T_DT,Cum(1)-1);
H5T_RSHiCode = VarGet("WDP_H5T_SVM_PivotHighEventCode");
H5T_RSLoCode = VarGet("WDP_H5T_SVM_PivotLowEventCode");
H5T_RSHiValue = VarGet("WDP_H5T_SVM_PivotHighEventValue");
H5T_RSLoValue = VarGet("WDP_H5T_SVM_PivotLowEventValue");
H5T_RSHiCount = Cum(H5T_RSHiCode==2);
H5T_RSLoCount = Cum(H5T_RSLoCode==2);
H5T_RSHi1 = ValueWhen(H5T_RSHiCode==2,H5T_RSHiValue,1);
H5T_RSHi2 = ValueWhen(H5T_RSHiCode==2,H5T_RSHiValue,2);
H5T_RSLo1 = ValueWhen(H5T_RSLoCode==2,H5T_RSLoValue,1);
H5T_RSLo2 = ValueWhen(H5T_RSLoCode==2,H5T_RSLoValue,2);
H5T_RSStructValid = H5T_RSHiCount>=2 AND H5T_RSLoCount>=2;
H5T_RSStruct = IIf(NOT H5T_RSStructValid,0,
    IIf(H5T_RSHi1>H5T_RSHi2 AND H5T_RSLo1>H5T_RSLo2,1,
    IIf(H5T_RSHi1<H5T_RSHi2 AND H5T_RSLo1<H5T_RSLo2,2,3)));
H5T_PriceHiCount = Cum(SL_PivotHighEventCode==2);
H5T_PriceLoCount = Cum(SL_PivotLowEventCode==2);
H5T_PriceHi1 = ValueWhen(SL_PivotHighEventCode==2,SL_PivotHighEventPrice,1);
H5T_PriceHi2 = ValueWhen(SL_PivotHighEventCode==2,SL_PivotHighEventPrice,2);
H5T_PriceLo1 = ValueWhen(SL_PivotLowEventCode==2,SL_PivotLowEventPrice,1);
H5T_PriceLo2 = ValueWhen(SL_PivotLowEventCode==2,SL_PivotLowEventPrice,2);
H5T_PriceStructValid = H5T_PriceHiCount>=2 AND H5T_PriceLoCount>=2;
H5T_PriceStruct = IIf(NOT H5T_PriceStructValid,0,
    IIf(H5T_PriceHi1>H5T_PriceHi2 AND H5T_PriceLo1>H5T_PriceLo2,1,
    IIf(H5T_PriceHi1<H5T_PriceHi2 AND H5T_PriceLo1<H5T_PriceLo2,2,3)));
H5T_PriceRS = IIf(NOT H5T_PriceStructValid OR H5T_RSStruct==0,0,
    IIf(H5T_PriceStruct==1 AND H5T_RSStruct==1,1,
    IIf(H5T_PriceStruct==1 AND H5T_RSStruct==2,2,
    IIf(H5T_PriceStruct==2 AND H5T_RSStruct==1,3,
    IIf(H5T_PriceStruct==2 AND H5T_RSStruct==2,4,5)))));
H5T_RSPivotValid = NOT IsNull(SL_PivotConfigValid) AND SL_PivotConfigValid==1;
H5T_RSContextValid = Interval()==inDaily AND H5T_RSPivotValid AND H5T_RatioValid AND
                     WVRC_RSAdjustmentBasisStatus==1;
_SECTION_END();

_SECTION_BEGIN("06. RANGE VA MARKET CONTEXT");
H5T_Stage = H5T_StageFromPhase(WCI_PhaseStateCode);
H5T_SingleLower = WCI_ContextMultiplicityCode==1 AND WPC_L_ContextPresent==1 AND WPC_U_ContextPresent!=1;
H5T_SingleUpper = WCI_ContextMultiplicityCode==1 AND WPC_U_ContextPresent==1 AND WPC_L_ContextPresent!=1;
H5T_RangeStatus = IIf(H5T_SingleLower,WPCP_L_RangeStatusCode,
                   IIf(H5T_SingleUpper,WPCP_U_RangeStatusCode,0));
H5T_RangePos = IIf(H5T_SingleLower,WPC_L_RangePosition,
                IIf(H5T_SingleUpper,WPC_U_RangePosition,Null));
H5T_RangePosValid = IIf(H5T_SingleLower,WPC_L_RangePositionValid,
                     IIf(H5T_SingleUpper,WPC_U_RangePositionValid,0));
H5T_RangeUsable = WCI_ContextMultiplicityCode==1 AND H5T_RangeStatus==1 AND
                   H5T_RangePosValid==1 AND H5T_Finite(H5T_RangePos);
H5T_RangeConflict = H5T_Stage==1 AND H5T_RangeUsable AND
                     (H5T_RangePos<0 OR H5T_RangePos>1);
H5T_RangeCoherent = H5T_Stage!=1 OR
                     (H5T_RangeUsable AND H5T_RangePos>=0 AND H5T_RangePos<=1);

H5T_MarketPrefix = "WVSA_HIST_MKT_v01_"+WVRC_SelectionMarketSymbol+"_";
H5T_MarketReady = Nz(StaticVarGet(H5T_MarketPrefix+"Ready"),0)==1 AND
                    Nz(StaticVarGet(H5T_MarketPrefix+"CommittedGenerationID"),0)>0 AND
                    StaticVarGetText(H5T_MarketPrefix+"Symbol")==WVRC_SelectionMarketSymbol;
H5T_MarketKey = StaticVarGet(H5T_MarketPrefix+"SourceBusinessDateKey");
H5T_MarketDT = StaticVarGet(H5T_MarketPrefix+"SourceBarDateTime");
H5T_MarketValid = StaticVarGet(H5T_MarketPrefix+"SourceValid");
H5T_MarketMult = StaticVarGet(H5T_MarketPrefix+"ContextMultiplicityCode");
H5T_MarketDir = StaticVarGet(H5T_MarketPrefix+"DirectionalContextCode");
H5T_MarketEvidence = StaticVarGet(H5T_MarketPrefix+"EvidenceBalanceCode");
H5T_MarketHyp = StaticVarGet(H5T_MarketPrefix+"HypothesisAlignmentCode");
H5T_MarketPhase = StaticVarGet(H5T_MarketPrefix+"PhaseStateCode");
H5T_MarketStructural = StaticVarGet(H5T_MarketPrefix+"StructuralDevelopmentCode");
H5T_MarketMTFDir = StaticVarGet(H5T_MarketPrefix+"MTFDirectionalAlignmentCode");
H5T_MarketMTFEvidence = StaticVarGet(H5T_MarketPrefix+"MTFEvidenceAlignmentCode");
H5T_MarketMTFPhase = StaticVarGet(H5T_MarketPrefix+"MTFPhaseRelationshipCode");
H5T_MarketMTFConflict = StaticVarGet(H5T_MarketPrefix+"MTFConflictReasonCode");
H5T_MarketExact = H5T_MarketReady AND NOT IsNull(H5T_MarketKey) AND NOT IsNull(H5T_MarketDT) AND
                   H5T_MarketKey==H5T_DN AND H5T_MarketDT==H5T_DT AND H5T_MarketDT<=H5T_DT;
H5T_MarketPayload = NOT IsNull(H5T_MarketMult) AND NOT IsNull(H5T_MarketDir) AND
                     NOT IsNull(H5T_MarketEvidence) AND NOT IsNull(H5T_MarketHyp) AND
                     NOT IsNull(H5T_MarketPhase) AND NOT IsNull(H5T_MarketStructural) AND
                     NOT IsNull(H5T_MarketMTFDir) AND NOT IsNull(H5T_MarketMTFEvidence) AND
                     NOT IsNull(H5T_MarketMTFPhase) AND NOT IsNull(H5T_MarketMTFConflict);
H5T_MarketEffective = H5T_MarketExact AND H5T_MarketValid==1 AND H5T_MarketPayload;
H5T_MarketSelection = H5T_SelectionContext(H5T_MarketEffective,H5T_MarketMult,H5T_MarketDir,
                        H5T_MarketEvidence,H5T_MarketHyp,H5T_MarketMTFDir);
_SECTION_END();

_SECTION_BEGIN("07. TAI DUNG QUYET DINH TRUNCATED");
H5T_TSourceValid = Interval()==inDaily AND WCI_ProvisionalFlag==0 AND H5T_StockCloseValid AND
    NOT IsNull(WCI_ContextMultiplicityCode) AND NOT IsNull(WCI_DirectionalContextCode) AND
    NOT IsNull(WCI_PhaseStateCode) AND NOT IsNull(WCI_FamilyHypothesisCode) AND
    NOT IsNull(WCI_EvidenceBalanceCode) AND NOT IsNull(WCI_HypothesisAlignmentCode);
H5T_RoleConflict = NOT WVRC_RoleIdentityValid;
H5T_TMarketConfig = StrLen(WVRC_RSMarketSymbol)>0 AND
                     WVRC_RSMarketSymbol==WVRC_SelectionMarketSymbol;
H5T_TMarketRSReady = H5T_RSMarketStatus==3 AND H5T_RSContextValid==1;
H5T_TRequiredFinite = H5T_Finite(Close) AND Close>0 AND H5T_Finite(H5T_DT) AND
    H5T_Finite(WCI_ContextMultiplicityCode) AND H5T_Finite(WCI_DirectionalContextCode) AND
    H5T_Finite(WCI_PhaseStateCode) AND H5T_Finite(WCI_EvidenceBalanceCode) AND
    H5T_Finite(WCI_HypothesisAlignmentCode) AND H5T_Finite(H5T_MTFDir) AND H5T_Finite(H5T_RSStruct);
H5T_TExcl =
      IIf(WCI_ProvisionalFlag==1,1,0)
    + 0
    + IIf(NOT H5T_TMarketRSReady,4,0)
    + IIf(WVRC_RSAdjustmentBasisStatus!=1,8,0)
    + IIf(H5T_MTFValid!=1,16,0)
    + IIf(NOT H5T_MarketEffective,32,0)
    + 0
    + IIf(NOT H5T_TRequiredFinite,128,0)
    + IIf(Interval()!=inDaily,256,0)
    + IIf(NOT H5T_TMarketConfig,512,0)
    + IIf(H5T_RoleConflict,1024,0);
H5T_TEligible = H5T_TSourceValid AND H5T_TExcl==0;
H5T_TReview = H5T_Review(H5T_TEligible,WCI_ContextMultiplicityCode,H5T_PriceRS,
                 WCI_EvidenceBalanceCode,WCI_HypothesisAlignmentCode,H5T_MTFDir,H5T_RSStruct,
                 H5T_MarketSelection,WCI_DirectionalContextCode,H5T_RoleConflict,H5T_RangeConflict);
H5T_TMethod = H5T_MethodBlock(H5T_MarketSelection,H5T_Stage,WCI_DirectionalContextCode,H5T_MTFDir,
                 H5T_RSStruct,WCI_EvidenceBalanceCode,WCI_HypothesisAlignmentCode,H5T_PriceRS,
                 WCI_ContextMultiplicityCode,H5T_RoleConflict,H5T_TMarketConfig,H5T_RangeConflict);
H5T_TClass = H5T_Classify(H5T_TEligible,H5T_TReview,H5T_MarketSelection,WCI_DirectionalContextCode,
                H5T_Stage,H5T_MTFDir,H5T_RSStruct,WCI_EvidenceBalanceCode,WCI_HypothesisAlignmentCode,
                H5T_PriceRS,WCI_ContextMultiplicityCode,H5T_RangeCoherent);
H5T_TSide = H5T_Side(H5T_TClass,WCI_DirectionalContextCode,H5T_RSStruct);
_SECTION_END();

_SECTION_BEGIN("08. TAI DUNG QUYET DINH BASELINE");
H5T_BStage = H5T_StageFromPhase(H5T_BPhase);
H5T_BMarketConfig = StrLen(WVRC_RSMarketSymbol)>0 AND
                     WVRC_RSMarketSymbol==WVRC_SelectionMarketSymbol AND
                     H5T_BRSMarketSymbol==WVRC_RSMarketSymbol;
H5T_BMarketRSReady = H5T_BRSMarketStatus==3 AND H5T_BRSValid==1;
H5T_BRequiredFinite = H5T_Finite(H5T_BClose) AND H5T_BClose>0 AND H5T_Finite(H5T_BSourceDT) AND
    H5T_Finite(H5T_BMult) AND H5T_Finite(H5T_BDir) AND H5T_Finite(H5T_BPhase) AND
    H5T_Finite(H5T_BEvidence) AND H5T_Finite(H5T_BHypAlign) AND H5T_Finite(H5T_BMTFDir) AND
    H5T_Finite(H5T_BRSStruct);
H5T_BExcl =
      IIf(H5T_BProvisional==1,1,0)
    + IIf(H5T_BSchemaValid!=1,2,0)
    + IIf(NOT H5T_BMarketRSReady,4,0)
    + IIf(WVRC_RSAdjustmentBasisStatus!=1,8,0)
    + IIf(H5T_BMTFValid!=1,16,0)
    + IIf(NOT H5T_MarketEffective,32,0)
    + 0
    + IIf(NOT H5T_BRequiredFinite,128,0)
    + IIf(Interval()!=inDaily,256,0)
    + IIf(NOT H5T_BMarketConfig,512,0)
    + IIf(H5T_RoleConflict,1024,0);
H5T_BEligible = H5T_BExact AND H5T_BSourceValid==1 AND H5T_BExcl==0;
H5T_BReview = H5T_Review(H5T_BEligible,H5T_BMult,H5T_BPriceRS,H5T_BEvidence,H5T_BHypAlign,
                 H5T_BMTFDir,H5T_BRSStruct,H5T_MarketSelection,H5T_BDir,H5T_RoleConflict,H5T_BRangeConflict);
H5T_BMethod = H5T_MethodBlock(H5T_MarketSelection,H5T_BStage,H5T_BDir,H5T_BMTFDir,H5T_BRSStruct,
                 H5T_BEvidence,H5T_BHypAlign,H5T_BPriceRS,H5T_BMult,H5T_RoleConflict,
                 H5T_BMarketConfig,H5T_BRangeConflict);
H5T_BClass = H5T_Classify(H5T_BEligible,H5T_BReview,H5T_MarketSelection,H5T_BDir,H5T_BStage,
                H5T_BMTFDir,H5T_BRSStruct,H5T_BEvidence,H5T_BHypAlign,H5T_BPriceRS,H5T_BMult,H5T_BRangeCoherent);
H5T_BSide = H5T_Side(H5T_BClass,H5T_BDir,H5T_BRSStruct);
_SECTION_END();

_SECTION_BEGIN("09. SO SANH TRUNCATION INVARIANCE");
H5T_MatchEligible = H5T_Eq(H5T_BEligible,H5T_TEligible);
H5T_MatchClass = H5T_Eq(H5T_BClass,H5T_TClass);
H5T_MatchSide = H5T_Eq(H5T_BSide,H5T_TSide);
H5T_MatchStage = H5T_Eq(H5T_BStage,H5T_Stage);
H5T_MatchPhase = H5T_Eq(H5T_BPhase,WCI_PhaseStateCode);
H5T_MatchFamily = H5T_Eq(H5T_BFamily,WCI_FamilyHypothesisCode);
H5T_MatchRange = H5T_EqTol(H5T_BRangePos,H5T_RangePos,0.00001);
H5T_MatchMTF = H5T_Eq(H5T_BMTFDir,H5T_MTFDir);
H5T_MatchRS = H5T_Eq(H5T_BRSStruct,H5T_RSStruct);
H5T_MatchReview = H5T_Eq(H5T_BReview,H5T_TReview);
H5T_MatchMethod = H5T_Eq(H5T_BMethod,H5T_TMethod);
H5T_AllMatch = H5T_MatchEligible AND H5T_MatchClass AND H5T_MatchSide AND H5T_MatchStage AND
                H5T_MatchPhase AND H5T_MatchFamily AND H5T_MatchRange AND H5T_MatchMTF AND
                H5T_MatchRS AND H5T_MatchReview AND H5T_MatchMethod;
H5T_Prereq = Interval()==inDaily AND H5T_CutRowCount==1 AND H5T_FutureBarCount>0 AND H5T_BReady;
H5T_Status = IIf(NOT H5T_Prereq,0,IIf(H5T_AllMatch,1,2));
H5T_StatusText = "Thieu prerequisite / moc cat khong hop le\nKhop baseline sau khi cat future\nSai khac sau khi cat future";
H5T_YesNoText = "Khong\nCo";
H5T_Version = "HISTORICAL_TRUNCATION_PROOF_V01_20260914_A";
Filter = H5T_CutRow;

AddTextColumn(H5T_Symbol,"Ma co phieu");
AddTextColumn(H5T_CutChoice,"Moc cat du lieu");
AddColumn(H5T_Zero+H5T_FutureBarCount,"So bar future da cat",1.0);
AddMultiTextColumn(H5T_MatchEligible,H5T_YesNoText,"Khop du lieu hop le");
AddMultiTextColumn(H5T_MatchClass,H5T_YesNoText,"Khop lop ung vien");
AddMultiTextColumn(H5T_MatchSide,H5T_YesNoText,"Khop huong");
AddMultiTextColumn(H5T_MatchStage,H5T_YesNoText,"Khop giai doan");
AddMultiTextColumn(H5T_MatchPhase,H5T_YesNoText,"Khop pha");
AddMultiTextColumn(H5T_MatchFamily,H5T_YesNoText,"Khop gia thuyet");
AddMultiTextColumn(H5T_MatchRange,H5T_YesNoText,"Khop vi tri vung");
AddMultiTextColumn(H5T_MatchMTF,H5T_YesNoText,"Khop MTF");
AddMultiTextColumn(H5T_MatchRS,H5T_YesNoText,"Khop RS");
AddMultiTextColumn(H5T_MatchReview,H5T_YesNoText,"Khop can xem xet");
AddMultiTextColumn(H5T_MatchMethod,H5T_YesNoText,"Khop ma chan phuong phap");
AddColumn(H5T_BClass,"Lop baseline",1.0);
AddColumn(H5T_TClass,"Lop sau cat",1.0);
AddColumn(H5T_BMethod,"Ma chan baseline",1.0);
AddColumn(H5T_TMethod,"Ma chan sau cat",1.0);
AddMultiTextColumn(H5T_Status,H5T_StatusText,"Trang thai H5B");
AddTextColumn(H5T_Version,"Phien ban H5B");
_SECTION_END();
