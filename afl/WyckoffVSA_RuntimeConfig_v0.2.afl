/*
    Wyckoff VSA Performance Runtime v0.2
    Centralized runtime configuration surface.

    APPROVED ARCHITECTURE / NATIVE-VALIDATED CHECKPOINT.
    NOT FINAL RELEASE ACCEPTANCE.

    Purpose:
    - provide one ordered, production-facing Parameter namespace;
    - expose approved DAILY FAST defaults;
    - separate runtime orchestration from analytical methodology;
    - prepare publisher/consumer integration without changing any canonical
      analytical result.

    IMPORTANT:
    - this file does not calculate Wyckoff/VSA events, phase, scanner class or P&F;
    - legacy module-specific provisional overrides are not exposed here;
    - when this file is included first, WVRC_UseCentralConfig=1 tells compatible
      runtime modules to consume WVRC_* values instead of declaring duplicate
      legacy Params. Standalone legacy formulas remain unchanged when the flag
      is absent.

    PRESENTATION PATCH 2026-09-14:
    - all user-facing Parameters use Vietnamese ASCII for AmiBroker 6.20.01;
    - defaults, numeric ranges, steps, variable names and analytical semantics
      are unchanged, except free-text declaration defaults are translated for UI;
    - adjustment-basis validity continues to be controlled by the numeric status.
*/

WVRC_UseCentralConfig = 1;

_SECTION_BEGIN("01. CHE DO CHAY");
WVRC_RuntimeProfileCode = Param(
    "1.1 Ho so chay: 0=QUET NHANH HANG NGAY 1=RA SOAT SAU 2=KIEM TOAN / HOI QUY",
    0,0,2,1);

WVRC_ProductionFilterCode = Param(
    "1.2 Bo loc san xuat: 0=Dat chuan 1=Dang phat trien+ 2=Theo doi+ 3=Ra soat 4=Tat ca du dieu kien 5=Ra soat P&F",
    2,0,5,1);

WVRC_LastBarProvisional = ParamToggle(
    "1.3 Xem thanh cuoi la tam thoi",
    "Khong|Co",0);
_SECTION_END();

_SECTION_BEGIN("02. DU LIEU VSA");
WVRC_VolumeLookback = Param("2.1 So phien nhin lai khoi luong",20,2,200,1);
WVRC_SpreadLookback = Param("2.2 So phien nhin lai bien do",20,2,200,1);
WVRC_ATRPeriod = Param("2.3 Chu ky ATR",14,2,200,1);
WVRC_HighEffortRVOL = Param("2.4 Nguong RVOL no luc cao",1.80,0.01,10,0.05);
WVRC_LowEffortRVOL = Param("2.5 Nguong RVOL no luc thap",0.75,0,10,0.05);
WVRC_LowDirectionalResultATR = Param("2.6 Ket qua theo huong thap tinh theo ATR",0.35,0,10,0.05);
WVRC_HighDirectionalResultATR = Param("2.7 Ket qua theo huong cao tinh theo ATR",0.80,0.01,10,0.05);
_SECTION_END();

_SECTION_BEGIN("03. CAU TRUC / VI TRI");
WVRC_ShortLookback = Param("3.1 So phien nhin lai ngan",20,2,500,1);
WVRC_MediumLookback = Param("3.2 So phien nhin lai trung",60,2,500,1);
WVRC_LongLookback = Param("3.3 So phien nhin lai dai",120,2,500,1);
WVRC_PivotLeft = Param("3.4 So thanh ben trai cua pivot",3,1,20,1);
WVRC_PivotRight = Param("3.5 So thanh ben phai cua pivot",3,1,20,1);
_SECTION_END();

_SECTION_BEGIN("06. SUC MANH TUONG DOI");
WVRC_RSMarketSymbol = ParamStr("6.1 Chi so thi truong doi chieu","VNINDEX");
WVRC_RSGroupSymbol = ParamStr("6.2 Chi so nhom doi chieu","");
WVRC_RSAdjustmentBasisDeclaration = ParamStr(
    "6.3 Khai bao co so dieu chinh",
    "GIA DA DIEU CHINH");
WVRC_RSAdjustmentBasisStatus = Param(
    "6.4 Trang thai co so dieu chinh: 0=Chua xac minh 1=Da khai bao tuong thich 2=Khong tuong thich",
    1,0,2,1);
_SECTION_END();

_SECTION_BEGIN("07. BOI CANH THI TRUONG / NHOM");
WVRC_SelectionMarketSymbol = ParamStr("7.1 Chi so thi truong dung cho boi canh","VNINDEX");
WVRC_SelectionGroupSymbol = ParamStr("7.2 Chi so nhom dung cho boi canh","");
_SECTION_END();

_SECTION_BEGIN("08. BO LOC");
WVRC_RequireFullTopDown = ParamToggle(
    "8.1 Yeu cau day du boi canh tu tren xuong",
    "Khong|Co",0);
_SECTION_END();

_SECTION_BEGIN("09. P&F");
WVRC_PnFRuntimeModeRequested = Param(
    "9.1 Che do P&F: 0=Tam hoan / Tat 1=Bat",
    0,0,1,1);
WVRC_PnFBoxSize = Param("9.2 Kich thuoc hop co dinh",1,0.000001,1000000,0.01);
WVRC_PnFGridOrigin = Param("9.3 Moc goc luoi",0,-1000000000,1000000000,0.01);
WVRC_PnFReversalBoxes = Param("9.4 So hop dao chieu: 1 hoac 3",3,1,3,2);
WVRC_PnFAdjustmentBasisDeclaration = ParamStr(
    "9.5 Khai bao co so dieu chinh",
    "TUONG THICH - DA KHAI BAO");
WVRC_PnFAdjustmentBasisStatus = Param(
    "9.6 Trang thai co so dieu chinh: 0=Chua xac minh 1=Da khai bao tuong thich 2=Khong tuong thich",
    1,0,2,1);
_SECTION_END();

_SECTION_BEGIN("10. HIEN THI / CHAN DOAN");
WVRC_OutputDetailRequested = Param(
    "10.1 Muc chi tiet: 0=Gon 1=Chi tiet 2=Kiem toan",
    0,0,2,1);
WVRC_ShowDecisionDiagnostics = ParamToggle(
    "10.2 Hien chan doan quyet dinh",
    "Khong|Co",0);
WVRC_ShowRangeDiagnostics = ParamToggle(
    "10.3 Hien chan doan vung gia",
    "Khong|Co",0);
WVRC_ShowDebugTitle = ParamToggle(
    "10.4 Hien tieu de go loi",
    "Khong|Co",0);
_SECTION_END();

_SECTION_BEGIN("90. NANG CAO / KIEM THU");
WVRC_PnFSourceRevisionStatus = Param(
    "90.8 Trang thai sua doi nguon P&F: 0=Chua danh gia 1=Khong doi 2=Da sua doi",
    0,0,2,1);
_SECTION_END();

// ---------------------------------------------------------------------------
// Effective orchestration values.
// Runtime Profile does not alter analytical calibration Params (2.x/3.x/etc.).
// It only selects profile-specific runtime behavior.
// ---------------------------------------------------------------------------
WVRC_PnFRuntimeModeEffective = IIf(
    WVRC_RuntimeProfileCode==0,
    WVRC_PnFRuntimeModeRequested,
    1);

WVRC_OutputDetailEffective = IIf(
    WVRC_RuntimeProfileCode==0,
    WVRC_OutputDetailRequested,
    IIf(WVRC_RuntimeProfileCode==1,1,2));

// ---------------------------------------------------------------------------
// Configuration validation. Failures are infrastructure/configuration state;
// they do not redefine analytical classes.
// ---------------------------------------------------------------------------
WVRC_ThresholdConfigValid =
    WVRC_LowEffortRVOL < WVRC_HighEffortRVOL AND
    WVRC_LowDirectionalResultATR < WVRC_HighDirectionalResultATR;

WVRC_MarketIdentityConsistent =
    WVRC_RSMarketSymbol == WVRC_SelectionMarketSymbol;

WVRC_GroupIdentityConsistent =
    WVRC_RSGroupSymbol == WVRC_SelectionGroupSymbol;

WVRC_RoleIdentityValid =
    NOT (
        StrLen(WVRC_SelectionMarketSymbol)>0 AND
        StrLen(WVRC_SelectionGroupSymbol)>0 AND
        WVRC_SelectionMarketSymbol==WVRC_SelectionGroupSymbol
    );

WVRC_ConfigValid =
    WVRC_ThresholdConfigValid AND
    WVRC_MarketIdentityConsistent AND
    WVRC_GroupIdentityConsistent AND
    WVRC_RoleIdentityValid;

WVRC_RuntimeConfigSchemaMajor = 2;
WVRC_RuntimeConfigSchemaMinor = 0;
