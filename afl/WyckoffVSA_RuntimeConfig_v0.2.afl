/*
    Wyckoff VSA Performance Runtime v0.2
    Centralized runtime configuration surface.

    APPROVED ARCHITECTURE / PRE-NATIVE-TEST IMPLEMENTATION.

    Purpose:
    - provide one ordered, production-facing Parameter namespace;
    - expose approved DAILY FAST defaults;
    - separate runtime orchestration from analytical methodology;
    - prepare publisher/consumer integration without changing any canonical
      analytical result.

    IMPORTANT:
    - this file does not calculate Wyckoff/VSA events, phase, scanner class or P&F;
    - legacy module-specific provisional overrides are not exposed here;
    - when this file is included first, WVRC_UseCentralConfig=1 tells compatible
      runtime modules to consume WVRC_* values instead of declaring duplicate
      legacy Params. Standalone legacy formulas remain unchanged when the flag
      is absent.
*/

WVRC_UseCentralConfig = 1;

_SECTION_BEGIN("01. RUN MODE");
WVRC_RuntimeProfileCode = Param(
    "1.1 Runtime Profile: 0=DAILY FAST SCAN 1=DEEP REVIEW 2=AUDIT / REGRESSION",
    0,0,2,1);

WVRC_ProductionFilterCode = Param(
    "1.2 Production Filter: 0=Qualified 1=Developing+ 2=Watch+ 3=Review 4=All Eligible 5=P&F Review",
    2,0,5,1);

WVRC_LastBarProvisional = ParamToggle(
    "1.3 Treat Last Bar As Provisional",
    "No|Yes",0);
_SECTION_END();

_SECTION_BEGIN("02. DATA & VSA");
WVRC_VolumeLookback = Param("2.1 Volume Lookback",20,2,200,1);
WVRC_SpreadLookback = Param("2.2 Spread Lookback",20,2,200,1);
WVRC_ATRPeriod = Param("2.3 ATR Period",14,2,200,1);
WVRC_HighEffortRVOL = Param("2.4 High Effort RVOL",1.80,0.01,10,0.05);
WVRC_LowEffortRVOL = Param("2.5 Low Effort RVOL",0.75,0,10,0.05);
WVRC_LowDirectionalResultATR = Param("2.6 Low Directional Result ATR",0.35,0,10,0.05);
WVRC_HighDirectionalResultATR = Param("2.7 High Directional Result ATR",0.80,0.01,10,0.05);
_SECTION_END();

_SECTION_BEGIN("03. STRUCTURE / LOCATION");
WVRC_ShortLookback = Param("3.1 Short Lookback",20,2,500,1);
WVRC_MediumLookback = Param("3.2 Medium Lookback",60,2,500,1);
WVRC_LongLookback = Param("3.3 Long Lookback",120,2,500,1);
WVRC_PivotLeft = Param("3.4 Pivot Left",3,1,20,1);
WVRC_PivotRight = Param("3.5 Pivot Right",3,1,20,1);
_SECTION_END();

_SECTION_BEGIN("06. RELATIVE STRENGTH");
WVRC_RSMarketSymbol = ParamStr("6.1 Market Benchmark","VNINDEX");
WVRC_RSGroupSymbol = ParamStr("6.2 Group Benchmark","");
WVRC_RSAdjustmentBasisDeclaration = ParamStr(
    "6.3 Adjustment Basis Declaration",
    "ADJUSTED PRICE");
WVRC_RSAdjustmentBasisStatus = Param(
    "6.4 Adjustment Basis Status: 0=UNVERIFIED 1=COMPATIBLE-DECLARED 2=INCOMPATIBLE",
    1,0,2,1);
_SECTION_END();

_SECTION_BEGIN("07. MARKET / GROUP CONTEXT");
WVRC_SelectionMarketSymbol = ParamStr("7.1 Selection Market Benchmark","VNINDEX");
WVRC_SelectionGroupSymbol = ParamStr("7.2 Selection Group Benchmark","");
_SECTION_END();

_SECTION_BEGIN("08. SCANNER");
WVRC_RequireFullTopDown = ParamToggle(
    "8.1 Require Full Top-Down Profile",
    "No|Yes",0);
_SECTION_END();

_SECTION_BEGIN("09. P&F");
WVRC_PnFRuntimeModeRequested = Param(
    "9.1 P&F Runtime Mode: 0=DEFERRED / OFF 1=ON",
    0,0,1,1);
WVRC_PnFBoxSize = Param("9.2 Fixed Box Size",1,0.000001,1000000,0.01);
WVRC_PnFGridOrigin = Param("9.3 Grid Origin",0,-1000000000,1000000000,0.01);
WVRC_PnFReversalBoxes = Param("9.4 Reversal Boxes: 1 or 3",3,1,3,2);
WVRC_PnFAdjustmentBasisDeclaration = ParamStr(
    "9.5 Adjustment Basis Declaration",
    "COMPATIBLE - DECLARED");
WVRC_PnFAdjustmentBasisStatus = Param(
    "9.6 Adjustment Basis Status: 0=UNVERIFIED 1=COMPATIBLE-DECLARED 2=INCOMPATIBLE",
    1,0,2,1);
_SECTION_END();

_SECTION_BEGIN("10. OUTPUT / DIAGNOSTICS");
WVRC_OutputDetailRequested = Param(
    "10.1 Output Detail: 0=COMPACT 1=DETAILED 2=AUDIT",
    0,0,2,1);
WVRC_ShowDecisionDiagnostics = ParamToggle(
    "10.2 Show Decision Diagnostics",
    "No|Yes",0);
WVRC_ShowRangeDiagnostics = ParamToggle(
    "10.3 Show Range Diagnostics",
    "No|Yes",0);
WVRC_ShowDebugTitle = ParamToggle(
    "10.4 Show Debug Title",
    "No|Yes",0);
_SECTION_END();

_SECTION_BEGIN("90. ADVANCED / TESTING");
WVRC_PnFSourceRevisionStatus = Param(
    "90.8 P&F Source Revision: 0=NOT ASSESSED 1=SAME 2=REVISED",
    0,0,2,1);
_SECTION_END();

// ---------------------------------------------------------------------------
// Effective orchestration values.
// Runtime Profile does not alter analytical calibration Params (2.x/3.x/etc.).
// It only selects profile-specific runtime behavior.
// ---------------------------------------------------------------------------
WVRC_PnFRuntimeModeEffective = IIf(
    WVRC_RuntimeProfileCode==0,
    WVRC_PnFRuntimeModeRequested,
    1);

WVRC_OutputDetailEffective = IIf(
    WVRC_RuntimeProfileCode==0,
    WVRC_OutputDetailRequested,
    IIf(WVRC_RuntimeProfileCode==1,1,2));

// ---------------------------------------------------------------------------
// Configuration validation. Failures are infrastructure/configuration state;
// they do not redefine analytical classes.
// ---------------------------------------------------------------------------
WVRC_ThresholdConfigValid =
    WVRC_LowEffortRVOL < WVRC_HighEffortRVOL AND
    WVRC_LowDirectionalResultATR < WVRC_HighDirectionalResultATR;

WVRC_MarketIdentityConsistent =
    WVRC_RSMarketSymbol == WVRC_SelectionMarketSymbol;

WVRC_GroupIdentityConsistent =
    WVRC_RSGroupSymbol == WVRC_SelectionGroupSymbol;

WVRC_RoleIdentityValid =
    NOT (
        StrLen(WVRC_SelectionMarketSymbol)>0 AND
        StrLen(WVRC_SelectionGroupSymbol)>0 AND
        WVRC_SelectionMarketSymbol==WVRC_SelectionGroupSymbol
    );

WVRC_ConfigValid =
    WVRC_ThresholdConfigValid AND
    WVRC_MarketIdentityConsistent AND
    WVRC_GroupIdentityConsistent AND
    WVRC_RoleIdentityValid;

WVRC_RuntimeConfigSchemaMajor = 2;
WVRC_RuntimeConfigSchemaMinor = 0;
