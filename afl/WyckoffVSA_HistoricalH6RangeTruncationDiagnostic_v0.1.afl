/*
    Wyckoff VSA Historical Scanner v0.1
    H6 range truncation diagnostic cho DMC / SBM / TV3.

    Read-only diagnostic. Khong ghi StaticVar, khong thay methodology/threshold/
    enum/decision surface, khong tao trading signal.

    Muc tieu:
    - cat OHLCV sau 11/09/2026 thanh Null TRUOC KHI chay lai stock causal runtime;
    - so sanh RangePosition tai 11/09 giua:
        (a) runtime sau khi cat future,
        (b) H4 historical timeline da luu tu full-history,
        (c) Production Daily Snapshot da khoa tai 11/09;
    - xac dinh 3 mismatch con lai co phai do future-state revision hay khong.

    UI tieng Viet ASCII khong dau cho AmiBroker 6.20.01.
*/
#pragma nocache
SetBarsRequired(sbrAll,sbrAll);
SetOption("NoDefaultColumns",True);

function H6RT_Finite(x)
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

H6RT_Version = "HISTORICAL_H6_RANGE_TRUNCATION_DIAGNOSTIC_V01_20260915_A";
H6RT_TargetDN = 1260911;
H6RT_Symbol = Name();
H6RT_TargetSymbol = H6RT_Symbol=="DMC" OR H6RT_Symbol=="SBM" OR H6RT_Symbol=="TV3";
H6RT_DN = DateNum();
H6RT_TargetRow = H6RT_DN==H6RT_TargetDN;
H6RT_Keep = H6RT_DN<=H6RT_TargetDN;
H6RT_FutureCount = LastValue(Cum(H6RT_DN>H6RT_TargetDN));
H6RT_YesNo = "Khong\nCo";

// Luu raw source, sau do che toan bo future sau target.
H6RT_RawO = Open;
H6RT_RawH = High;
H6RT_RawL = Low;
H6RT_RawC = Close;
H6RT_RawV = Volume;
Open = IIf(H6RT_Keep,H6RT_RawO,Null);
High = IIf(H6RT_Keep,H6RT_RawH,Null);
Low = IIf(H6RT_Keep,H6RT_RawL,Null);
Close = IIf(H6RT_Keep,H6RT_RawC,Null);
Volume = IIf(H6RT_Keep,H6RT_RawV,Null);

// Tai dung dung stock causal runtime stack nhu H5-B.
#include_once <WyckoffVSA_HistoricalRuntimeDefaults_v0.1.afl>
#include_once <WyckoffVSA_Core_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Candidate_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructureLocation_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Confirmation_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_StoppingClimacticAbsorption_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SupplyTest_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SpringShakeout_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_UpthrustUTAD_Runtime_v0.2.afl>
#include_once <WyckoffVSA_Event_SOSLPS_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructuralSequence_PhaseA_Runtime_v0.2.afl>
#include_once <WyckoffVSA_StructuralSequence_PhaseA_Snapshot_Runtime_v0.2.afl>
#include_once <WyckoffVSA_RangeContext_SOWLPSY_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_InputFacade_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_PublicSnapshot_Runtime_v0.2.afl>
#include_once <WyckoffVSA_PhaseContext_ConsumerFacade_Runtime_v0.2.afl>
#include_once <WyckoffVSA_CompositeIndicator_Runtime_v0.2.afl>
#include_once <WyckoffVSA_DerivedSeriesPivotKernel_v0.1.afl>

// Runtime truncated tai target, dung cung quy tac range selection MS41/H4.
H6RT_Mult = WCI_ContextMultiplicityCode;
H6RT_LPresent = WPC_L_ContextPresent;
H6RT_UPresent = WPC_U_ContextPresent;
H6RT_SingleLower = H6RT_Mult==1 AND H6RT_LPresent==1 AND H6RT_UPresent!=1;
H6RT_SingleUpper = H6RT_Mult==1 AND H6RT_UPresent==1 AND H6RT_LPresent!=1;
H6RT_ContextID = WCI_CurrentRangeContextID;
H6RT_Status = IIf(H6RT_SingleLower,WPCP_L_RangeStatusCode,
    IIf(H6RT_SingleUpper,WPCP_U_RangeStatusCode,0));
H6RT_Valid = IIf(H6RT_SingleLower,WPC_L_RangePositionValid,
    IIf(H6RT_SingleUpper,WPC_U_RangePositionValid,0));
H6RT_Pos = IIf(H6RT_SingleLower,WPC_L_RangePosition,
    IIf(H6RT_SingleUpper,WPC_U_RangePosition,Null));
H6RT_RangeLow = IIf(H6RT_SingleLower,WPC_L_PrimaryRangeLow,
    IIf(H6RT_SingleUpper,WPC_U_PrimaryRangeLow,Null));
H6RT_RangeHigh = IIf(H6RT_SingleLower,WPC_L_PrimaryRangeHigh,
    IIf(H6RT_SingleUpper,WPC_U_PrimaryRangeHigh,Null));
H6RT_RangeKnownAt = IIf(H6RT_SingleLower,WPC_L_RangeKnownAtBarIndex,
    IIf(H6RT_SingleUpper,WPC_U_RangeKnownAtBarIndex,Null));

// H4 full-history historical timeline da luu.
H6RT_H4Prefix = "WVSA_HIST_STOCK_v01_" + H6RT_Symbol + "_";
H6RT_H4Ready = Nz(StaticVarGet(H6RT_H4Prefix+"Ready"),0)==1 AND
    Nz(StaticVarGet(H6RT_H4Prefix+"CommittedGenerationID"),0)>0;
H6RT_H4Key = StaticVarGet(H6RT_H4Prefix+"SourceBusinessDateKey");
H6RT_H4Valid = StaticVarGet(H6RT_H4Prefix+"RangePositionValid");
H6RT_H4Pos = StaticVarGet(H6RT_H4Prefix+"RangePosition");
H6RT_H4Mult = StaticVarGet(H6RT_H4Prefix+"ContextMultiplicityCode");

// Production Daily Snapshot oracle da khoa tai 11/09.
H6RT_ProdPrefix = "WVSA_DAILY_v02_" + H6RT_Symbol + "_";
H6RT_ProdReady = Nz(StaticVarGet(H6RT_ProdPrefix+"Ready"),0)==1 AND
    Nz(StaticVarGet(H6RT_ProdPrefix+"WriteComplete"),0)==1 AND
    Nz(StaticVarGet(H6RT_ProdPrefix+"CommittedGenerationID"),0)>0;
H6RT_ProdKey = Nz(StaticVarGet(H6RT_ProdPrefix+"BusinessDateKey"),0);
H6RT_ProdValid = StaticVarGet(H6RT_ProdPrefix+"RangePositionValid");
H6RT_ProdPos = StaticVarGet(H6RT_ProdPrefix+"RangePosition");
H6RT_ProdMult = StaticVarGet(H6RT_ProdPrefix+"ContextMultiplicity");
H6RT_ProdContextID = StaticVarGet(H6RT_ProdPrefix+"CurrentRangeContextID");

H6RT_TruncProdValidMatch = H6RT_Valid==H6RT_ProdValid;
H6RT_TruncProdPosMatch = H6RT_TruncProdValidMatch AND (
    H6RT_Valid==0 OR
    (H6RT_Valid==1 AND H6RT_Finite(H6RT_Pos) AND H6RT_Finite(H6RT_ProdPos) AND
     abs(H6RT_Pos-H6RT_ProdPos)<=0.0001));
H6RT_TruncH4ValidMatch = H6RT_Valid==H6RT_H4Valid;
H6RT_TruncH4PosMatch = H6RT_TruncH4ValidMatch AND (
    H6RT_Valid==0 OR
    (H6RT_Valid==1 AND H6RT_Finite(H6RT_Pos) AND H6RT_Finite(H6RT_H4Pos) AND
     abs(H6RT_Pos-H6RT_H4Pos)<=0.0001));
H6RT_ContextProdMatch = H6RT_ContextID==H6RT_ProdContextID;
H6RT_Prereq = H6RT_TargetSymbol AND Interval()==inDaily AND H6RT_FutureCount>0 AND
    H6RT_H4Ready AND H6RT_ProdReady AND H6RT_ProdKey==H6RT_TargetDN;

H6RT_DiagnosisCode = IIf(NOT H6RT_Prereq,0,
    IIf(H6RT_TruncProdPosMatch AND NOT H6RT_TruncH4PosMatch,1,
    IIf(H6RT_TruncProdPosMatch AND H6RT_TruncH4PosMatch,2,
    IIf(NOT H6RT_TruncProdPosMatch AND H6RT_TruncH4PosMatch,3,4))));
H6RT_DiagnosisText =
    "Thieu prerequisite\nTruncated khop Production, khac H4 full-history\nCa ba cung khop\nTruncated khop H4, khac Production\nTruncated khac ca H4 va Production";

Filter = H6RT_TargetSymbol AND H6RT_TargetRow;

AddTextColumn(H6RT_Symbol,"Ma co phieu");
AddColumn(0*BarIndex()+H6RT_FutureCount,"So bar future da cat",1.0);
AddColumn(H6RT_Mult,"Truncated multiplicity",1.0);
AddColumn(H6RT_LPresent,"Truncated lower present",1.0);
AddColumn(H6RT_UPresent,"Truncated upper present",1.0);
AddColumn(H6RT_ContextID,"Truncated range context ID",1.0);
AddColumn(H6RT_Status,"Truncated range status",1.0);
AddColumn(H6RT_Valid,"Truncated range valid",1.0);
AddColumn(IIf(H6RT_Valid==1 AND H6RT_Finite(H6RT_Pos),H6RT_Pos,Null),"Truncated range position",1.4);
AddColumn(H6RT_RangeLow,"Truncated range low",1.4);
AddColumn(H6RT_RangeHigh,"Truncated range high",1.4);
AddColumn(H6RT_RangeKnownAt,"Truncated range known-at BI",1.0);

AddColumn(H6RT_H4Mult,"H4 multiplicity",1.0);
AddColumn(H6RT_H4Valid,"H4 range valid",1.0);
AddColumn(IIf(H6RT_H4Valid==1 AND H6RT_Finite(H6RT_H4Pos),H6RT_H4Pos,Null),"H4 full-history range position",1.4);

AddColumn(0*BarIndex()+H6RT_ProdMult,"Production multiplicity",1.0);
AddColumn(0*BarIndex()+H6RT_ProdContextID,"Production range context ID",1.0);
AddColumn(0*BarIndex()+H6RT_ProdValid,"Production range valid",1.0);
AddColumn(IIf(H6RT_ProdValid==1 AND H6RT_Finite(H6RT_ProdPos),0*BarIndex()+H6RT_ProdPos,Null),"Production range position",1.4);

AddMultiTextColumn(H6RT_ContextProdMatch,H6RT_YesNo,"Truncated/Production khop context ID");
AddMultiTextColumn(H6RT_TruncProdValidMatch,H6RT_YesNo,"Truncated/Production khop validity");
AddMultiTextColumn(H6RT_TruncProdPosMatch,H6RT_YesNo,"Truncated/Production khop position");
AddMultiTextColumn(H6RT_TruncH4PosMatch,H6RT_YesNo,"Truncated/H4 khop position");
AddMultiTextColumn(H6RT_DiagnosisCode,H6RT_DiagnosisText,"Chan doan H6 range");
AddTextColumn(H6RT_Version,"Phien ban diagnostic");
