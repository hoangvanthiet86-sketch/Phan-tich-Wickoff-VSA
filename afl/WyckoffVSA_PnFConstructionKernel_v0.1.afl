/*
    Wyckoff VSA P&F Construction Kernel v0.1

    Approved specification: PFK01-PFK44, PR #42.
    Approval merge commit: c5c235718b7ead10c702c615476f321dfc54463a

    Geometry/provenance infrastructure only.
    SPEC-ALIGNED / UNTESTED DEVELOPMENT.

    No Phase/Family/Event interpretation, no horizontal Cause selection,
    no Price Objective and no trading signals.
*/
SetBarsRequired(sbrAll,sbrAll);

_SECTION_BEGIN("120. P&F Construction Kernel configuration");
function WPFK_Finite(x)
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

WPFK_BI = BarIndex();
WPFK_DT = DateTime();
WPFK_Zero = 0 * WPFK_BI;
WPFK_Null = Null + WPFK_Zero;

WPFK_BoxSizeScalar = Param("P&F fixed BoxSize",1,0.000001,1000000,0.01);
WPFK_GridOriginScalar = Param("P&F GridOrigin",0,-1000000000,1000000000,0.01);
WPFK_ReversalBoxesScalar = Param("P&F ReversalBoxes: 1 or 3",3,1,3,2);
WPFK_AdjustmentBasisStatusScalar = Param("P&F adjustment basis: 0=unverified 1=compatible 2=incompatible",0,0,2,1);
WPFK_AdjustmentBasisDeclaration = ParamStr("P&F adjustment basis declaration","NOT VERIFIED");
WPFK_RuntimeLastBarIsProvisional = ParamToggle("P&F: last bar in analysis range is provisional","No|Yes",0);
WPFK_SourceRevisionStatusScalar = Param("P&F source revision: 0=not assessed 1=same 2=revised",0,0,2,1);

WPFK_ConfigValidScalar =
    Interval()==inDaily AND
    WPFK_Finite(WPFK_BoxSizeScalar) AND WPFK_BoxSizeScalar>0 AND
    WPFK_Finite(WPFK_GridOriginScalar) AND
    (WPFK_ReversalBoxesScalar==1 OR WPFK_ReversalBoxesScalar==3);

WPFK_ConfigValid = WPFK_Zero + WPFK_ConfigValidScalar;
WPFK_BoxSize = WPFK_Zero + WPFK_BoxSizeScalar;
WPFK_GridOrigin = WPFK_Zero + WPFK_GridOriginScalar;
WPFK_ReversalBoxes = WPFK_Zero + WPFK_ReversalBoxesScalar;
WPFK_PriceMethodCode = WPFK_Zero + 1; // 1 = HIGH_LOW
WPFK_KernelSchemaMajor = WPFK_Zero + 1;
WPFK_KernelSchemaMinor = WPFK_Zero;
WPFK_AdjustmentBasisStatusCode = WPFK_Zero + WPFK_AdjustmentBasisStatusScalar;
WPFK_SourceRevisionStatusCode = WPFK_Zero + WPFK_SourceRevisionStatusScalar;
WPFK_ProductionConstructionValid = WPFK_Zero + (WPFK_ConfigValidScalar AND WPFK_AdjustmentBasisStatusScalar==1);

WPFK_SourceBarValid = WPFK_Finite(High) AND WPFK_Finite(Low) AND High>0 AND Low>0 AND High>=Low;
WPFK_BootstrapCloseValid = WPFK_Finite(Close) AND Close>0;
WPFK_ProvisionalFlag = IIf(Status("lastbarinrange") AND WPFK_RuntimeLastBarIsProvisional,1,0);
_SECTION_END();

_SECTION_BEGIN("121. P&F causal state machine");
// Public arrays: per-bar state AFTER the current completed bar is processed.
WPFK_ChartUpdateCode = WPFK_Zero;
WPFK_BoxesAddedCount = WPFK_Zero;
WPFK_ReversalOccurredFlag = WPFK_Zero;
WPFK_OneBoxReversalBlockedFlag = WPFK_Zero;
WPFK_DataGapEventFlag = WPFK_Zero;
WPFK_BootstrapAmbiguousFlag = WPFK_Zero;
WPFK_BoundaryToleranceUsedFlag = WPFK_Zero;
WPFK_ProvisionalWouldSeedFlag = WPFK_Zero;
WPFK_ProvisionalWouldInitializeFlag = WPFK_Zero;
WPFK_ProvisionalWouldExtendFlag = WPFK_Zero;
WPFK_ProvisionalWouldReverseFlag = WPFK_Zero;

WPFK_BootstrapSeedBarIndex = WPFK_Null;
WPFK_BootstrapSeedDateTime = WPFK_Null;
WPFK_BootstrapSeedPrice = WPFK_Null;
WPFK_BootstrapSeedBoxIndex = WPFK_Null;
WPFK_FirstColumnKnownAtBarIndex = WPFK_Null;
WPFK_FirstColumnKnownAtDateTime = WPFK_Null;
WPFK_FirstReversalKnownAtBarIndex = WPFK_Null;
WPFK_FirstReversalKnownAtDateTime = WPFK_Null;
WPFK_ConstructionMatureFlag = WPFK_Zero;
WPFK_BootstrapAmbiguousCount = WPFK_Zero;
WPFK_CumulativeDataGapCount = WPFK_Zero;

WPFK_CurrentColumnIndex = WPFK_Null;
WPFK_CurrentColumnDirectionCode = WPFK_Zero;
WPFK_CurrentColumnStartBoxIndex = WPFK_Null;
WPFK_CurrentColumnTopBoxIndex = WPFK_Null;
WPFK_CurrentColumnBottomBoxIndex = WPFK_Null;
WPFK_CurrentColumnBoxCount = WPFK_Null;
WPFK_CurrentColumnStartPrice = WPFK_Null;
WPFK_CurrentColumnTopPrice = WPFK_Null;
WPFK_CurrentColumnBottomPrice = WPFK_Null;
WPFK_CurrentColumnFirstKnownAtBarIndex = WPFK_Null;
WPFK_CurrentColumnFirstKnownAtDateTime = WPFK_Null;
WPFK_CurrentColumnLastExtendedAtBarIndex = WPFK_Null;
WPFK_CurrentColumnLastExtendedAtDateTime = WPFK_Null;
WPFK_CurrentColumnSourceValidBarCount = WPFK_Null;
WPFK_CurrentColumnBoundaryToleranceUseCount = WPFK_Null;
WPFK_CurrentColumnDataGapObservedFlag = WPFK_Zero;

WPFK_ClosedColumnEventCode = WPFK_Zero; // 0 none, 1 closed by reversal
WPFK_ClosedColumnIndex = WPFK_Null;
WPFK_ClosedColumnDirectionCode = WPFK_Zero;
WPFK_ClosedColumnStartBoxIndex = WPFK_Null;
WPFK_ClosedColumnTopBoxIndex = WPFK_Null;
WPFK_ClosedColumnBottomBoxIndex = WPFK_Null;
WPFK_ClosedColumnBoxCount = WPFK_Null;
WPFK_ClosedColumnFirstKnownAtBarIndex = WPFK_Null;
WPFK_ClosedColumnFirstKnownAtDateTime = WPFK_Null;
WPFK_ClosedColumnLastExtendedAtBarIndex = WPFK_Null;
WPFK_ClosedColumnLastExtendedAtDateTime = WPFK_Null;
WPFK_ClosedColumnFinalizedAtBarIndex = WPFK_Null;
WPFK_ClosedColumnFinalizedAtDateTime = WPFK_Null;
WPFK_ClosedColumnSourceValidBarCount = WPFK_Null;
WPFK_ClosedColumnBoundaryToleranceUseCount = WPFK_Null;
WPFK_ClosedColumnDataGapObservedFlag = WPFK_Zero;

// Direct causal mapping surface for downstream KnownAt anchors.
WPFK_ColumnIndexKnownAtOrBeforeBar = WPFK_Null;
WPFK_ColumnDirectionKnownAtOrBeforeBar = WPFK_Zero;
WPFK_ColumnTopBoxKnownAtOrBeforeBar = WPFK_Null;
WPFK_ColumnBottomBoxKnownAtOrBeforeBar = WPFK_Null;
WPFK_SameBarColumnCreationFlag = WPFK_Zero;
WPFK_MappingStatusCode = WPFK_Zero; // 0 no column yet, 1 column available

seeded = 0;
seedBI = Null; seedDT = Null; seedPrice = Null; seedBox = Null;
firstColBI = Null; firstColDT = Null;
firstRevBI = Null; firstRevDT = Null;
mature = 0;
ambiguousCount = 0;
gapCount = 0;

colExists = 0;
colIndex = Null; colDir = 0; colStart = Null; colTop = Null; colBottom = Null;
colFirstBI = Null; colFirstDT = Null; colLastBI = Null; colLastDT = Null;
colValidBars = 0; colTolCount = 0; colGapFlag = 0;

for(i=0;i<BarCount;i++)
{
    updateCode = 0;
    boxesAdded = 0;
    reversal = 0;
    blocked = 0;
    gapEvent = 0;
    ambiguous = 0;
    tolUsedBar = 0;
    sameBarCreation = 0;

    // Reset per-bar closed-column snapshot.
    WPFK_ClosedColumnEventCode[i] = 0;
    WPFK_ClosedColumnDirectionCode[i] = 0;
    WPFK_ClosedColumnDataGapObservedFlag[i] = 0;

    sourceValid = WPFK_SourceBarValid[i];
    closeValid = WPFK_BootstrapCloseValid[i];
    provisional = WPFK_ProvisionalFlag[i];

    if(NOT WPFK_ConfigValidScalar)
    {
        updateCode = 0;
    }
    else
    if(provisional)
    {
        updateCode = 6;

        if(sourceValid)
        {
            h = High[i]; l = Low[i];
            tolH = Min(WPFK_BoxSizeScalar*1e-9,1e-10*Max(1,Abs(h)));
            tolL = Min(WPFK_BoxSizeScalar*1e-9,1e-10*Max(1,Abs(l)));
            highBox = Floor((h-WPFK_GridOriginScalar+tolH)/WPFK_BoxSizeScalar);
            lowBox = Ceil((l-WPFK_GridOriginScalar-tolL)/WPFK_BoxSizeScalar);

            if(NOT seeded AND closeValid)
                WPFK_ProvisionalWouldSeedFlag[i] = 1;
            else
            if(seeded AND NOT colExists)
            {
                upReach = Max(0,highBox-seedBox);
                downReach = Max(0,seedBox-lowBox);
                if((upReach>=1 OR downReach>=1) AND upReach!=downReach)
                    WPFK_ProvisionalWouldInitializeFlag[i] = 1;
            }
            else
            if(colExists)
            {
                if(colDir==1)
                {
                    if(highBox>=colTop+1)
                        WPFK_ProvisionalWouldExtendFlag[i] = 1;
                    else
                    if(l <= WPFK_GridOriginScalar + (colTop-WPFK_ReversalBoxesScalar)*WPFK_BoxSizeScalar + tolL)
                    {
                        if(WPFK_ReversalBoxesScalar!=1 OR (colTop-colBottom+1)>=2)
                            WPFK_ProvisionalWouldReverseFlag[i] = 1;
                    }
                }
                else
                if(colDir==2)
                {
                    if(lowBox<=colBottom-1)
                        WPFK_ProvisionalWouldExtendFlag[i] = 1;
                    else
                    if(h >= WPFK_GridOriginScalar + (colBottom+WPFK_ReversalBoxesScalar)*WPFK_BoxSizeScalar - tolH)
                    {
                        if(WPFK_ReversalBoxesScalar!=1 OR (colTop-colBottom+1)>=2)
                            WPFK_ProvisionalWouldReverseFlag[i] = 1;
                    }
                }
            }
        }
    }
    else
    if(NOT sourceValid)
    {
        gapEvent = 1;
        gapCount = gapCount + 1;
        updateCode = 0;
        if(colExists) colGapFlag = 1;
    }
    else
    {
        h = High[i]; l = Low[i]; c = Close[i];
        tolH = Min(WPFK_BoxSizeScalar*1e-9,1e-10*Max(1,Abs(h)));
        tolL = Min(WPFK_BoxSizeScalar*1e-9,1e-10*Max(1,Abs(l)));
        rawHighBox = Floor((h-WPFK_GridOriginScalar)/WPFK_BoxSizeScalar);
        rawLowBox = Ceil((l-WPFK_GridOriginScalar)/WPFK_BoxSizeScalar);
        highBox = Floor((h-WPFK_GridOriginScalar+tolH)/WPFK_BoxSizeScalar);
        lowBox = Ceil((l-WPFK_GridOriginScalar-tolL)/WPFK_BoxSizeScalar);
        tolUsedBar = (highBox!=rawHighBox) OR (lowBox!=rawLowBox);

        if(NOT seeded)
        {
            if(closeValid)
            {
                tolC = Min(WPFK_BoxSizeScalar*1e-9,1e-10*Max(1,Abs(c)));
                seedBoxNow = Floor((c-WPFK_GridOriginScalar+tolC)/WPFK_BoxSizeScalar);
                seeded = 1;
                seedBI = WPFK_BI[i]; seedDT = WPFK_DT[i]; seedPrice = c; seedBox = seedBoxNow;
                updateCode = 4;
            }
            else
            {
                updateCode = 0;
            }
        }
        else
        if(NOT colExists)
        {
            upReach = Max(0,highBox-seedBox);
            downReach = Max(0,seedBox-lowBox);

            firstDir = 0;
            if(upReach>=1 AND downReach<1) firstDir = 1;
            else if(downReach>=1 AND upReach<1) firstDir = 2;
            else if(upReach>=1 AND downReach>=1)
            {
                if(upReach>downReach) firstDir = 1;
                else if(downReach>upReach) firstDir = 2;
                else
                {
                    ambiguous = 1;
                    ambiguousCount = ambiguousCount + 1;
                }
            }

            if(firstDir==1)
            {
                colExists = 1; colIndex = 0; colDir = 1;
                colStart = seedBox+1; colBottom = colStart; colTop = highBox;
                colFirstBI = WPFK_BI[i]; colFirstDT = WPFK_DT[i];
                colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                colValidBars = 1; colTolCount = tolUsedBar; colGapFlag = 0;
                firstColBI = WPFK_BI[i]; firstColDT = WPFK_DT[i];
                boxesAdded = colTop-colBottom+1;
                updateCode = 5;
                sameBarCreation = 1;
            }
            else
            if(firstDir==2)
            {
                colExists = 1; colIndex = 0; colDir = 2;
                colStart = seedBox-1; colTop = colStart; colBottom = lowBox;
                colFirstBI = WPFK_BI[i]; colFirstDT = WPFK_DT[i];
                colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                colValidBars = 1; colTolCount = tolUsedBar; colGapFlag = 0;
                firstColBI = WPFK_BI[i]; firstColDT = WPFK_DT[i];
                boxesAdded = colTop-colBottom+1;
                updateCode = 5;
                sameBarCreation = 1;
            }
            else
            {
                updateCode = 1;
            }
        }
        else
        {
            // Count this valid completed source bar against the currently-open column,
            // unless reversal creates a new column below.
            oldValidBars = colValidBars;
            oldTolCount = colTolCount;
            colValidBars = colValidBars + 1;
            if(tolUsedBar) colTolCount = colTolCount + 1;

            if(colDir==1)
            {
                if(highBox>=colTop+1)
                {
                    boxesAdded = highBox-colTop;
                    colTop = highBox;
                    colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                    updateCode = 2;
                    // Low intentionally ignored after successful X extension.
                }
                else
                {
                    reversalGrid = WPFK_GridOriginScalar + (colTop-WPFK_ReversalBoxesScalar)*WPFK_BoxSizeScalar;
                    reversalHit = l <= reversalGrid + tolL;
                    if(reversalHit AND WPFK_ReversalBoxesScalar==1 AND (colTop-colBottom+1)<2)
                    {
                        blocked = 1;
                        updateCode = 1;
                    }
                    else
                    if(reversalHit)
                    {
                        // Freeze prior X at this reversal bar.
                        WPFK_ClosedColumnEventCode[i] = 1;
                        WPFK_ClosedColumnIndex[i] = colIndex;
                        WPFK_ClosedColumnDirectionCode[i] = colDir;
                        WPFK_ClosedColumnStartBoxIndex[i] = colStart;
                        WPFK_ClosedColumnTopBoxIndex[i] = colTop;
                        WPFK_ClosedColumnBottomBoxIndex[i] = colBottom;
                        WPFK_ClosedColumnBoxCount[i] = colTop-colBottom+1;
                        WPFK_ClosedColumnFirstKnownAtBarIndex[i] = colFirstBI;
                        WPFK_ClosedColumnFirstKnownAtDateTime[i] = colFirstDT;
                        WPFK_ClosedColumnLastExtendedAtBarIndex[i] = colLastBI;
                        WPFK_ClosedColumnLastExtendedAtDateTime[i] = colLastDT;
                        WPFK_ClosedColumnFinalizedAtBarIndex[i] = WPFK_BI[i];
                        WPFK_ClosedColumnFinalizedAtDateTime[i] = WPFK_DT[i];
                        WPFK_ClosedColumnSourceValidBarCount[i] = oldValidBars;
                        WPFK_ClosedColumnBoundaryToleranceUseCount[i] = oldTolCount;
                        WPFK_ClosedColumnDataGapObservedFlag[i] = colGapFlag;

                        colIndex = colIndex+1; colDir = 2;
                        colStart = colTop-1; colTop = colStart; colBottom = lowBox;
                        colFirstBI = WPFK_BI[i]; colFirstDT = WPFK_DT[i];
                        colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                        colValidBars = 1; colTolCount = tolUsedBar; colGapFlag = 0;
                        boxesAdded = colTop-colBottom+1;
                        reversal = 1; updateCode = 3; sameBarCreation = 1;
                        if(NOT mature)
                        {
                            mature = 1; firstRevBI = WPFK_BI[i]; firstRevDT = WPFK_DT[i];
                        }
                    }
                    else
                    {
                        updateCode = 1;
                    }
                }
            }
            else
            if(colDir==2)
            {
                if(lowBox<=colBottom-1)
                {
                    boxesAdded = colBottom-lowBox;
                    colBottom = lowBox;
                    colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                    updateCode = 2;
                    // High intentionally ignored after successful O extension.
                }
                else
                {
                    reversalGrid = WPFK_GridOriginScalar + (colBottom+WPFK_ReversalBoxesScalar)*WPFK_BoxSizeScalar;
                    reversalHit = h >= reversalGrid - tolH;
                    if(reversalHit AND WPFK_ReversalBoxesScalar==1 AND (colTop-colBottom+1)<2)
                    {
                        blocked = 1;
                        updateCode = 1;
                    }
                    else
                    if(reversalHit)
                    {
                        WPFK_ClosedColumnEventCode[i] = 1;
                        WPFK_ClosedColumnIndex[i] = colIndex;
                        WPFK_ClosedColumnDirectionCode[i] = colDir;
                        WPFK_ClosedColumnStartBoxIndex[i] = colStart;
                        WPFK_ClosedColumnTopBoxIndex[i] = colTop;
                        WPFK_ClosedColumnBottomBoxIndex[i] = colBottom;
                        WPFK_ClosedColumnBoxCount[i] = colTop-colBottom+1;
                        WPFK_ClosedColumnFirstKnownAtBarIndex[i] = colFirstBI;
                        WPFK_ClosedColumnFirstKnownAtDateTime[i] = colFirstDT;
                        WPFK_ClosedColumnLastExtendedAtBarIndex[i] = colLastBI;
                        WPFK_ClosedColumnLastExtendedAtDateTime[i] = colLastDT;
                        WPFK_ClosedColumnFinalizedAtBarIndex[i] = WPFK_BI[i];
                        WPFK_ClosedColumnFinalizedAtDateTime[i] = WPFK_DT[i];
                        WPFK_ClosedColumnSourceValidBarCount[i] = oldValidBars;
                        WPFK_ClosedColumnBoundaryToleranceUseCount[i] = oldTolCount;
                        WPFK_ClosedColumnDataGapObservedFlag[i] = colGapFlag;

                        colIndex = colIndex+1; colDir = 1;
                        colStart = colBottom+1; colBottom = colStart; colTop = highBox;
                        colFirstBI = WPFK_BI[i]; colFirstDT = WPFK_DT[i];
                        colLastBI = WPFK_BI[i]; colLastDT = WPFK_DT[i];
                        colValidBars = 1; colTolCount = tolUsedBar; colGapFlag = 0;
                        boxesAdded = colTop-colBottom+1;
                        reversal = 1; updateCode = 3; sameBarCreation = 1;
                        if(NOT mature)
                        {
                            mature = 1; firstRevBI = WPFK_BI[i]; firstRevDT = WPFK_DT[i];
                        }
                    }
                    else
                    {
                        updateCode = 1;
                    }
                }
            }
        }
    }

    WPFK_ChartUpdateCode[i] = updateCode;
    WPFK_BoxesAddedCount[i] = boxesAdded;
    WPFK_ReversalOccurredFlag[i] = reversal;
    WPFK_OneBoxReversalBlockedFlag[i] = blocked;
    WPFK_DataGapEventFlag[i] = gapEvent;
    WPFK_BootstrapAmbiguousFlag[i] = ambiguous;
    WPFK_BoundaryToleranceUsedFlag[i] = tolUsedBar;

    WPFK_BootstrapSeedBarIndex[i] = seedBI;
    WPFK_BootstrapSeedDateTime[i] = seedDT;
    WPFK_BootstrapSeedPrice[i] = seedPrice;
    WPFK_BootstrapSeedBoxIndex[i] = seedBox;
    WPFK_FirstColumnKnownAtBarIndex[i] = firstColBI;
    WPFK_FirstColumnKnownAtDateTime[i] = firstColDT;
    WPFK_FirstReversalKnownAtBarIndex[i] = firstRevBI;
    WPFK_FirstReversalKnownAtDateTime[i] = firstRevDT;
    WPFK_ConstructionMatureFlag[i] = mature;
    WPFK_BootstrapAmbiguousCount[i] = ambiguousCount;
    WPFK_CumulativeDataGapCount[i] = gapCount;

    if(colExists)
    {
        WPFK_CurrentColumnIndex[i] = colIndex;
        WPFK_CurrentColumnDirectionCode[i] = colDir;
        WPFK_CurrentColumnStartBoxIndex[i] = colStart;
        WPFK_CurrentColumnTopBoxIndex[i] = colTop;
        WPFK_CurrentColumnBottomBoxIndex[i] = colBottom;
        WPFK_CurrentColumnBoxCount[i] = colTop-colBottom+1;
        WPFK_CurrentColumnStartPrice[i] = WPFK_GridOriginScalar + colStart*WPFK_BoxSizeScalar;
        WPFK_CurrentColumnTopPrice[i] = WPFK_GridOriginScalar + colTop*WPFK_BoxSizeScalar;
        WPFK_CurrentColumnBottomPrice[i] = WPFK_GridOriginScalar + colBottom*WPFK_BoxSizeScalar;
        WPFK_CurrentColumnFirstKnownAtBarIndex[i] = colFirstBI;
        WPFK_CurrentColumnFirstKnownAtDateTime[i] = colFirstDT;
        WPFK_CurrentColumnLastExtendedAtBarIndex[i] = colLastBI;
        WPFK_CurrentColumnLastExtendedAtDateTime[i] = colLastDT;
        WPFK_CurrentColumnSourceValidBarCount[i] = colValidBars;
        WPFK_CurrentColumnBoundaryToleranceUseCount[i] = colTolCount;
        WPFK_CurrentColumnDataGapObservedFlag[i] = colGapFlag;

        WPFK_ColumnIndexKnownAtOrBeforeBar[i] = colIndex;
        WPFK_ColumnDirectionKnownAtOrBeforeBar[i] = colDir;
        WPFK_ColumnTopBoxKnownAtOrBeforeBar[i] = colTop;
        WPFK_ColumnBottomBoxKnownAtOrBeforeBar[i] = colBottom;
        WPFK_MappingStatusCode[i] = 1;
    }
    else
    {
        WPFK_CurrentColumnDirectionCode[i] = 0;
        WPFK_CurrentColumnDataGapObservedFlag[i] = 0;
        WPFK_ColumnDirectionKnownAtOrBeforeBar[i] = 0;
        WPFK_MappingStatusCode[i] = 0;
    }

    WPFK_SameBarColumnCreationFlag[i] = sameBarCreation;
}

WPFK_MatureForCauseMapping = WPFK_ConstructionMatureFlag AND WPFK_ProductionConstructionValid;
WPFK_ConstructionAvailable = NOT IsNull(WPFK_CurrentColumnIndex);
WPFK_TotalColumnsKnown = IIf(WPFK_ConstructionAvailable,WPFK_CurrentColumnIndex+1,0);
WPFK_TotalReversalsKnown = IIf(WPFK_ConstructionAvailable,WPFK_CurrentColumnIndex,0);
WPFK_TotalClosedColumnsKnown = WPFK_TotalReversalsKnown;
_SECTION_END();