/*
    Wyckoff VSA Derived-Series Pivot Kernel v0.1

    Approved specification: PR #33, K01-K32.
    Approval merge commit: dcd028447314d49066d0904168ffcf95ed078121

    Purpose: apply the exact Structure/Location v1.0 confirmed-pivot semantics
    to an arbitrary valid numeric series without creating new Wyckoff meaning.

    SPEC-ALIGNED / UNTESTED DEVELOPMENT.
    No Zig/Peak/Trough, no future access, no trading logic.
*/

_SECTION_BEGIN("101. Derived-Series Pivot Kernel helpers");
function WDP_Finite( x )
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

function WDP_ValidInteger( x, minAllowed, maxAllowed )
{
    return IIf(WDP_Finite(x),IIf(x>=minAllowed AND x<=maxAllowed AND x==Floor(x),1,0),0);
}

/*
    Prepare the exact left+right+1 causal confirmation window used by
    Structure/Location v1.0. Results are written under:

      WDP_<channel>_...

    `seriesValid` must represent explicit point-in-time validity of the
    derived numeric series. Missing values are never filled.

    AmiBroker 6.20 compatibility:
    - do not use predefined AFL identifiers such as High/Low/A as user names;
    - do not use built-in function identifiers such as Status as variable names.
*/
function WDP_PrepareWindow( channel, seriesValid, requestedLeft, requestedRight, srcBI, srcDT, srcOffset )
{
    local pfx, cfgValid, leftBars, rightBars, winLength, prefixCount, validCount, windowFull, windowStatus, windowOK;
    pfx = "WDP_"+channel+"_";

    cfgValid = WDP_ValidInteger(requestedLeft,1,20) AND WDP_ValidInteger(requestedRight,1,20);
    leftBars = IIf(cfgValid,requestedLeft,1);
    rightBars = IIf(cfgValid,requestedRight,1);
    winLength = leftBars+rightBars+1;

    prefixCount = Cum(seriesValid);
    validCount = IIf(cfgValid,
        IIf(srcOffset<winLength,prefixCount,
            prefixCount-Nz(Ref(prefixCount,-winLength),0)),Null);

    windowFull = cfgValid AND srcOffset>=leftBars+rightBars;
    windowStatus = IIf(NOT cfgValid,3,
        IIf(NOT windowFull,0,IIf(validCount==winLength,2,1)));
    windowOK = IIf(windowStatus==2,1,0);

    VarSet(pfx+"PivotLeft",IIf(cfgValid,requestedLeft,Null));
    VarSet(pfx+"PivotRight",IIf(cfgValid,requestedRight,Null));
    VarSet(pfx+"PivotA",IIf(cfgValid,leftBars,Null));
    VarSet(pfx+"PivotB",IIf(cfgValid,rightBars,Null));
    VarSet(pfx+"PivotLength",IIf(cfgValid,winLength,Null));
    VarSet(pfx+"PivotConfigValid",IIf(cfgValid,1,0));
    VarSet(pfx+"PivotWindowValidCount",validCount);
    VarSet(pfx+"PivotWindowStatusCode",windowStatus);
    VarSet(pfx+"PivotWindowValid",windowOK);
    VarSet(pfx+"PivotWindowStartBarIndex",IIf(windowFull,Ref(srcBI,-(leftBars+rightBars)),Null));
    VarSet(pfx+"PivotWindowEndBarIndex",IIf(windowFull,srcBI,Null));
    VarSet(pfx+"PivotWindowStartDateTime",IIf(windowFull,Ref(srcDT,-(leftBars+rightBars)),Null));
    VarSet(pfx+"PivotWindowEndDateTime",IIf(windowFull,srcDT,Null));
    VarSet(pfx+"PivotCandidateBarIndex",IIf(windowFull,Ref(srcBI,-rightBars),Null));
    VarSet(pfx+"PivotCandidateDateTime",IIf(windowFull,Ref(srcDT,-rightBars),Null));
    return 1;
}

/*
    Exact behavioral translation of Structure/Location v1.0 SL_CalcPivotKind.

    highKind=1:
      candidate > every left value
      candidate >= every right value including confirmation bar

    highKind=0:
      candidate < every left value
      candidate <= every right value including confirmation bar

    Candidate is always i-rightBars and publication is always at i.
*/
function WDP_CalcPivotKind( channel, kind, highKind, series, windowValid, leftBars, rightBars, srcBI, srcDT )
{
    local pfx, eventValid, eventCode, eventValue, extremeBI, extremeDT, confirmBI, confirmDT, lag;
    local latestValid, latestValue, latestExtremeBI, latestExtremeDT, latestConfirmBI, latestConfirmDT, latestAge, latestSince;
    local priorValid, priorValue, priorExtremeBI, priorExtremeDT, priorConfirmBI, priorConfirmDT, priorAge, priorSince;
    local storedValid, storedValue, storedExtremeBI, storedExtremeDT, storedConfirmBI, storedConfirmDT;
    local storedExtremeOffset, storedConfirmOffset, i, j, k, ok, pivotValue, code;

    pfx = "WDP_"+channel+"_Pivot"+kind;

    eventValid = 0; eventCode = 0; eventValue = Null;
    extremeBI = Null; extremeDT = Null; confirmBI = Null; confirmDT = Null; lag = Null;

    latestValid = 0; latestValue = Null; latestExtremeBI = Null; latestExtremeDT = Null;
    latestConfirmBI = Null; latestConfirmDT = Null; latestAge = Null; latestSince = Null;

    priorValid = 0; priorValue = Null; priorExtremeBI = Null; priorExtremeDT = Null;
    priorConfirmBI = Null; priorConfirmDT = Null; priorAge = Null; priorSince = Null;

    storedValid = 0; storedValue = Null; storedExtremeBI = Null; storedExtremeDT = Null;
    storedConfirmBI = Null; storedConfirmDT = Null; storedExtremeOffset = Null; storedConfirmOffset = Null;

    for(i=0;i<BarCount;i++)
    {
        // LatestPrior snapshot is captured before evaluating bar i.
        priorValid[i] = storedValid;
        if(storedValid)
        {
            priorValue[i] = storedValue;
            priorExtremeBI[i] = storedExtremeBI;
            priorExtremeDT[i] = storedExtremeDT;
            priorConfirmBI[i] = storedConfirmBI;
            priorConfirmDT[i] = storedConfirmDT;
            priorAge[i] = i-storedExtremeOffset;
            priorSince[i] = i-storedConfirmOffset;
        }

        code = 0;
        eventValid[i] = windowValid[i];

        if(windowValid[i])
        {
            code = 1;
            k = i-rightBars;
            pivotValue = series[k];
            ok = 1;

            for(j=k-leftBars;j<k;j++)
            {
                if(highKind)
                {
                    if(NOT (pivotValue>series[j])) ok=0;
                }
                else
                {
                    if(NOT (pivotValue<series[j])) ok=0;
                }
            }

            for(j=k+1;j<=i;j++)
            {
                if(highKind)
                {
                    if(NOT (pivotValue>=series[j])) ok=0;
                }
                else
                {
                    if(NOT (pivotValue<=series[j])) ok=0;
                }
            }

            if(ok)
            {
                code = 2;
                eventValue[i] = pivotValue;
                extremeBI[i] = srcBI[k];
                extremeDT[i] = srcDT[k];
                confirmBI[i] = srcBI[i];
                confirmDT[i] = srcDT[i];
                lag[i] = rightBars;

                storedValid = 1;
                storedValue = pivotValue;
                storedExtremeBI = srcBI[k];
                storedExtremeDT = srcDT[k];
                storedConfirmBI = srcBI[i];
                storedConfirmDT = srcDT[i];
                storedExtremeOffset = k;
                storedConfirmOffset = i;
            }
        }

        eventCode[i] = code;

        // Latest snapshot is captured after evaluating bar i.
        latestValid[i] = storedValid;
        if(storedValid)
        {
            latestValue[i] = storedValue;
            latestExtremeBI[i] = storedExtremeBI;
            latestExtremeDT[i] = storedExtremeDT;
            latestConfirmBI[i] = storedConfirmBI;
            latestConfirmDT[i] = storedConfirmDT;
            latestAge[i] = i-storedExtremeOffset;
            latestSince[i] = i-storedConfirmOffset;
        }
    }

    VarSet(pfx+"EventValid",eventValid);
    VarSet(pfx+"EventCode",eventCode);
    VarSet(pfx+"EventValue",eventValue);
    VarSet(pfx+"ExtremeBarIndex",extremeBI);
    VarSet(pfx+"ExtremeDateTime",extremeDT);
    VarSet(pfx+"ConfirmBarIndex",confirmBI);
    VarSet(pfx+"ConfirmDateTime",confirmDT);
    VarSet(pfx+"ConfirmationLag",lag);

    VarSet(pfx+"LatestValid",latestValid);
    VarSet(pfx+"LatestValue",latestValue);
    VarSet(pfx+"LatestExtremeBarIndex",latestExtremeBI);
    VarSet(pfx+"LatestExtremeDateTime",latestExtremeDT);
    VarSet(pfx+"LatestConfirmBarIndex",latestConfirmBI);
    VarSet(pfx+"LatestConfirmDateTime",latestConfirmDT);
    VarSet(pfx+"LatestAge",latestAge);
    VarSet(pfx+"LatestBarsSinceConfirmation",latestSince);

    VarSet(pfx+"LatestPriorValid",priorValid);
    VarSet(pfx+"LatestPriorValue",priorValue);
    VarSet(pfx+"LatestPriorExtremeBarIndex",priorExtremeBI);
    VarSet(pfx+"LatestPriorExtremeDateTime",priorExtremeDT);
    VarSet(pfx+"LatestPriorConfirmBarIndex",priorConfirmBI);
    VarSet(pfx+"LatestPriorConfirmDateTime",priorConfirmDT);
    VarSet(pfx+"LatestPriorAge",priorAge);
    VarSet(pfx+"LatestPriorBarsSinceConfirmation",priorSince);
    return 1;
}

/* Convenience entry point for one arbitrary derived numeric series.
   Both High-kind and Low-kind pivots are calculated from that same series. */
function WDP_RunDerivedSeries( channel, series, seriesValid, requestedLeft, requestedRight, srcBI, srcDT, srcOffset )
{
    local pfx, cfgValid, leftBars, rightBars, win;
    pfx = "WDP_"+channel+"_";
    WDP_PrepareWindow(channel,seriesValid,requestedLeft,requestedRight,srcBI,srcDT,srcOffset);
    cfgValid = VarGet(pfx+"PivotConfigValid");
    leftBars = IIf(cfgValid,requestedLeft,1);
    rightBars = IIf(cfgValid,requestedRight,1);
    win = VarGet(pfx+"PivotWindowValid");
    WDP_CalcPivotKind(channel,"High",1,series,win,leftBars,rightBars,srcBI,srcDT);
    WDP_CalcPivotKind(channel,"Low",0,series,win,leftBars,rightBars,srcBI,srcDT);
    return 1;
}
_SECTION_END();
