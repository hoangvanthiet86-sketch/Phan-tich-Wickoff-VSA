/*
    Wyckoff VSA Derived-Series Pivot Kernel v0.1

    Approved specification: PR #33, K01-K32.
    Approval merge commit: dcd028447314d49066d0904168ffcf95ed078121

    Purpose: apply the exact Structure/Location v1.0 confirmed-pivot semantics
    to an arbitrary valid numeric series without creating new Wyckoff meaning.

    SPEC-ALIGNED / UNTESTED DEVELOPMENT.
    No Zig/Peak/Trough, no future access, no trading logic.
*/

_SECTION_BEGIN("101. Derived-Series Pivot Kernel helpers");
function WDP_Finite( x )
{
    return IIf(IsNull(x),0,IIf(IsFinite(x),1,0));
}

function WDP_ValidInteger( x, low, high )
{
    return IIf(WDP_Finite(x),IIf(x>=low AND x<=high AND x==Floor(x),1,0),0);
}

/*
    Prepare the exact A+B+1 causal confirmation window used by
    Structure/Location v1.0. Results are written under:

      WDP_<channel>_...

    `seriesValid` must represent explicit point-in-time validity of the
    derived numeric series. Missing values are never filled.
*/
function WDP_PrepareWindow( channel, seriesValid, requestedA, requestedB, srcBI, srcDT, srcOffset )
{
    local p, cfg, A, B, len, prefixCount, validCount, full, status, valid;
    p = "WDP_"+channel+"_";

    cfg = WDP_ValidInteger(requestedA,1,20) AND WDP_ValidInteger(requestedB,1,20);
    A = IIf(cfg,requestedA,1);
    B = IIf(cfg,requestedB,1);
    len = A+B+1;

    prefixCount = Cum(seriesValid);
    validCount = IIf(cfg,
        IIf(srcOffset<len,prefixCount,
            prefixCount-Nz(Ref(prefixCount,-len),0)),Null);

    full = cfg AND srcOffset>=A+B;
    status = IIf(NOT cfg,3,
        IIf(NOT full,0,IIf(validCount==len,2,1)));
    valid = IIf(status==2,1,0);

    VarSet(p+"PivotLeft",IIf(cfg,requestedA,Null));
    VarSet(p+"PivotRight",IIf(cfg,requestedB,Null));
    VarSet(p+"PivotA",IIf(cfg,A,Null));
    VarSet(p+"PivotB",IIf(cfg,B,Null));
    VarSet(p+"PivotLength",IIf(cfg,len,Null));
    VarSet(p+"PivotConfigValid",IIf(cfg,1,0));
    VarSet(p+"PivotWindowValidCount",validCount);
    VarSet(p+"PivotWindowStatusCode",status);
    VarSet(p+"PivotWindowValid",valid);
    VarSet(p+"PivotWindowStartBarIndex",IIf(full,Ref(srcBI,-(A+B)),Null));
    VarSet(p+"PivotWindowEndBarIndex",IIf(full,srcBI,Null));
    VarSet(p+"PivotWindowStartDateTime",IIf(full,Ref(srcDT,-(A+B)),Null));
    VarSet(p+"PivotWindowEndDateTime",IIf(full,srcDT,Null));
    VarSet(p+"PivotCandidateBarIndex",IIf(full,Ref(srcBI,-B),Null));
    VarSet(p+"PivotCandidateDateTime",IIf(full,Ref(srcDT,-B),Null));
    return 1;
}

/*
    Exact behavioral translation of Structure/Location v1.0 SL_CalcPivotKind.

    highKind=1:
      candidate > every left value
      candidate >= every right value including confirmation bar

    highKind=0:
      candidate < every left value
      candidate <= every right value including confirmation bar

    Candidate is always i-B and publication is always at i.
*/
function WDP_CalcPivotKind( channel, kind, highKind, series, windowValid, A, B, srcBI, srcDT )
{
    local p, eventValid, eventCode, eventValue, extremeBI, extremeDT, confirmBI, confirmDT, lag;
    local latestValid, latestValue, latestExtremeBI, latestExtremeDT, latestConfirmBI, latestConfirmDT, latestAge, latestSince;
    local priorValid, priorValue, priorExtremeBI, priorExtremeDT, priorConfirmBI, priorConfirmDT, priorAge, priorSince;
    local storedValid, storedValue, storedExtremeBI, storedExtremeDT, storedConfirmBI, storedConfirmDT;
    local storedExtremeOffset, storedConfirmOffset, i, j, k, ok, value, code;

    p = "WDP_"+channel+"_Pivot"+kind;

    eventValid = 0; eventCode = 0; eventValue = Null;
    extremeBI = Null; extremeDT = Null; confirmBI = Null; confirmDT = Null; lag = Null;

    latestValid = 0; latestValue = Null; latestExtremeBI = Null; latestExtremeDT = Null;
    latestConfirmBI = Null; latestConfirmDT = Null; latestAge = Null; latestSince = Null;

    priorValid = 0; priorValue = Null; priorExtremeBI = Null; priorExtremeDT = Null;
    priorConfirmBI = Null; priorConfirmDT = Null; priorAge = Null; priorSince = Null;

    storedValid = 0; storedValue = Null; storedExtremeBI = Null; storedExtremeDT = Null;
    storedConfirmBI = Null; storedConfirmDT = Null; storedExtremeOffset = Null; storedConfirmOffset = Null;

    for(i=0;i<BarCount;i++)
    {
        // LatestPrior snapshot is captured before evaluating bar i.
        priorValid[i] = storedValid;
        if(storedValid)
        {
            priorValue[i] = storedValue;
            priorExtremeBI[i] = storedExtremeBI;
            priorExtremeDT[i] = storedExtremeDT;
            priorConfirmBI[i] = storedConfirmBI;
            priorConfirmDT[i] = storedConfirmDT;
            priorAge[i] = i-storedExtremeOffset;
            priorSince[i] = i-storedConfirmOffset;
        }

        code = 0;
        eventValid[i] = windowValid[i];

        if(windowValid[i])
        {
            code = 1;
            k = i-B;
            value = series[k];
            ok = 1;

            for(j=k-A;j<k;j++)
            {
                if(highKind)
                {
                    if(NOT (value>series[j])) ok=0;
                }
                else
                {
                    if(NOT (value<series[j])) ok=0;
                }
            }

            for(j=k+1;j<=i;j++)
            {
                if(highKind)
                {
                    if(NOT (value>=series[j])) ok=0;
                }
                else
                {
                    if(NOT (value<=series[j])) ok=0;
                }
            }

            if(ok)
            {
                code = 2;
                eventValue[i] = value;
                extremeBI[i] = srcBI[k];
                extremeDT[i] = srcDT[k];
                confirmBI[i] = srcBI[i];
                confirmDT[i] = srcDT[i];
                lag[i] = B;

                storedValid = 1;
                storedValue = value;
                storedExtremeBI = srcBI[k];
                storedExtremeDT = srcDT[k];
                storedConfirmBI = srcBI[i];
                storedConfirmDT = srcDT[i];
                storedExtremeOffset = k;
                storedConfirmOffset = i;
            }
        }

        eventCode[i] = code;

        // Latest snapshot is captured after evaluating bar i.
        latestValid[i] = storedValid;
        if(storedValid)
        {
            latestValue[i] = storedValue;
            latestExtremeBI[i] = storedExtremeBI;
            latestExtremeDT[i] = storedExtremeDT;
            latestConfirmBI[i] = storedConfirmBI;
            latestConfirmDT[i] = storedConfirmDT;
            latestAge[i] = i-storedExtremeOffset;
            latestSince[i] = i-storedConfirmOffset;
        }
    }

    VarSet(p+"EventValid",eventValid);
    VarSet(p+"EventCode",eventCode);
    VarSet(p+"EventValue",eventValue);
    VarSet(p+"ExtremeBarIndex",extremeBI);
    VarSet(p+"ExtremeDateTime",extremeDT);
    VarSet(p+"ConfirmBarIndex",confirmBI);
    VarSet(p+"ConfirmDateTime",confirmDT);
    VarSet(p+"ConfirmationLag",lag);

    VarSet(p+"LatestValid",latestValid);
    VarSet(p+"LatestValue",latestValue);
    VarSet(p+"LatestExtremeBarIndex",latestExtremeBI);
    VarSet(p+"LatestExtremeDateTime",latestExtremeDT);
    VarSet(p+"LatestConfirmBarIndex",latestConfirmBI);
    VarSet(p+"LatestConfirmDateTime",latestConfirmDT);
    VarSet(p+"LatestAge",latestAge);
    VarSet(p+"LatestBarsSinceConfirmation",latestSince);

    VarSet(p+"LatestPriorValid",priorValid);
    VarSet(p+"LatestPriorValue",priorValue);
    VarSet(p+"LatestPriorExtremeBarIndex",priorExtremeBI);
    VarSet(p+"LatestPriorExtremeDateTime",priorExtremeDT);
    VarSet(p+"LatestPriorConfirmBarIndex",priorConfirmBI);
    VarSet(p+"LatestPriorConfirmDateTime",priorConfirmDT);
    VarSet(p+"LatestPriorAge",priorAge);
    VarSet(p+"LatestPriorBarsSinceConfirmation",priorSince);
    return 1;
}

/* Convenience entry point for one arbitrary derived numeric series.
   Both High-kind and Low-kind pivots are calculated from that same series. */
function WDP_RunDerivedSeries( channel, series, seriesValid, requestedA, requestedB, srcBI, srcDT, srcOffset )
{
    local p, cfg, A, B, win;
    p = "WDP_"+channel+"_";
    WDP_PrepareWindow(channel,seriesValid,requestedA,requestedB,srcBI,srcDT,srcOffset);
    cfg = VarGet(p+"PivotConfigValid");
    A = IIf(cfg,requestedA,1);
    B = IIf(cfg,requestedB,1);
    win = VarGet(p+"PivotWindowValid");
    WDP_CalcPivotKind(channel,"High",1,series,win,A,B,srcBI,srcDT);
    WDP_CalcPivotKind(channel,"Low",0,series,win,A,B,srcBI,srcDT);
    return 1;
}
_SECTION_END();
