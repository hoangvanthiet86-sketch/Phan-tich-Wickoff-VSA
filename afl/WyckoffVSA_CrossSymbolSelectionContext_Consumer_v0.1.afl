        WXSG_L_EvidenceBalanceCode = StaticVarGet(WXSG_Prefix+"L_EvidenceBalanceCode");
        WXSG_L_MixedEvidenceReasonCode = StaticVarGet(WXSG_Prefix+"L_MixedEvidenceReasonCode");
        WXSG_L_PrimaryRangeLow = StaticVarGet(WXSG_Prefix+"L_PrimaryRangeLow");
        WXSG_L_PrimaryRangeHigh = StaticVarGet(WXSG_Prefix+"L_PrimaryRangeHigh");
        WXSG_L_RangeAgeBars = StaticVarGet(WXSG_Prefix+"L_RangeAgeBars");
        WXSG_U_ContextPresent = StaticVarGet(WXSG_Prefix+"U_ContextPresent");
        WXSG_U_RangeContextID = StaticVarGet(WXSG_Prefix+"U_RangeContextID");
        WXSG_U_RangeStatusCode = StaticVarGet(WXSG_Prefix+"U_RangeStatusCode");
        WXSG_U_PhaseStateCode = StaticVarGet(WXSG_Prefix+"U_PhaseStateCode");
        WXSG_U_FamilyHypothesisCode = StaticVarGet(WXSG_Prefix+"U_FamilyHypothesisCode");
        WXSG_U_EvidenceBalanceCode = StaticVarGet(WXSG_Prefix+"U_EvidenceBalanceCode");
        WXSG_U_MixedEvidenceReasonCode = StaticVarGet(WXSG_Prefix+"U_MixedEvidenceReasonCode");
        WXSG_U_PrimaryRangeLow = StaticVarGet(WXSG_Prefix+"U_PrimaryRangeLow");
        WXSG_U_PrimaryRangeHigh = StaticVarGet(WXSG_Prefix+"U_PrimaryRangeHigh");
        WXSG_U_RangeAgeBars = StaticVarGet(WXSG_Prefix+"U_RangeAgeBars");
        WXSG_MTF_SnapshotContractValid = StaticVarGet(WXSG_Prefix+"MTF_SnapshotContractValid");
        WXSG_MTF_DailyValid = StaticVarGet(WXSG_Prefix+"MTF_DailyValid");
        WXSG_MTF_WeeklyValid = StaticVarGet(WXSG_Prefix+"MTF_WeeklyValid");
        WXSG_MTF_MonthlyValid = StaticVarGet(WXSG_Prefix+"MTF_MonthlyValid");
        WXSG_MTF_D_DirectionalContextCode = StaticVarGet(WXSG_Prefix+"MTF_D_DirectionalContextCode");
        WXSG_MTF_W_DirectionalContextCode = StaticVarGet(WXSG_Prefix+"MTF_W_DirectionalContextCode");
        WXSG_MTF_M_DirectionalContextCode = StaticVarGet(WXSG_Prefix+"MTF_M_DirectionalContextCode");
        WXSG_MTF_D_PhaseStateCode = StaticVarGet(WXSG_Prefix+"MTF_D_PhaseStateCode");
        WXSG_MTF_W_PhaseStateCode = StaticVarGet(WXSG_Prefix+"MTF_W_PhaseStateCode");
        WXSG_MTF_M_PhaseStateCode = StaticVarGet(WXSG_Prefix+"MTF_M_PhaseStateCode");
        WXSG_MTF_D_FamilyHypothesisCode = StaticVarGet(WXSG_Prefix+"MTF_D_FamilyHypothesisCode");
        WXSG_MTF_W_FamilyHypothesisCode = StaticVarGet(WXSG_Prefix+"MTF_W_FamilyHypothesisCode");
        WXSG_MTF_M_FamilyHypothesisCode = StaticVarGet(WXSG_Prefix+"MTF_M_FamilyHypothesisCode");
        WXSG_MTF_D_EvidenceBalanceCode = StaticVarGet(WXSG_Prefix+"MTF_D_EvidenceBalanceCode");
        WXSG_MTF_W_EvidenceBalanceCode = StaticVarGet(WXSG_Prefix+"MTF_W_EvidenceBalanceCode");
        WXSG_MTF_M_EvidenceBalanceCode = StaticVarGet(WXSG_Prefix+"MTF_M_EvidenceBalanceCode");
        WXSG_MTF_DirectionalAlignmentCode = StaticVarGet(WXSG_Prefix+"MTF_DirectionalAlignmentCode");
        WXSG_MTF_EvidenceAlignmentCode = StaticVarGet(WXSG_Prefix+"MTF_EvidenceAlignmentCode");
        WXSG_MTF_PhaseRelationshipCode = StaticVarGet(WXSG_Prefix+"MTF_PhaseRelationshipCode");
        WXSG_MTF_ConflictReasonCode = StaticVarGet(WXSG_Prefix+"MTF_ConflictReasonCode");
        WXSG_MTF_WeeklySnapshotStatusCode = StaticVarGet(WXSG_Prefix+"MTF_WeeklySnapshotStatusCode");
        WXSG_MTF_MonthlySnapshotStatusCode = StaticVarGet(WXSG_Prefix+"MTF_MonthlySnapshotStatusCode");
        WXSG_MTF_D_SourceBarDateTime = StaticVarGet(WXSG_Prefix+"MTF_D_SourceBarDateTime");
        WXSG_MTF_W_SourcePeriodOrdinal = StaticVarGet(WXSG_Prefix+"MTF_W_SourcePeriodOrdinal");
        WXSG_MTF_M_SourcePeriodOrdinal = StaticVarGet(WXSG_Prefix+"MTF_M_SourcePeriodOrdinal");
        WXSG_MTF_W_SourceBarDateTime = StaticVarGet(WXSG_Prefix+"MTF_W_SourceBarDateTime");
        WXSG_MTF_M_SourceBarDateTime = StaticVarGet(WXSG_Prefix+"MTF_M_SourceBarDateTime");
        WXSG_MTF_W_GenerationID = StaticVarGet(WXSG_Prefix+"MTF_W_GenerationID");
        WXSG_MTF_M_GenerationID = StaticVarGet(WXSG_Prefix+"MTF_M_GenerationID");
        WXSG_MTF_W_SchemaMajor = StaticVarGet(WXSG_Prefix+"MTF_W_SchemaMajor");
        WXSG_MTF_W_SchemaMinor = StaticVarGet(WXSG_Prefix+"MTF_W_SchemaMinor");
        WXSG_MTF_M_SchemaMajor = StaticVarGet(WXSG_Prefix+"MTF_M_SchemaMajor");
        WXSG_MTF_M_SchemaMinor = StaticVarGet(WXSG_Prefix+"MTF_M_SchemaMinor");
        WXSG_GenerationB = StaticVarGet(WXSG_Prefix+"CommittedGenerationID");
        WXSG_ReadyB = StaticVarGet(WXSG_Prefix+"Ready");
        WXSG_GenerationID = WXSG_GenerationB;

        WXSG_CompletionValid =
            WXSG_CompletionBasisCode==1 OR
            (WXSG_CompletionBasisCode==2 AND WXSG_CompletionDeclarationCode==1) OR
            (WXSG_CompletionBasisCode==3 AND WXSG_ClockBasisCode==2 AND WCLK_IsReplay);
        WXSG_ClockBasisValid = WXSG_ClockBasisCode==WCLK_ClockBasisCode;
        WXSG_CompositeCoreValid = WXSG_CompositePayloadValid==1 AND
            NOT IsNull(WXSG_ContextMultiplicityCode) AND NOT IsNull(WXSG_DirectionalContextCode) AND
            NOT IsNull(WXSG_PhaseStateCode) AND NOT IsNull(WXSG_EvidenceBalanceCode) AND
            NOT IsNull(WXSG_HypothesisAlignmentCode) AND NOT IsNull(WXSG_ProvisionalFlag);
        WXSG_MTFCoreValid = WXSG_MTFPayloadValid==1 AND WXSG_MTF_SnapshotContractValid==1 AND
            WXSG_MTF_DailyValid==1 AND WXSG_MTF_WeeklyValid==1 AND WXSG_MTF_MonthlyValid==1 AND
            NOT IsNull(WXSG_MTF_DirectionalAlignmentCode) AND
            NOT IsNull(WXSG_MTF_EvidenceAlignmentCode) AND NOT IsNull(WXSG_MTF_PhaseRelationshipCode);

        if (WXSG_ReadyB!=1 OR WXSG_GenerationB!=WXSG_GenerationA OR WXSG_GenerationB<=0)
            WXSG_StatusCode = 4;
        else
        if (WXSG_SchemaMajor!=WXS_ExpectedSchemaMajor OR WXSG_SchemaMinor!=WXS_ExpectedSchemaMinor)
            WXSG_StatusCode = 5;
        else
        if (WXSG_SnapshotSourceSymbol!=WXS_RequestedGroupSymbol)
            WXSG_StatusCode = 6;
        else
        if (WXSG_SourceInterval!=inDaily)
            WXSG_StatusCode = 7;
        else
        if (IsNull(WXSG_SourceBusinessDateKey) OR WXSG_SourceBusinessDateKey<=0 OR IsNull(WXSG_SourceBarDateTime))
            WXSG_StatusCode = 14;
        else
        if (WXSG_SourceBusinessDateKey < WXS_ConsumerBusinessDateKey)
            WXSG_StatusCode = 8;
        else
        if (WXSG_SourceBusinessDateKey > WXS_ConsumerBusinessDateKey)
            WXSG_StatusCode = 9;
        else
        if (WXSG_ProvisionalFlag!=0)
            WXSG_StatusCode = 10;
        else
        if (NOT WXSG_CompletionValid OR NOT WXSG_ClockBasisValid)
            WXSG_StatusCode = 11;
        else
        if (NOT WXSG_CompositeCoreValid)
            WXSG_StatusCode = 12;
        else
        if (NOT WXSG_MTFCoreValid)
            WXSG_StatusCode = 13;
        else
            WXSG_StatusCode = 1;
    }
}
WXSG_Valid = WXSG_StatusCode==1;

WXS_MarketReadExecuted = 1;
WXS_GroupReadExecuted = 1;
WXS_MarketStatusCodeScalar = WXSM_StatusCode;
WXS_GroupStatusCodeScalar = WXSG_StatusCode;
WXS_MarketValidScalar = WXSM_Valid;
WXS_GroupValidScalar = WXSG_Valid;

_SECTION_END();
