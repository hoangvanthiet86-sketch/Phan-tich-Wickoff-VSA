WXSG_U_ContextPresent = Null;
WXSG_U_RangeContextID = Null;
WXSG_U_RangeStatusCode = Null;
WXSG_U_PhaseStateCode = Null;
WXSG_U_FamilyHypothesisCode = Null;
WXSG_U_EvidenceBalanceCode = Null;
WXSG_U_MixedEvidenceReasonCode = Null;
WXSG_U_PrimaryRangeLow = Null;
WXSG_U_PrimaryRangeHigh = Null;
WXSG_U_RangeAgeBars = Null;
WXSG_MTF_SnapshotContractValid = Null;
WXSG_MTF_DailyValid = Null;
WXSG_MTF_WeeklyValid = Null;
WXSG_MTF_MonthlyValid = Null;
WXSG_MTF_D_DirectionalContextCode = Null;
WXSG_MTF_W_DirectionalContextCode = Null;
WXSG_MTF_M_DirectionalContextCode = Null;
WXSG_MTF_D_PhaseStateCode = Null;
WXSG_MTF_W_PhaseStateCode = Null;
WXSG_MTF_M_PhaseStateCode = Null;
