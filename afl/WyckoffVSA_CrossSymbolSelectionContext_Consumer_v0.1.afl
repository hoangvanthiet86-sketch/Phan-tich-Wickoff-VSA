/*
    Wyckoff VSA Cross-Symbol Selection Context Consumer v0.1
    AmiBroker 6.20 top-level compatibility implementation.

    Contract preserved:
    - reads persistent Market / Group selection-context snapshots;
    - exact symbol / interval / date / completion / schema / payload validation;
    - same status codes and public WXSM_ / WXSG_ variables;
    - no ranking, no Buy/Sell/Short/Cover, no change to Wyckoff/VSA analysis.

    AmiBroker 6.20 compatibility correction:
    - removes the large string-heavy user-defined reader function that caused
      Exploration to emit no rows in native testing;
    - reads Market and Group roles directly at top level;
    - uses the accepted WCLK native DateNum business-date key.
*/
#include_once <WyckoffVSA_OperationalClock_v0.1.afl>

_SECTION_BEGIN("112. Cross-Symbol Selection Context Consumer");

WXS_ExpectedSchemaMajor = 1;
WXS_ExpectedSchemaMinor = 0;
WXS_ConsumerBusinessDateKey = WCLK_AsOfBusinessDateKey;

WXS_RequestedMarketSymbol = ParamStr("Selection: Market benchmark symbol","");
WXS_RequestedGroupSymbol = ParamStr("Selection: Group benchmark symbol","");
WXS_MarketRequested = StrLen(WXS_RequestedMarketSymbol)>0;
WXS_GroupRequested = StrLen(WXS_RequestedGroupSymbol)>0;
WXS_RoleConfigConflict =
    WXS_MarketRequested AND
    WXS_GroupRequested AND
    WXS_RequestedMarketSymbol==WXS_RequestedGroupSymbol;

WXS_ConsumerStatusText =
    "NOT READ / INSUFFICIENT\nVALID\nNOT REQUESTED\nMISSING\n"
    + "WRITER BUSY / WRITE IN PROGRESS / UNSTABLE GENERATION\n"
    + "SCHEMA VERSION MISMATCH\nSYMBOL MISMATCH\nINTERVAL MISMATCH\n"
    + "STALE BUSINESS DATE\nFUTURE BUSINESS DATE\nPROVISIONAL SOURCE\n"
    + "INVALID COMPLETION PROVENANCE\nINVALID COMPOSITE PAYLOAD\n"
    + "INVALID MTF PAYLOAD\nINVALID SOURCE DATETIME";

WXSM_RequestedSymbol = WXS_RequestedMarketSymbol;
WXSM_SnapshotSourceSymbol = "";
WXSM_GenerationID = Null;
WXSM_SchemaMajor = Null;
WXSM_SchemaMinor = Null;
WXSM_SourceInterval = Null;
WXSM_SourceBusinessDateKey = Null;
WXSM_SourceBarDateTime = Null;
WXSM_PublishedAtDateTime = Null;
WXSM_CompletionBasisCode = Null;
WXSM_CompletionDeclarationCode = Null;
WXSM_ClockBasisCode = Null;
WXSM_CompositePayloadValid = Null;
WXSM_MTFPayloadValid = Null;
WXSM_ContextMultiplicityCode = Null;
WXSM_ContextAmbiguous = Null;
WXSM_CurrentRangeContextID = Null;
WXSM_RangeStatusCode = Null;
WXSM_PhaseStateCode = Null;
WXSM_StructuralDevelopmentCode = Null;
WXSM_FamilyHypothesisCode = Null;
WXSM_DirectionalContextCode = Null;
WXSM_EvidenceBalanceCode = Null;
WXSM_HypothesisAlignmentCode = Null;
WXSM_HypothesisRevisionCode = Null;
WXSM_CurrentEventMask = Null;
WXSM_ProvisionalFlag = Null;
WXSM_PrimaryRangeLow = Null;
WXSM_PrimaryRangeHigh = Null;
WXSM_RangeAgeBars = Null;
WXSM_L_ContextPresent = Null;
WXSM_L_RangeContextID = Null;
WXSM_L_RangeStatusCode = Null;
WXSM_L_PhaseStateCode = Null;
WXSM_L_FamilyHypothesisCode = Null;
WXSM_L_EvidenceBalanceCode = Null;
WXSM_L_MixedEvidenceReasonCode = Null;
WXSM_L_PrimaryRangeLow = Null;
WXSM_L_PrimaryRangeHigh = Null;
WXSM_L_RangeAgeBars = Null;
WXSM_U_ContextPresent = Null;
WXSM_U_RangeContextID = Null;
WXSM_U_RangeStatusCode = Null;
WXSM_U_PhaseStateCode = Null;
WXSM_U_FamilyHypothesisCode = Null;
WXSM_U_EvidenceBalanceCode = Null;
WXSM_U_MixedEvidenceReasonCode = Null;
WXSM_U_PrimaryRangeLow = Null;
WXSM_U_PrimaryRangeHigh = Null;
WXSM_U_RangeAgeBars = Null;
WXSM_MTF_SnapshotContractValid = Null;
WXSM_MTF_DailyValid = Null;
WXSM_MTF_WeeklyValid = Null;
WXSM_MTF_MonthlyValid = Null;
WXSM_MTF_D_DirectionalContextCode = Null;
WXSM_MTF_W_DirectionalContextCode = Null;
WXSM_MTF_M_DirectionalContextCode = Null;
WXSM_MTF_D_PhaseStateCode = Null;
WXSM_MTF_W_PhaseStateCode = Null;
WXSM_MTF_M_PhaseStateCode = Null;
WXSM_MTF_D_FamilyHypothesisCode = Null;
WXSM_MTF_W_FamilyHypothesisCode = Null;
WXSM_MTF_M_FamilyHypothesisCode = Null;
WXSM_MTF_D_EvidenceBalanceCode = Null;
WXSM_MTF_W_EvidenceBalanceCode = Null;
WXSM_MTF_M_EvidenceBalanceCode = Null;
WXSM_MTF_DirectionalAlignmentCode = Null;
WXSM_MTF_EvidenceAlignmentCode = Null;
WXSM_MTF_PhaseRelationshipCode = Null;
WXSM_MTF_ConflictReasonCode = Null;
WXSM_MTF_WeeklySnapshotStatusCode = Null;
WXSM_MTF_MonthlySnapshotStatusCode = Null;
WXSM_MTF_D_SourceBarDateTime = Null;
WXSM_MTF_W_SourcePeriodOrdinal = Null;
WXSM_MTF_M_SourcePeriodOrdinal = Null;
WXSM_MTF_W_SourceBarDateTime = Null;
WXSM_MTF_M_SourceBarDateTime = Null;
WXSM_MTF_W_GenerationID = Null;
WXSM_MTF_M_GenerationID = Null;
WXSM_MTF_W_SchemaMajor = Null;
WXSM_MTF_W_SchemaMinor = Null;
WXSM_MTF_M_SchemaMajor = Null;
WXSM_MTF_M_SchemaMinor = Null;
WXSM_StatusCode = 0;
WXSM_Valid = 0;
WXSM_ReadyA = Null;
WXSM_ReadyB = Null;
WXSM_GenerationA = Null;
WXSM_GenerationB = Null;
WXSM_CompletionValid = 0;
WXSM_ClockBasisValid = 0;
WXSM_CompositeCoreValid = 0;
WXSM_MTFCoreValid = 0;

if (NOT WXS_MarketRequested)
{
    WXSM_StatusCode = 2;
}
else
{
    WXSM_Prefix = "WVSA_SELCTX_v01_" + WXS_RequestedMarketSymbol + "_";
    WXSM_ReadyA = StaticVarGet(WXSM_Prefix+"Ready");
    WXSM_GenerationA = StaticVarGet(WXSM_Prefix+"CommittedGenerationID");

    if (IsNull(WXSM_ReadyA) OR IsNull(WXSM_GenerationA))
    {
        WXSM_StatusCode = 3;
    }
    else
    if (WXSM_ReadyA!=1 OR WXSM_GenerationA<=0)
    {
        WXSM_StatusCode = 4;
    }
    else
    {
        WXSM_SchemaMajor = StaticVarGet(WXSM_Prefix+"SchemaMajor");
        WXSM_SchemaMinor = StaticVarGet(WXSM_Prefix+"SchemaMinor");
        WXSM_SnapshotSourceSymbol = StaticVarGetText(WXSM_Prefix+"SourceSymbol");
        WXSM_SourceInterval = StaticVarGet(WXSM_Prefix+"SourceInterval");
        WXSM_SourceBusinessDateKey = StaticVarGet(WXSM_Prefix+"SourceBusinessDateKey");
        WXSM_SourceBarDateTime = StaticVarGet(WXSM_Prefix+"SourceBarDateTime");
        WXSM_PublishedAtDateTime = StaticVarGet(WXSM_Prefix+"PublishedAtDateTime");
        WXSM_CompletionBasisCode = StaticVarGet(WXSM_Prefix+"CompletionBasisCode");
        WXSM_CompletionDeclarationCode = StaticVarGet(WXSM_Prefix+"CompletionDeclarationCode");
        WXSM_ClockBasisCode = StaticVarGet(WXSM_Prefix+"ClockBasisCode");
        WXSM_CompositePayloadValid = StaticVarGet(WXSM_Prefix+"CompositePayloadValid");
        WXSM_MTFPayloadValid = StaticVarGet(WXSM_Prefix+"MTFPayloadValid");
        WXSM_ContextMultiplicityCode = StaticVarGet(WXSM_Prefix+"ContextMultiplicityCode");
        WXSM_ContextAmbiguous = StaticVarGet(WXSM_Prefix+"ContextAmbiguous");
        WXSM_CurrentRangeContextID = StaticVarGet(WXSM_Prefix+"CurrentRangeContextID");
        WXSM_RangeStatusCode = StaticVarGet(WXSM_Prefix+"RangeStatusCode");
        WXSM_PhaseStateCode = StaticVarGet(WXSM_Prefix+"PhaseStateCode");
        WXSM_StructuralDevelopmentCode = StaticVarGet(WXSM_Prefix+"StructuralDevelopmentCode");
        WXSM_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"FamilyHypothesisCode");
        WXSM_DirectionalContextCode = StaticVarGet(WXSM_Prefix+"DirectionalContextCode");
        WXSM_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"EvidenceBalanceCode");
        WXSM_HypothesisAlignmentCode = StaticVarGet(WXSM_Prefix+"HypothesisAlignmentCode");
        WXSM_HypothesisRevisionCode = StaticVarGet(WXSM_Prefix+"HypothesisRevisionCode");
        WXSM_CurrentEventMask = StaticVarGet(WXSM_Prefix+"CurrentEventMask");
        WXSM_ProvisionalFlag = StaticVarGet(WXSM_Prefix+"ProvisionalFlag");
        WXSM_PrimaryRangeLow = StaticVarGet(WXSM_Prefix+"PrimaryRangeLow");
        WXSM_PrimaryRangeHigh = StaticVarGet(WXSM_Prefix+"PrimaryRangeHigh");
        WXSM_RangeAgeBars = StaticVarGet(WXSM_Prefix+"RangeAgeBars");
        WXSM_L_ContextPresent = StaticVarGet(WXSM_Prefix+"L_ContextPresent");
        WXSM_L_RangeContextID = StaticVarGet(WXSM_Prefix+"L_RangeContextID");
        WXSM_L_RangeStatusCode = StaticVarGet(WXSM_Prefix+"L_RangeStatusCode");
        WXSM_L_PhaseStateCode = StaticVarGet(WXSM_Prefix+"L_PhaseStateCode");
        WXSM_L_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"L_FamilyHypothesisCode");
        WXSM_L_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"L_EvidenceBalanceCode");
        WXSM_L_MixedEvidenceReasonCode = StaticVarGet(WXSM_Prefix+"L_MixedEvidenceReasonCode");
        WXSM_L_PrimaryRangeLow = StaticVarGet(WXSM_Prefix+"L_PrimaryRangeLow");
        WXSM_L_PrimaryRangeHigh = StaticVarGet(WXSM_Prefix+"L_PrimaryRangeHigh");
        WXSM_L_RangeAgeBars = StaticVarGet(WXSM_Prefix+"L_RangeAgeBars");
        WXSM_U_ContextPresent = StaticVarGet(WXSM_Prefix+"U_ContextPresent");
        WXSM_U_RangeContextID = StaticVarGet(WXSM_Prefix+"U_RangeContextID");
        WXSM_U_RangeStatusCode = StaticVarGet(WXSM_Prefix+"U_RangeStatusCode");
        WXSM_U_PhaseStateCode = StaticVarGet(WXSM_Prefix+"U_PhaseStateCode");
        WXSM_U_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"U_FamilyHypothesisCode");
        WXSM_U_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"U_EvidenceBalanceCode");
        WXSM_U_MixedEvidenceReasonCode = StaticVarGet(WXSM_Prefix+"U_MixedEvidenceReasonCode");
        WXSM_U_PrimaryRangeLow = StaticVarGet(WXSM_Prefix+"U_PrimaryRangeLow");
        WXSM_U_PrimaryRangeHigh = StaticVarGet(WXSM_Prefix+"U_PrimaryRangeHigh");
        WXSM_U_RangeAgeBars = StaticVarGet(WXSM_Prefix+"U_RangeAgeBars");
        WXSM_MTF_SnapshotContractValid = StaticVarGet(WXSM_Prefix+"MTF_SnapshotContractValid");
        WXSM_MTF_DailyValid = StaticVarGet(WXSM_Prefix+"MTF_DailyValid");
        WXSM_MTF_WeeklyValid = StaticVarGet(WXSM_Prefix+"MTF_WeeklyValid");
        WXSM_MTF_MonthlyValid = StaticVarGet(WXSM_Prefix+"MTF_MonthlyValid");
        WXSM_MTF_D_DirectionalContextCode = StaticVarGet(WXSM_Prefix+"MTF_D_DirectionalContextCode");
        WXSM_MTF_W_DirectionalContextCode = StaticVarGet(WXSM_Prefix+"MTF_W_DirectionalContextCode");
        WXSM_MTF_M_DirectionalContextCode = StaticVarGet(WXSM_Prefix+"MTF_M_DirectionalContextCode");
        WXSM_MTF_D_PhaseStateCode = StaticVarGet(WXSM_Prefix+"MTF_D_PhaseStateCode");
        WXSM_MTF_W_PhaseStateCode = StaticVarGet(WXSM_Prefix+"MTF_W_PhaseStateCode");
        WXSM_MTF_M_PhaseStateCode = StaticVarGet(WXSM_Prefix+"MTF_M_PhaseStateCode");
        WXSM_MTF_D_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"MTF_D_FamilyHypothesisCode");
        WXSM_MTF_W_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"MTF_W_FamilyHypothesisCode");
        WXSM_MTF_M_FamilyHypothesisCode = StaticVarGet(WXSM_Prefix+"MTF_M_FamilyHypothesisCode");
        WXSM_MTF_D_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"MTF_D_EvidenceBalanceCode");
        WXSM_MTF_W_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"MTF_W_EvidenceBalanceCode");
        WXSM_MTF_M_EvidenceBalanceCode = StaticVarGet(WXSM_Prefix+"MTF_M_EvidenceBalanceCode");
        WXSM_MTF_DirectionalAlignmentCode = StaticVarGet(WXSM_Prefix+"MTF_DirectionalAlignmentCode");
        WXSM_MTF_EvidenceAlignmentCode = StaticVarGet(WXSM_Prefix+"MTF_EvidenceAlignmentCode");
        WXSM_MTF_PhaseRelationshipCode = StaticVarGet(WXSM_Prefix+"MTF_PhaseRelationshipCode");
        WXSM_MTF_ConflictReasonCode = StaticVarGet(WXSM_Prefix+"MTF_ConflictReasonCode");
        WXSM_MTF_WeeklySnapshotStatusCode = StaticVarGet(WXSM_Prefix+"MTF_WeeklySnapshotStatusCode");
        WXSM_MTF_MonthlySnapshotStatusCode = StaticVarGet(WXSM_Prefix+"MTF_MonthlySnapshotStatusCode");
        WXSM_MTF_D_SourceBarDateTime = StaticVarGet(WXSM_Prefix+"MTF_D_SourceBarDateTime");
        WXSM_MTF_W_SourcePeriodOrdinal = StaticVarGet(WXSM_Prefix+"MTF_W_SourcePeriodOrdinal");
        WXSM_MTF_M_SourcePeriodOrdinal = StaticVarGet(WXSM_Prefix+"MTF_M_SourcePeriodOrdinal");
        WXSM_MTF_W_SourceBarDateTime = StaticVarGet(WXSM_Prefix+"MTF_W_SourceBarDateTime");
        WXSM_MTF_M_SourceBarDateTime = StaticVarGet(WXSM_Prefix+"MTF_M_SourceBarDateTime");
        WXSM_MTF_W_GenerationID = StaticVarGet(WXSM_Prefix+"MTF_W_GenerationID");
        WXSM_MTF_M_GenerationID = StaticVarGet(WXSM_Prefix+"MTF_M_GenerationID");
        WXSM_MTF_W_SchemaMajor = StaticVarGet(WXSM_Prefix+"MTF_W_SchemaMajor");
        WXSM_MTF_W_SchemaMinor = StaticVarGet(WXSM_Prefix+"MTF_W_SchemaMinor");
        WXSM_MTF_M_SchemaMajor = StaticVarGet(WXSM_Prefix+"MTF_M_SchemaMajor");
        WXSM_MTF_M_SchemaMinor = StaticVarGet(WXSM_Prefix+"MTF_M_SchemaMinor");
        WXSM_GenerationB = StaticVarGet(WXSM_Prefix+"CommittedGenerationID");
        WXSM_ReadyB = StaticVarGet(WXSM_Prefix+"Ready");
        WXSM_GenerationID = WXSM_GenerationB;

        WXSM_CompletionValid =
            WXSM_CompletionBasisCode==1 OR
            (WXSM_CompletionBasisCode==2 AND WXSM_CompletionDeclarationCode==1) OR
            (WXSM_CompletionBasisCode==3 AND WXSM_ClockBasisCode==2 AND WCLK_IsReplay);
        WXSM_ClockBasisValid = WXSM_ClockBasisCode==WCLK_ClockBasisCode;
        WXSM_CompositeCoreValid = WXSM_CompositePayloadValid==1 AND
            NOT IsNull(WXSM_ContextMultiplicityCode) AND NOT IsNull(WXSM_DirectionalContextCode) AND
            NOT IsNull(WXSM_PhaseStateCode) AND NOT IsNull(WXSM_EvidenceBalanceCode) AND
            NOT IsNull(WXSM_HypothesisAlignmentCode) AND NOT IsNull(WXSM_ProvisionalFlag);
        WXSM_MTFCoreValid = WXSM_MTFPayloadValid==1 AND WXSM_MTF_SnapshotContractValid==1 AND
            WXSM_MTF_DailyValid==1 AND WXSM_MTF_WeeklyValid==1 AND WXSM_MTF_MonthlyValid==1 AND
            NOT IsNull(WXSM_MTF_DirectionalAlignmentCode) AND
            NOT IsNull(WXSM_MTF_EvidenceAlignmentCode) AND NOT IsNull(WXSM_MTF_PhaseRelationshipCode);

        if (WXSM_ReadyB!=1 OR WXSM_GenerationB!=WXSM_GenerationA OR WXSM_GenerationB<=0)
            WXSM_StatusCode = 4;
        else
        if (WXSM_SchemaMajor!=WXS_ExpectedSchemaMajor OR WXSM_SchemaMinor!=WXS_ExpectedSchemaMinor)
            WXSM_StatusCode = 5;
        else
        if (WXSM_SnapshotSourceSymbol!=WXS_RequestedMarketSymbol)
            WXSM_StatusCode = 6;
        else
        if (WXSM_SourceInterval!=inDaily)
            WXSM_StatusCode = 7;
        else
        if (IsNull(WXSM_SourceBusinessDateKey) OR WXSM_SourceBusinessDateKey<=0 OR IsNull(WXSM_SourceBarDateTime))
            WXSM_StatusCode = 14;
        else
        if (WXSM_SourceBusinessDateKey < WXS_ConsumerBusinessDateKey)
            WXSM_StatusCode = 8;
        else
        if (WXSM_SourceBusinessDateKey > WXS_ConsumerBusinessDateKey)
            WXSM_StatusCode = 9;
        else
        if (WXSM_ProvisionalFlag!=0)
            WXSM_StatusCode = 10;
        else
        if (NOT WXSM_CompletionValid OR NOT WXSM_ClockBasisValid)
            WXSM_StatusCode = 11;
        else
        if (NOT WXSM_CompositeCoreValid)
            WXSM_StatusCode = 12;
        else
        if (NOT WXSM_MTFCoreValid)
            WXSM_StatusCode = 13;
        else
            WXSM_StatusCode = 1;
    }
}
WXSM_Valid = WXSM_StatusCode==1;

WXSG_RequestedSymbol = WXS_RequestedGroupSymbol;
WXSG_SnapshotSourceSymbol = "";
WXSG_GenerationID = Null;
WXSG_SchemaMajor = Null;
WXSG_SchemaMinor = Null;
WXSG_SourceInterval = Null;
WXSG_SourceBusinessDateKey = Null;
WXSG_SourceBarDateTime = Null;
WXSG_PublishedAtDateTime = Null;
WXSG_CompletionBasisCode = Null;
WXSG_CompletionDeclarationCode = Null;
WXSG_ClockBasisCode = Null;
