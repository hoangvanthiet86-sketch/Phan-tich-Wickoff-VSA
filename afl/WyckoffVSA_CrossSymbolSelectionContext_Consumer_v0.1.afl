        WXSG_SourceBarDateTime = StaticVarGet(WXSG_Prefix+"SourceBarDateTime");
        WXSG_PublishedAtDateTime = StaticVarGet(WXSG_Prefix+"PublishedAtDateTime");
        WXSG_CompletionBasisCode = StaticVarGet(WXSG_Prefix+"CompletionBasisCode");
