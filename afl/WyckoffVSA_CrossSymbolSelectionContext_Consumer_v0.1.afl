WXSG_MTF_W_FamilyHypothesisCode = Null;
WXSG_MTF_M_FamilyHypothesisCode = Null;
WXSG_MTF_D_EvidenceBalanceCode = Null;
WXSG_MTF_W_EvidenceBalanceCode = Null;
WXSG_MTF_M_EvidenceBalanceCode = Null;
WXSG_MTF_DirectionalAlignmentCode = Null;
WXSG_MTF_EvidenceAlignmentCode = Null;
WXSG_MTF_PhaseRelationshipCode = Null;
WXSG_MTF_ConflictReasonCode = Null;
WXSG_MTF_WeeklySnapshotStatusCode = Null;
WXSG_MTF_MonthlySnapshotStatusCode = Null;
WXSG_MTF_D_SourceBarDateTime = Null;
WXSG_MTF_W_SourcePeriodOrdinal = Null;
WXSG_MTF_M_SourcePeriodOrdinal = Null;
WXSG_MTF_W_SourceBarDateTime = Null;
WXSG_MTF_M_SourceBarDateTime = Null;
WXSG_MTF_W_GenerationID = Null;
WXSG_MTF_M_GenerationID = Null;
WXSG_MTF_W_SchemaMajor = Null;
WXSG_MTF_W_SchemaMinor = Null;
WXSG_MTF_M_SchemaMajor = Null;
WXSG_MTF_M_SchemaMinor = Null;
WXSG_StatusCode = 0;
WXSG_Valid = 0;
WXSG_ReadyA = Null;
WXSG_ReadyB = Null;
WXSG_GenerationA = Null;
WXSG_GenerationB = Null;
WXSG_CompletionValid = 0;
WXSG_ClockBasisValid = 0;
WXSG_CompositeCoreValid = 0;
WXSG_MTFCoreValid = 0;

if (NOT WXS_GroupRequested)
{
    WXSG_StatusCode = 2;
}
else
{
    WXSG_Prefix = "WVSA_SELCTX_v01_" + WXS_RequestedGroupSymbol + "_";
    WXSG_ReadyA = StaticVarGet(WXSG_Prefix+"Ready");
    WXSG_GenerationA = StaticVarGet(WXSG_Prefix+"CommittedGenerationID");

    if (IsNull(WXSG_ReadyA) OR IsNull(WXSG_GenerationA))
    {
        WXSG_StatusCode = 3;
    }
    else
    if (WXSG_ReadyA!=1 OR WXSG_GenerationA<=0)
    {
        WXSG_StatusCode = 4;
    }
    else
    {
        WXSG_SchemaMajor = StaticVarGet(WXSG_Prefix+"SchemaMajor");
        WXSG_SchemaMinor = StaticVarGet(WXSG_Prefix+"SchemaMinor");
        WXSG_SnapshotSourceSymbol = StaticVarGetText(WXSG_Prefix+"SourceSymbol");
        WXSG_SourceInterval = StaticVarGet(WXSG_Prefix+"SourceInterval");
